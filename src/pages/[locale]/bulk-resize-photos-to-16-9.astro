---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import BatchToolsApp from '../../components/marketing/BatchToolsApp.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import HighlightText from '../../components/ui/HighlightText.astro';
import SeoToolProse from '../../components/marketing/SeoToolProse.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';
import { l, getCanonicalUrl } from '../../i18n/utils';
import { useTranslations } from '../../i18n';
import { BULK_RESIZE_DATA } from '../../i18n/data/toolsData';
import { buildSoftwareApplicationSchema, buildFAQSchema } from '../../lib/seo/schemaGenerator';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const data = BULK_RESIZE_DATA[locale];

const breadcrumbs = [
  { name: t('nav.about') ? (locale === 'es' ? 'Inicio' : locale === 'de' ? 'Startseite' : locale === 'fr' ? 'Accueil' : locale === 'ja' ? 'ホーム' : 'Início') : 'Home', url: l('/', locale) },
  { name: locale === 'es' ? 'Herramientas por lotes' : locale === 'de' ? 'Stapelverarbeitung' : locale === 'fr' ? 'Outils par lots' : locale === 'ja' ? '一括処理ツール' : 'Ferramentas em lote', url: l('/batch-photo-tools', locale) },
  { name: data.breadcrumbName },
];

const canonical = getCanonicalUrl('/bulk-resize-photos-to-16-9', locale);

const schemas = [
  buildSoftwareApplicationSchema(
    data.heading,
    data.description,
    canonical
  ),
  buildFAQSchema(data.faqs),
];
---

<MarketingLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  locale={locale}
  schema={schemas}
>
  <div class="bg-marketing-panel border-b border-marketing-border py-12 sm:py-16 transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
          <HighlightText variant="lime">{data.heading}</HighlightText>
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          {data.lead}
        </p>
      </div>
    </div>
  </div>

  <section class="py-10 sm:py-14 lg:py-16 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <BatchToolsApp />
    </div>
  </section>

  <SeoToolProse currentUrl="/bulk-resize-photos-to-16-9" locale={locale}>
    <h2 class="mt-0">{data.prose.h2}</h2>
    <p>{data.prose.p1}</p>
    <p>{data.prose.p2}</p>

    <h3>{data.prose.h3_1}</h3>
    <p>{data.prose.p3}</p>
    <ul>
      {data.prose.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>

    <h3>{data.prose.h3_2}</h3>
    <p>{data.prose.p4}</p>
  </SeoToolProse>

  <section class="py-14 sm:py-20 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h3 class="text-xl sm:text-2xl font-bold text-marketing-text mb-6">
          {locale === 'es' ? 'Preguntas frecuentes' : locale === 'de' ? 'Häufig gestellte Fragen' : locale === 'fr' ? 'Questions fréquentes' : locale === 'ja' ? 'よくある質問' : 'Perguntas frequentes'}
        </h3>
        <FaqAccordion faqs={data.faqs} />
      </div>
    </div>
  </section>
</MarketingLayout>
