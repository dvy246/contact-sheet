---
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import MoodBoardTemplatePreview from '../../components/marketing/MoodBoardTemplatePreview.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import HighlightText from '../../components/ui/HighlightText.astro';
import Icon from '../../components/common/Icon.astro';
import { MOODBOARD_TEMPLATES } from '../../lib/moodboardStore';
import { TEMPLATES_AND_COMPANY_DATA } from '../../i18n/data/templatesAndCompanyData';
import { l, getCanonicalUrl } from '../../i18n/utils';
import { buildFAQSchema } from '../../lib/seo/schemaGenerator';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const data = TEMPLATES_AND_COMPANY_DATA[locale].moodBoardTemplates;
const globalData = TEMPLATES_AND_COMPANY_DATA[locale];

const breadcrumbs = [
  { name: 'Home', url: l('/', locale) },
  { name: data.breadcrumbsMoodBoard, url: l('/mood-board-maker', locale) },
  { name: data.breadcrumbsTitle },
];

const schemas = [
  buildFAQSchema(data.faqs),
];

const editorialCategories = [
  { id: 'all', label: data.categories.all, count: MOODBOARD_TEMPLATES.length },
  { id: 'editorial', label: data.categories.editorial, count: MOODBOARD_TEMPLATES.filter(t => t.category === 'editorial').length },
  { id: 'lookbook', label: data.categories.lookbook, count: MOODBOARD_TEMPLATES.filter(t => t.category === 'lookbook').length },
  { id: 'concept', label: data.categories.concept, count: MOODBOARD_TEMPLATES.filter(t => t.category === 'concept').length },
  { id: 'film', label: data.categories.film, count: MOODBOARD_TEMPLATES.filter(t => t.category === 'film').length },
  { id: 'minimal', label: data.categories.minimal, count: MOODBOARD_TEMPLATES.filter(t => t.category === 'minimal').length },
];
---

<MarketingLayout
  title={data.title}
  description={data.description}
  canonical={getCanonicalUrl('/mood-board-templates', locale)}
  robots="index, follow"
  schema={schemas}
  locale={locale}
>
  <!-- Page Header -->
  <div class="bg-marketing-panel border-b border-marketing-border py-12 sm:py-16 transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
          {data.heroTitlePrefix}<HighlightText variant="pink">{data.heroHighlight}</HighlightText>{data.heroTitleSuffix}
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          {data.heroLead}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={l('/mood-board-maker#moodboard-workbench', locale)}
            class="inline-flex items-center gap-2 h-11 px-6 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-sm tracking-tight shadow-lg shadow-accent/25 active:scale-[0.98] transition-all"
          >
            <Icon name="layout" size={16} />
            <span>{data.openCanvasBtn}</span>
            <Icon name="arrow-right" size={15} />
          </a>
          <a
            href={l('/guides/how-to-make-a-mood-board', locale)}
            class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-marketing-surface hover:bg-marketing-surface/80 text-marketing-text border border-marketing-border font-semibold text-sm tracking-tight transition-all"
          >
            <Icon name="help" size={16} />
            <span>{data.readGuideBtn}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Templates Catalog Grid -->
  <section class="py-12 sm:py-16 lg:py-20 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <!-- Category Filter Bar -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 sm:mb-10 no-scrollbar" id="mb-template-filter-bar">
        {editorialCategories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat.id}
            class={`filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer flex-shrink-0 ${
              idx === 0
                ? 'active bg-accent text-white border-accent shadow-xs'
                : 'bg-marketing-surface text-marketing-text border-marketing-border hover:border-accent/40'
            }`}
          >
            {cat.label} ({cat.count})
          </button>
        ))}
      </div>

      <!-- Templates Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {MOODBOARD_TEMPLATES.map((template) => {
          const imageCount = template.elements.filter(e => e.type === 'image').length;
          const swatchCount = template.elements.filter(e => e.type === 'swatch').length;
          const canvasWidth = template.canvas.width || 1920;
          const canvasHeight = template.canvas.height || 1080;
          const ratioDisplay = canvasWidth === 1920 && canvasHeight === 1080 ? data.widescreenLabel : `${canvasWidth}×${canvasHeight}`;
          const catLabel = data.categories[template.category as keyof typeof data.categories] || template.category || 'Preset';

          return (
            <div 
              data-template-card
              data-category={template.category || 'all'}
              class="bg-marketing-panel border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 shadow-xs hover:border-accent/40 hover:shadow-md transition-all group"
            >
              <div class="space-y-4">
                <!-- Visual Grid Structure Preview -->
                <MoodBoardTemplatePreview template={template} />

                <div class="space-y-2.5">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                      {catLabel}
                    </span>
                    <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                      {imageCount} {data.photosLabel} · {swatchCount} {data.swatchesLabel}
                    </span>
                  </div>
                  <h2 class="text-base sm:text-lg font-bold text-marketing-text group-hover:text-accent transition-colors">
                    {template.name}
                  </h2>
                  <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
                    {template.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-marketing-border space-y-1.5 text-xs text-marketing-muted font-mono">
                  <div class="flex justify-between">
                    <span>{data.aspectRatioLabel}</span>
                    <span class="font-bold text-marketing-text">{ratioDisplay}</span>
                  </div>
                  <div class="flex justify-between">
                    <span>{data.elementsLabel}</span>
                    <span class="font-bold text-marketing-text">{template.elements.length} {data.totalObjectsLabel}</span>
                  </div>
                </div>
              </div>

              <a 
                href={l(`/mood-board-maker?template=${template.id}#moodboard-workbench`, locale)}
                class="w-full py-2.5 px-4 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-xs text-center tracking-tight shadow-sm hover:shadow transition-all block"
              >
                {data.useTemplateBtn}
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Editorial & Guide Content -->
  <section class="py-16 sm:py-24 lg:py-28 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[850px] mx-auto px-4 sm:px-6 space-y-14">
      
      <!-- Choosing the Right Mood Board -->
      <div class="space-y-4 prose-measure">
        <h2 class="text-2xl font-bold text-marketing-text">
          {data.editorialTitle} <HighlightText variant="yellow">{data.editorialHighlight}</HighlightText>
        </h2>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          {data.editorialLead}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          {data.editorialCards.map((card) => (
            <div class="p-4 rounded-xl bg-marketing-surface border border-marketing-border space-y-2">
              <span class="text-xs font-mono font-bold text-accent-ink uppercase">{card.title}</span>
              <p class="text-xs text-marketing-muted leading-relaxed">{card.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ & Interlinking -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
        <div class="space-y-5">
          <h3 class="text-lg font-bold text-marketing-text border-b border-marketing-border pb-3">{data.relatedToolsTitle}</h3>
          <ul class="space-y-4">
            <li>
              <a href={l('/photo-contact-sheet-maker', locale)} class="group flex items-start gap-3 p-3 -m-3 rounded-xl hover:bg-marketing-surface transition-colors">
                <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover:border-accent/40 text-marketing-text group-hover:text-accent shadow-xs transition-colors">
                  <Icon name="camera" size={16} />
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-marketing-text text-sm group-hover:text-accent transition-colors">{globalData.contactSheetTemplates.breadcrumbsTitle}</span>
                  <span class="text-xs text-marketing-muted leading-snug mt-0.5">{globalData.contactSheetTemplates.description}</span>
                </div>
              </a>
            </li>
            <li>
              <a href={l('/photo-collage-maker', locale)} class="group flex items-start gap-3 p-3 -m-3 rounded-xl hover:bg-marketing-surface transition-colors">
                <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover:border-accent/40 text-marketing-text group-hover:text-accent shadow-xs transition-colors">
                  <Icon name="layout" size={16} />
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-marketing-text text-sm group-hover:text-accent transition-colors">{globalData.collageTemplates.breadcrumbsTitle}</span>
                  <span class="text-xs text-marketing-muted leading-snug mt-0.5">{globalData.collageTemplates.description}</span>
                </div>
              </a>
            </li>
            <li>
              <a href={l('/batch-photo-tools', locale)} class="group flex items-start gap-3 p-3 -m-3 rounded-xl hover:bg-marketing-surface transition-colors">
                <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover:border-accent/40 text-marketing-text group-hover:text-accent shadow-xs transition-colors">
                  <Icon name="file-text" size={16} />
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-marketing-text text-sm group-hover:text-accent transition-colors">Batch Photo Tools</span>
                  <span class="text-xs text-marketing-muted leading-snug mt-0.5">Token renamer, EXIF metadata inspector & converter</span>
                </div>
              </a>
            </li>
            <li>
              <a href={l('/free-8x10-photo-prints', locale)} class="group flex items-start gap-3 p-3 -m-3 rounded-xl hover:bg-marketing-surface transition-colors">
                <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover:border-accent/40 text-marketing-text group-hover:text-accent shadow-xs transition-colors">
                  <Icon name="printer" size={16} />
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-marketing-text text-sm group-hover:text-accent transition-colors">8×10 Print Saver</span>
                  <span class="text-xs text-marketing-muted leading-snug mt-0.5">Multi-photo layouts optimized for store prints</span>
                </div>
              </a>
            </li>
          </ul>
        </div>
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-marketing-text">{data.faqTitle}</h2>
          <FaqAccordion faqs={data.faqs} />
        </div>
      </div>

    </div>
  </section>

  <script>
    const filterBar = document.getElementById('mb-template-filter-bar');
    if (filterBar) {
      const filterBtns = filterBar.querySelectorAll<HTMLButtonElement>('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('[data-template-card]');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('bg-accent', 'text-white', 'border-accent', 'shadow-xs');
            b.classList.add('bg-marketing-surface', 'text-marketing-text', 'border-marketing-border');
          });
          btn.classList.remove('bg-marketing-surface', 'text-marketing-text', 'border-marketing-border');
          btn.classList.add('bg-accent', 'text-white', 'border-accent', 'shadow-xs');

          const category = btn.getAttribute('data-filter');
          cards.forEach((card) => {
            if (category === 'all' || card.getAttribute('data-category') === category) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }
  </script>
</MarketingLayout>
