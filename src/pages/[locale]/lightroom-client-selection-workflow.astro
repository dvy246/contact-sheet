---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import WorkspaceApp from '../../components/workspace/WorkspaceApp.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';
import { l, getCanonicalUrl } from '../../i18n/utils';
import { LIGHTROOM_WORKFLOW_DATA } from '../../i18n/data/guidesData';
import { buildSoftwareApplicationSchema, buildHowToSchema, buildFAQSchema } from '../../lib/seo/schemaGenerator';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const data = LIGHTROOM_WORKFLOW_DATA[locale];
const route = '/lightroom-client-selection-workflow';
const canonicalUrl = getCanonicalUrl(route, locale);

const breadcrumbs = [
  { name: data.breadcrumbs.home, url: l('/', locale) },
  { name: data.breadcrumbs.current },
];

const schemas = [
  buildSoftwareApplicationSchema(
    'Make Contact Sheet',
    data.description,
    canonicalUrl
  ),
  buildHowToSchema(
    data.h1,
    data.lead,
    data.steps
  ),
  buildFAQSchema(data.faqs),
];
---

<MarketingLayout
  title={data.title}
  description={data.description}
  canonical={canonicalUrl}
  robots="index, follow"
  ogType="article"
  schema={schemas}
  locale={locale}
>
  <div class="pt-24 pb-16 bg-white dark:bg-[#09090b]">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-8" />
      
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-stone-900 dark:text-white mb-6">
          {data.h1}
        </h1>
        <p class="text-lg text-stone-600 dark:text-stone-400">
          {data.lead}
        </p>
      </div>

      <div class="my-12">
        <WorkspaceApp initialMode="contact-sheet" contentBelow={true} locale={locale} />
      </div>

      <div class="max-w-3xl mx-auto space-y-12 my-20">
        <section>
          <h2 class="text-2xl font-bold text-stone-900 dark:text-white mb-6">{data.howItWorksHeading}</h2>
          <div class="space-y-8">
            {data.steps.map((step, idx) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center">
                  {idx + 1}
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-stone-900 dark:text-white mb-2">{step.name}</h3>
                  <p class="text-stone-600 dark:text-stone-400 leading-relaxed">{step.text}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="border-t border-stone-200 dark:border-stone-800 pt-12">
          <h2 class="text-2xl font-bold text-stone-900 dark:text-white mb-8">{data.faqHeading}</h2>
          <FaqAccordion faqs={data.faqs} />
        </section>
      </div>
    </div>
  </div>
</MarketingLayout>
