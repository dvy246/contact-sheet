---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import WorkspaceApp from '../../components/workspace/WorkspaceApp.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import SeoRelatedLinks from '../../components/common/SeoRelatedLinks.astro';
import Icon from '../../components/common/Icon.astro';
import HighlightText from '../../components/ui/HighlightText.astro';
import { NON_DEFAULT_LOCALES, type Locale } from '../../i18n/config';
import { l, getCanonicalUrl } from '../../i18n/utils';
import { useTranslations } from '../../i18n';
import { CONTACT_SHEET_DATA } from '../../i18n/data/toolsData';
import { buildSoftwareApplicationSchema, buildFAQSchema } from '../../lib/seo/schemaGenerator';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const data = CONTACT_SHEET_DATA[locale];

const breadcrumbs = [
  { name: t('nav.about') ? (locale === 'es' ? 'Inicio' : locale === 'de' ? 'Startseite' : locale === 'fr' ? 'Accueil' : locale === 'ja' ? 'ホーム' : 'Início') : 'Home', url: l('/', locale) },
  { name: data.breadcrumbName },
];

const canonical = getCanonicalUrl('/photo-contact-sheet-maker', locale);

const schemas = [
  buildSoftwareApplicationSchema(
    data.heading,
    data.description,
    canonical
  ),
  buildFAQSchema(data.faqs),
];
---

<MarketingLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  locale={locale}
  schema={schemas}
>
  <!-- Page Header -->
  <div class="bg-marketing-panel border-b border-marketing-border py-12 sm:py-16 transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
          <HighlightText variant="lime">{data.heading}</HighlightText>
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          {data.lead}
        </p>

        <a
          href={l('/studio/contact-sheet', locale)}
          class="mt-6 inline-flex items-center gap-2 h-11 px-6 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-sm tracking-tight shadow-lg shadow-accent/25 active:scale-[0.98] transition-all"
        >
          <Icon name="maximize" size={15} />
          <span>{data.ctaStudio}</span>
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </div>

  <!-- Framed Live Workspace -->
  <section class="py-12 sm:py-16 lg:py-20 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl overflow-hidden border border-workspace-border shadow-2xl bg-workspace-bg">
        <!-- Window Chrome Top Bar -->
        <div class="px-4 py-2.5 bg-workspace-panel border-b border-workspace-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          </div>
          <div class="text-[11px] font-mono text-workspace-muted font-medium">Make Contact Sheet Light-Table · Contact Sheet Mode</div>
          <div class="w-12"></div>
        </div>

        <WorkspaceApp />
      </div>
    </div>
  </div>

  <!-- Editorial & Guide Content -->
  <section class="py-16 sm:py-24 lg:py-28 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[850px] mx-auto px-4 sm:px-6 space-y-14">
      
      <div class="space-y-4 prose-measure">
        <h2 class="text-2xl font-bold text-marketing-text">
          {data.sec1Heading}
        </h2>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          {data.sec1P1}
        </p>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          {data.sec1P2}
        </p>
      </div>

      <div class="space-y-4 prose-measure">
        <h2 class="text-2xl font-bold text-marketing-text">
          {data.sec2Heading}
        </h2>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          {data.sec2P1}
        </p>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          {data.sec2P2}
        </p>
      </div>

      <!-- Quick Links to Related Guides -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <SeoRelatedLinks currentUrl="/photo-contact-sheet-maker" locale={locale} />
        <div class="p-6 sm:p-7 rounded-2xl bg-marketing-bg border border-marketing-border space-y-4 transition-colors self-start">
          <h3 class="text-base font-bold text-marketing-text">
            {locale === 'es' ? 'Recursos relacionados' : locale === 'de' ? 'Verwandte Ressourcen' : locale === 'fr' ? 'Ressources associées' : locale === 'ja' ? '関連リソース' : 'Recursos relacionados'}
          </h3>
          <ul class="flex flex-col gap-3.5 text-xs">
            <li>
              <a href={l('/guides/how-to-make-a-contact-sheet', locale)} class="font-medium text-marketing-text hover:text-accent-ink flex items-center gap-2 transition-colors">
                <Icon name="file-text" size={14} class="text-marketing-muted" />
                <span>{locale === 'es' ? 'Cómo hacer una hoja de contactos' : locale === 'de' ? 'Kontaktabzug erstellen: Anleitung' : locale === 'fr' ? 'Créer une planche contact pas à pas' : locale === 'ja' ? 'コンタクトシートの作り方完全ガイド' : 'Como fazer folha de contato'}</span>
              </a>
            </li>
            <li>
              <a href={l('/guides/photo-proof-sheet-with-filenames', locale)} class="font-medium text-marketing-text hover:text-accent-ink flex items-center gap-2 transition-colors">
                <Icon name="file-check" size={14} class="text-marketing-muted" />
                <span>{locale === 'es' ? 'Hojas de prueba con nombres de archivo' : locale === 'de' ? 'Prüfbögen mit Dateinamen' : locale === 'fr' ? 'Planches d\'épreuves avec noms de fichiers' : locale === 'ja' ? 'ファイル名付きプルーフシート作成' : 'Folhas de prova com nomes de arquivos'}</span>
              </a>
            </li>
            <li>
              <a href={l('/contact-sheet-template', locale)} class="font-medium text-marketing-text hover:text-accent-ink flex items-center gap-2 transition-colors">
                <Icon name="grid" size={14} class="text-marketing-muted" />
                <span>{locale === 'es' ? 'Plantillas de hojas de contactos' : locale === 'de' ? 'Kostenlose Kontaktabzug-Vorlagen' : locale === 'fr' ? 'Modèles de planches contact' : locale === 'ja' ? 'コンタクトシートテンプレート' : 'Modelos de folha de contato'}</span>
              </a>
            </li>
            <li>
              <a href={l('/compare/photoshop-contact-sheet-alternative', locale)} class="font-medium text-marketing-text hover:text-accent-ink flex items-center gap-2 transition-colors">
                <Icon name="columns" size={14} class="text-marketing-muted" />
                <span>{locale === 'es' ? 'Alternativa a Photoshop' : locale === 'de' ? 'Photoshop Alternative' : locale === 'fr' ? 'Alternative à Photoshop' : locale === 'ja' ? 'Photoshop代替ツール比較' : 'Alternativa ao Photoshop'}</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="space-y-6 pt-4">
        <h2 class="text-2xl font-bold text-marketing-text">
          {locale === 'es' ? 'Preguntas frecuentes' : locale === 'de' ? 'Häufig gestellte Fragen' : locale === 'fr' ? 'Questions fréquentes' : locale === 'ja' ? 'よくある質問' : 'Perguntas frequentes'}
        </h2>
        <FaqAccordion faqs={data.faqs} />
      </div>

    </div>
  </section>
</MarketingLayout>
