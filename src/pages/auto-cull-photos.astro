---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import WorkspaceApp from '../components/workspace/WorkspaceApp.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import HighlightText from '../components/ui/HighlightText.astro';
import SeoToolProse from '../components/marketing/SeoToolProse.astro';
import { METADATA_REGISTRY } from '../lib/seo/metadata';
import { buildSoftwareApplicationSchema } from '../lib/seo/schemaGenerator';

const meta = METADATA_REGISTRY['/auto-cull-photos'];

const faqs = [
  {
    question: 'What is Smart Cull and how does it work?',
    answer: 'Smart Cull measures the edge sharpness (Laplacian variance) of every imported photo right in your browser. It is a classic image-processing measure, not a machine-learning model: it scores each unreviewed photo 0–100 and flags or rejects the blurriest ones, leaving your manual Keep/Flag/Reject decisions untouched.',
  },
  {
    question: 'Are my photos uploaded to the cloud for analysis?',
    answer: 'No. Make Contact Sheet performs all image processing, including Smart Culling, entirely offline inside your web browser. No photos or metadata are ever uploaded to a server.',
  },
  {
    question: 'What happens to photos that are flagged as blurry?',
    answer: 'Photos that fall below the sharpness threshold are marked as "Flagged" or "Rejected" and given a Sharpness Score note. You can easily filter out these photos using the workspace toolbar, keeping only your sharpest shots.',
  },
  {
    question: 'What is the invisible watermark?',
    answer: 'It hides a random session ID in the least significant bit of the blue channel of exported images. It survives only in unedited PNG exports: JPEG export, recompression, resizing, cropping or a screenshot destroys it, so it cannot trace a proof that was reposted on social media.',
  }
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Auto-Cull Photos' },
];

const schemas = [
  buildSoftwareApplicationSchema(
    'Photo Auto-Culling Tool',
    meta.description,
    meta.canonical
  ),
];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
  schema={schemas}
>
  <div class="bg-marketing-panel border-b border-marketing-border py-12 sm:py-16 transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
          <HighlightText variant="cyan">Auto-Cull</HighlightText> Blurry Photos
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          Score every photo for sharpness and flag the blurry, out-of-focus frames automatically. Runs in your browser, with no uploads.
        </p>
      </div>
    </div>
  </div>

  <section class="border-b border-marketing-border transition-colors">
    <WorkspaceApp />
  </section>

  <SeoToolProse currentUrl="/auto-cull-photos">
    <h2 class="mt-0">How Smart Cull Scores Sharpness</h2>
    <p>
      Manually reviewing thousands of photos to find the sharpest shot is the most tedious part of a photographer's workflow. Our <strong>Smart Cull</strong> tool automates this process using a specialized <a href="https://en.wikipedia.org/wiki/Laplace_operator" target="_blank" rel="noopener noreferrer">Laplacian edge-detection algorithm</a>. 
    </p>
    <p>
      By calculating the luminance variance across every pixel, the engine assigns a precise <strong>0–100 Sharpness Score</strong> to every imported image. Blurry, out-of-focus, or motion-blurred shots receive low scores and are automatically flagged or rejected, allowing you to focus only on your best keepers.
    </p>

    <h3>Local Processing Instead of Cloud AI</h3>
    <p>
      Cloud-based AI culling services ask you to upload your shoot to their servers. <strong>Make Contact Sheet scores every photo directly in your web browser</strong> with the Canvas 2D API. It does less than a trained AI model (it judges focus, not expressions or closed eyes), but nothing leaves your computer.
    </p>
    <ul>
      <li><strong>Zero Server Uploads:</strong> Your pre-release commercial or wedding proofs never leave your computer, ensuring total compliance with client NDAs.</li>
      <li><strong>Instant Speed:</strong> Because there are no upload or download wait times, the culling engine processes thumbnails in milliseconds.</li>
      <li><strong>No Subscription:</strong> Free, with no account.</li>
    </ul>

    <h3>Invisible Watermark (PNG Only)</h3>
    <p>
      An optional <strong>invisible watermark</strong> writes a random session ID into the least significant bit of the blue channel of exported images. The "Verify Leaked Proof" inspector can read it back from an untouched PNG export.
    </p>
    <p>
      It is fragile by design: JPEG export, recompression, resizing, cropping or a screenshot erase it, and social platforms recompress every upload. Use the visible watermark when you need protection that survives sharing.
    </p>
  </SeoToolProse>

  <section class="py-14 sm:py-20 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h3 class="text-xl sm:text-2xl font-bold text-marketing-text mb-6">Frequently Asked Questions</h3>
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>
</MarketingLayout>
