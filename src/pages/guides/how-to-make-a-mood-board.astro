---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FaqAccordion from '../../components/common/FaqAccordion.astro';
import Icon from '../../components/common/Icon.astro';
import HighlightText from '../../components/ui/HighlightText.astro';
import { METADATA_REGISTRY } from '../../lib/seo/metadata';
import { buildHowToSchema } from '../../lib/seo/schemaGenerator';

const meta = METADATA_REGISTRY['/guides/how-to-make-a-mood-board'];

const steps = [
  {
    name: 'Define your creative concept and visual theme',
    text: 'Clarify the mood, emotional tone, and aesthetic direction before gathering imagery—whether you are creating an editorial fashion shoot, analog 35mm story, or clean minimalist lookbook.',
  },
  {
    name: 'Curate a focused set of reference photographs',
    text: 'Gather 4 to 8 high-impact images covering your hero framing, lighting atmosphere, pose studies, and texture macros. Drag them into the Make Contact Sheet canvas workbench.',
  },
  {
    name: 'Extract and arrange a cohesive color palette',
    text: 'Add designer color swatches sampled from your core imagery. Label each swatch with hex color codes and descriptive names to guide lighting gels, wardrobe, and post-production color grading.',
  },
  {
    name: 'Add actionable styling and lighting notes',
    text: 'Place sticky notes or text callouts specifying key technical directives: key-to-fill light ratios, hair and makeup requirements, prop lists, and camera lens selections.',
  },
  {
    name: 'Export high-resolution PDF or PNG handoffs',
    text: 'Download a crisp 300 DPI PDF presentation or lossless PNG. Share with models, stylists, clients, and assistants to align the whole production before shoot day.',
  },
];

const faqs = [
  {
    question: 'What is the purpose of a photography mood board?',
    answer: 'A visual concept sheet acts as the central aesthetic reference for a creative shoot. It aligns photographers, models, art directors, wardrobe stylists, and hair/makeup artists on lighting ratios, color palettes, poses, and atmosphere before shooting begins.',
  },
  {
    question: 'What should be included in a professional direction board?',
    answer: 'A comprehensive layout typically includes 1–2 hero anchor images, detail/texture photos, 3–5 labeled color swatches, lighting ratio notes, wardrobe/styling requirements, and technical camera or film stock notes.',
  },
  {
    question: 'How do I choose the right canvas aspect ratio?',
    answer: 'Use 16:9 widescreen for iPad and monitor presentations, 4:3 for desktop slide decks, A4/US Letter for physical print handouts on set, and 9:16 for mobile phone lookbooks.',
  },
  {
    question: 'Can I protect creative files before sharing with clients?',
    answer: 'Yes! Make Contact Sheet allows you to export password-protected PDFs locally in your browser so confidential creative direction remains secure.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Guides', url: '/guides/how-to-make-a-contact-sheet' },
  { name: 'How to Make a Mood Board' },
];

const schemas = [
  buildHowToSchema(
    'How to Make a Mood Board: Step-by-Step Photography Guide',
    meta.description,
    steps
  ),
];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
  ogType={meta.ogType}
  schema={schemas}
>
  <article class="py-12 sm:py-16 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[800px] mx-auto px-4 sm:px-6 space-y-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <header class="space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-[1.2]">
          How to Make a Mood Board: <HighlightText variant="pink">Step-by-Step Photography Guide</HighlightText>
        </h1>
        <p class="text-base text-marketing-muted leading-relaxed">
          Learn how to structure compelling visual direction boards with photographic references, curated color swatches, and technical shoot directives.
        </p>
      </header>

      <!-- Direct Answer / AEO Definition Block -->
      <div class="p-6 rounded-2xl bg-accent/10 border border-accent/30 text-marketing-text space-y-2">
        <div class="text-xs font-bold uppercase tracking-wider text-accent-ink font-mono">Direct Answer</div>
        <p class="text-sm leading-relaxed font-medium">
          To make a mood board for photography or visual direction, establish a core aesthetic concept, curate 4–8 reference photos (hero framing, lighting, textures), add a 3–5 swatch color palette with hex codes, annotate with actionable styling notes, and export a print-ready 300 DPI PDF or PNG directly in your browser.
        </p>
      </div>

      <!-- Step-by-Step Guide -->
      <div class="space-y-8 pt-4">
        <h2 class="text-2xl font-bold text-marketing-text">
          5 Steps to Build a Polished Visual Direction Sheet
        </h2>

        <div class="space-y-6">
          {steps.map((step, idx) => (
            <div class="flex gap-4 p-5 rounded-xl border border-marketing-border bg-marketing-bg transition-colors">
              <div class="w-8 h-8 rounded-lg bg-accent text-white flex-shrink-0 flex items-center justify-center font-bold text-sm">
                {idx + 1}
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-marketing-text">{step.name}</h3>
                <p class="text-sm text-marketing-muted leading-relaxed">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Composition & Direction Principles -->
      <div class="space-y-6 pt-6 border-t border-marketing-border text-sm text-marketing-text/90 leading-relaxed prose-measure">
        <h2 class="text-2xl font-bold text-marketing-text">
          Essential Anatomy of an Effective Visual Board
        </h2>
        
        <h3 class="text-lg font-bold text-marketing-text pt-2">
          1. The Anchor Hero Image
        </h3>
        <p>
          Every successful creative canvas requires a prominent visual anchor. This should be your largest, most evocative photograph that immediately communicates the overall atmosphere and lighting style. Surrounding images should then provide specific supporting context—such as makeup close-ups, fabric textures, or prop details.
        </p>

        <h3 class="text-lg font-bold text-marketing-text pt-3">
          2. Cohesive Color Swatches &amp; Hex Codes
        </h3>
        <p>
          Extracting a dedicated 3 to 5 tone palette prevents color clashing during the shoot. Including exact hex color values gives makeup artists and set designers concrete targets for lip shades, background seamless paper, and wardrobe fabrics.
        </p>

        <h3 class="text-lg font-bold text-marketing-text pt-3">
          3. Technical Lighting &amp; Directives Notes
        </h3>
        <p>
          Clear typographic notes prevent miscommunication on set. Use sticky note elements to document key technical parameters: softbox diffusion sizes, rim light intensity, camera focal lengths, and model pose inspirations.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="p-6 rounded-2xl bg-marketing-surface border border-marketing-border flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-base text-marketing-text">Ready to design your concept board?</h3>
          <p class="text-xs text-marketing-muted mt-0.5">Start with a curated template or build from scratch in our private browser studio.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href="/mood-board-templates"
            class="py-2.5 px-4 rounded-xl bg-marketing-bg border border-marketing-border hover:border-accent/50 text-xs font-semibold text-marketing-text text-center flex-1 sm:flex-initial transition-all flex items-center justify-center gap-1.5"
          >
            <Icon name="layout" size={14} />
            <span>Browse Templates</span>
          </a>
          <a
            href="/mood-board-maker#moodboard-workbench"
            class="py-2.5 px-4 rounded-xl bg-accent hover:bg-accent-hover text-white text-xs font-semibold text-center flex-1 sm:flex-initial transition-all flex items-center justify-center gap-1.5"
          >
            <span>Launch Studio</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <!-- FAQs -->
      <div class="space-y-6 pt-6 border-t border-marketing-border">
        <h2 class="text-2xl font-bold text-marketing-text">Frequently Asked Questions</h2>
        <FaqAccordion faqs={faqs} />
      </div>

    </div>
  </article>
</MarketingLayout>
