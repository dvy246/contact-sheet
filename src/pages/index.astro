---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HeroSection from '../components/marketing/HeroSection.astro';
import WorkflowSteps from '../components/marketing/WorkflowSteps.astro';
import FeatureGrid from '../components/marketing/FeatureGrid.astro';
import TemplateShowcase from '../components/marketing/TemplateShowcase.astro';
import ComparisonTable from '../components/marketing/ComparisonTable.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import WorkspaceApp from '../components/workspace/WorkspaceApp.astro';
import { METADATA_REGISTRY } from '../lib/seo/metadata';
import { buildWebSiteSchema, buildOrganizationSchema, buildSoftwareApplicationSchema, buildFAQSchema } from '../lib/seo/schemaGenerator';

const meta = METADATA_REGISTRY['/'];

const faqs = [
  {
    question: 'Are my photos uploaded to a cloud server?',
    answer: 'No. FrameProof processes 100% of your images locally in your web browser using HTML5 Canvas and Web Worker technologies. Your files, pixels, filenames, and EXIF metadata never leave your computer.',
  },
  {
    question: 'How do I export the list of selected filenames for Lightroom?',
    answer: 'After marking your photos with Keep (1), Flag (2), or Reject (3), open the Export drawer and choose "CSV Table" or "Lightroom TXT". You can download a structured CSV or a clean TXT list containing only your kept photos to paste directly into Lightroom or Capture One search filters.',
  },
  {
    question: 'What file formats are supported?',
    answer: 'FrameProof supports all standard browser-decodable image formats including JPG/JPEG, PNG, WebP, AVIF, GIF, and BMP.',
  },
  {
    question: 'Can I print or save high-resolution PDFs?',
    answer: 'Yes. FrameProof includes a print-ready PDF generator that builds standard A4 and US Letter multi-page proof sheets formatted with clean margins, headers, and filename labels at 300 DPI.',
  },
  {
    question: 'Is FrameProof free to use?',
    answer: 'Yes. FrameProof is completely free with no account creation or subscription required.',
  },
];

const schemas = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildSoftwareApplicationSchema(
    'FrameProof Photo Contact Sheet & Collage Maker',
    meta.description,
    'https://www.frameproof.com/'
  ),
  buildFAQSchema(faqs),
];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
  schema={schemas}
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Framed Live Workspace Section -->
  <section id="workspace" class="py-12 sm:py-16 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1360px] mx-auto px-4 sm:px-6">
      
      <!-- Section Framing Bar -->
      <div class="mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-muted mb-2 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-accent-amber"></span>
            <span>INTERACTIVE STUDIO WORKSPACE</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-marketing-text">
            Instant Photo Proofing & Layout Engine
          </h2>
        </div>
        <div class="flex items-center gap-2 text-xs text-marketing-muted font-mono">
          <span>Zero install</span>
          <span>·</span>
          <span>Runs 100% locally</span>
        </div>
      </div>

      <!-- Framed Workstation Island -->
      <div class="rounded-2xl overflow-hidden border border-workspace-border shadow-2xl bg-workspace-bg">
        <WorkspaceApp />
      </div>
    </div>
  </section>

  <!-- Workflow Steps -->
  <WorkflowSteps />

  <!-- Feature Grid -->
  <FeatureGrid />

  <!-- Template Showcase -->
  <TemplateShowcase />

  <!-- Comparison Table -->
  <ComparisonTable />

  <!-- FAQ Section -->
  <section class="py-16 sm:py-24 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[800px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-marketing-text">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-marketing-muted">
          Direct answers regarding privacy, file formats, and client selection workflows.
        </p>
      </div>

      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</MarketingLayout>
