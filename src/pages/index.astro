---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HeroSection from '../components/marketing/HeroSection.astro';
import WorkflowSteps from '../components/marketing/WorkflowSteps.astro';
import FeatureGrid from '../components/marketing/FeatureGrid.astro';
import StudioShowcase from '../components/marketing/StudioShowcase.astro';
import TemplateShowcase from '../components/marketing/TemplateShowcase.astro';
import ComparisonTable from '../components/marketing/ComparisonTable.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import WorkspaceApp from '../components/workspace/WorkspaceApp.astro';
import HighlightText from '../components/ui/HighlightText.astro';
import Icon from '../components/common/Icon.astro';
import { METADATA_REGISTRY } from '../lib/seo/metadata';

import { buildWebSiteSchema, buildOrganizationSchema, buildSoftwareApplicationSchema, buildFAQSchema } from '../lib/seo/schemaGenerator';

const meta = METADATA_REGISTRY['/'];

const faqs = [
  {
    question: 'What is a contact sheet?',
    answer: 'A contact sheet (or proof sheet) is a grid layout of thumbnail images used by photographers and visual artists to quickly preview, catalog, and select photographs from a shoot. Originating in traditional darkroom optical printing, digital contact sheets display sequential index badges, camera filenames, and technical metadata for fast editing handoffs.',
  },
  {
    question: 'How do I make a contact sheet online?',
    answer: 'To make a contact sheet online: drag and drop your image folder into the <a href="/photo-contact-sheet-maker" class="text-accent-ink underline font-medium">Make Contact Sheet studio</a>, configure your desired columns, rows, margins, and filename labels, and click Export to download a print-ready 300 DPI PDF or PNG file. All image processing occurs immediately in your browser.',
  },
  {
    question: 'Can I make a contact sheet without Photoshop or Lightroom?',
    answer: 'Yes. Make Contact Sheet runs directly in your web browser with no Adobe Creative Cloud subscription or software installation required. Unlike Adobe Photoshop\'s Contact Sheet II script, it provides real-time interactive grid customization, keyboard-driven review shortcuts (1/2/3), and instant client selection list exports.',
  },
  {
    question: 'Can I create a contact sheet without an account?',
    answer: 'Yes. Make Contact Sheet is completely free to use without account registration, login screens, or personal information collection. You can immediately access the full layout engine, <a href="/contact-sheet-template" class="text-accent-ink underline font-medium">preset templates</a>, and export tools.',
  },
  {
    question: 'Can I show original camera filenames on the contact sheet?',
    answer: 'Yes. Make Contact Sheet indexes and preserves complete, original camera filenames (such as <code>DSC_8941.NEF</code> or <code>_MG_1024.CR3</code>) and offers configurable caption styles, including sequential index numbers (#01, #02), plain filenames, and custom labels.',
  },
  {
    question: 'How many photos can I put on one contact sheet?',
    answer: 'You can arrange dozens to hundreds of photos across single or multi-page documents. The application automatically paginates your image batch across multiple A4 or US Letter sheets based on your chosen column and row layout, bounded only by your device\'s available browser memory.',
  },
  {
    question: 'What export formats are available for contact sheets?',
    answer: 'You can export high-resolution multi-page PDFs formatted for 300 DPI A4 or US Letter printing, standalone PNG and JPEG composite images, structured CSV selection manifests, and Adobe XMP sidecar archives for seamless Lightroom Classic synchronization.',
  },
  {
    question: 'Which image file formats are supported?',
    answer: 'Make Contact Sheet supports all standard browser-decodable image formats including JPEG, PNG, WebP, AVIF, GIF, and BMP. For major camera RAW formats (such as Canon CR2/CR3, Nikon NEF, Sony ARW, and Fujifilm RAF), the engine extracts embedded JPEG previews directly on your device.',
  },
  {
    question: 'How do client photo proofing and selection exports work?',
    answer: 'You can review and flag images using keyboard shortcuts (1 for Keep, 2 for Flag, 3 for Reject). When finished, open the Export drawer and choose "Lightroom TXT" or "CSV Table" to copy a filtered list of approved filenames directly into Lightroom Classic or Capture One search filters.',
  },
  {
    question: 'Are my photos uploaded to a cloud server?',
    answer: 'No. Make Contact Sheet is built on a local-first client-side architecture. All image decoding, thumbnail downscaling, and PDF rendering take place in your browser\'s local memory sandbox via HTML5 Canvas and Web Workers. Your image files and metadata are never uploaded to remote servers.',
  },
];

const schemas = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildSoftwareApplicationSchema(
    'Make Contact Sheet — Contact Sheet Maker',
    meta.description,
    'https://makecontactsheet.com/'
  ),
  buildFAQSchema(faqs),
];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
  schema={schemas}
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Apple Keynote Style Studio Showcase -->
  <StudioShowcase />

  <!-- Framed Live Workspace Section -->
  <section id="workspace" class="py-16 sm:py-24 lg:py-28 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Framing Bar -->
      <div class="mb-10 sm:mb-12 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>LIVE WORKSPACE INSTRUMENT</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            Instant Photo <HighlightText variant="lime">Proofing</HighlightText> &amp; <HighlightText variant="yellow">Layout Engine</HighlightText>
          </h2>
          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Drag image batches directly into the light table. Organize contact sheets, cull selects with instant keyboard shortcuts, and export print-ready PDFs without uploading files to the cloud.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs font-mono text-marketing-muted shrink-0">
          <span class="px-3 py-1.5 rounded-lg bg-marketing-surface border border-marketing-border text-marketing-text/80 shadow-xs">Zero Install</span>
          <span class="px-3 py-1.5 rounded-lg bg-marketing-surface border border-marketing-border text-marketing-text/80 shadow-xs">100% Local</span>
          <span class="px-3 py-1.5 rounded-lg bg-marketing-surface border border-marketing-border text-marketing-text/80 shadow-xs">Hardware Accelerated</span>
        </div>
      </div>

      <!-- Framed Workstation Island (Window Shell) -->
      <div class="rounded-2xl overflow-hidden border border-workspace-border shadow-2xl bg-workspace-bg">
        <!-- Window Chrome Top Bar -->
        <div class="px-4 py-2.5 bg-workspace-panel border-b border-workspace-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          </div>
          <div class="text-[11px] font-mono text-workspace-muted font-medium">Make Contact Sheet Light-Table · v1.0</div>
          <div class="w-12"></div>
        </div>

        <!-- Live Workspace Core -->
        <WorkspaceApp />
      </div>
    </div>
  </section>

  <!-- Workflow Steps -->
  <WorkflowSteps />

  <!-- Feature Grid -->
  <FeatureGrid />

  <!-- Template Showcase -->
  <TemplateShowcase />

  <!-- Dedicated Mood Board Maker Spotlight Section -->
  <section class="py-16 sm:py-24 lg:py-28 bg-marketing-panel border-b border-marketing-border relative overflow-hidden transition-colors">
    <!-- Subtle Ambient Glow -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute top-1/2 right-1/4 w-[600px] h-[350px] bg-accent/8 dark:bg-accent/12 rounded-full blur-[130px]"></div>
    </div>

    <div class="relative z-10 max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left Column: Copy & Value Proposition -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono font-medium tracking-wider text-accent-ink shadow-xs">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            <span>FREEFORM VISUAL DIRECTION</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-marketing-text leading-[1.12]">
            Curate Aesthetic <HighlightText variant="pink">Mood Boards</HighlightText> &amp; <HighlightText variant="cyan">Lookbooks</HighlightText>
          </h2>


          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Assemble visual narratives, lighting setups, and wardrobe palettes on an unconstrained freeform canvas. Freely drag, resize, rotate, and layer assets with real-time magnetic snapping guides and designer color cards.
          </p>

          <!-- Feature Pills Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs">
            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-marketing-surface border border-marketing-border text-marketing-text font-medium">
              <Icon name="crop" size={16} class="text-accent" />
              <span>Magnetic Snapping Guides</span>
            </div>
            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-marketing-surface border border-marketing-border text-marketing-text font-medium">
              <Icon name="columns" size={16} class="text-accent" />
              <span>Designer Color Swatches</span>
            </div>
            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-marketing-surface border border-marketing-border text-marketing-text font-medium">
              <Icon name="file-text" size={16} class="text-accent" />
              <span>Stylist Sticky Notes</span>
            </div>
            <div class="flex items-center gap-2.5 p-2.5 rounded-xl bg-marketing-surface border border-marketing-border text-marketing-text font-medium">
              <Icon name="download" size={16} class="text-accent" />
              <span>300 DPI Fine-Art Prints</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 pt-4">
            <a
              href="/mood-board-maker"
              class="inline-flex items-center gap-2 h-11 px-6 rounded-xl bg-accent hover:bg-accent-hover text-white text-xs sm:text-sm font-semibold tracking-tight shadow-md hover:shadow-lg active:scale-[0.98] transition-all cursor-pointer"
            >
              <Icon name="image" size={15} />
              <span>Launch Mood Board Studio</span>
            </a>
            <a
              href="/collage-templates"
              class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text text-xs sm:text-sm font-semibold border border-marketing-border transition-colors cursor-pointer"
            >
              <span>Explore Templates</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Tactile Freeform Board Preview Card -->
        <div class="lg:col-span-6">
          <div class="p-4 sm:p-6 rounded-3xl bg-[#14100e] border border-white/10 shadow-2xl relative overflow-hidden text-white space-y-4">
            
            <!-- Window Top Bar -->
            <div class="flex items-center justify-between pb-3 border-b border-white/10 text-[11px] font-mono text-stone-400">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                <span class="ml-2 font-medium text-stone-300">Mood Board Workspace</span>
              </div>
              <span class="text-accent font-bold">1920 × 1080 · 100% Local</span>
            </div>

            <!-- Canvas Composition Mockup -->
            <div class="relative w-full aspect-[16/10] bg-[#1a1412] rounded-2xl border border-white/10 overflow-hidden p-4 shadow-inner">
              <!-- Dots background -->
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 16px 16px;"></div>

              <!-- Main Hero Editorial Photo -->
              <div class="absolute top-4 left-4 w-[48%] h-[68%] rounded-xl bg-gradient-to-tr from-stone-900 via-stone-800 to-amber-950/60 border border-white/15 shadow-xl overflow-hidden flex flex-col justify-between p-3 rotate-[-1deg]">
                <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm self-start text-white/90">HERO LOOK</span>
                <div class="text-center py-4">
                  <Icon name="camera" size={24} class="mx-auto text-accent opacity-60" />
                </div>
                <span class="text-[10px] font-mono text-white/70">85mm f/1.4 · ISO 100</span>
              </div>

              <!-- Top Right Secondary Photo -->
              <div class="absolute top-4 right-4 w-[42%] h-[46%] rounded-xl bg-gradient-to-br from-amber-900/40 via-stone-900 to-stone-800 border border-white/15 shadow-xl overflow-hidden p-2.5 rotate-[1.5deg]">
                <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/60 backdrop-blur-sm text-white/90">DETAIL SHOT</span>
                <div class="text-center py-2">
                  <Icon name="image" size={18} class="mx-auto text-white/40" />
                </div>
              </div>

              <!-- Color Swatch 1: Amber Glow -->
              <div class="absolute bottom-4 left-4 w-24 h-24 rounded-xl bg-stone-900 border border-white/15 shadow-xl overflow-hidden flex flex-col rotate-[2deg]">
                <div class="flex-1 bg-[#d97706] relative">
                  <div class="absolute inset-0 bg-gradient-to-tr from-black/20 to-white/20"></div>
                </div>
                <div class="px-2 py-1 bg-black/90 text-[9px] font-mono flex items-center justify-between text-white/90">
                  <span class="font-bold">Amber</span>
                  <span class="text-white/60">#D97706</span>
                </div>
              </div>

              <!-- Color Swatch 2: Truffle Noir -->
              <div class="absolute bottom-4 left-32 w-24 h-24 rounded-xl bg-stone-900 border border-white/15 shadow-xl overflow-hidden flex flex-col rotate-[-1deg]">
                <div class="flex-1 bg-[#261b17] relative">
                  <div class="absolute inset-0 bg-gradient-to-tr from-black/20 to-white/20"></div>
                </div>
                <div class="px-2 py-1 bg-black/90 text-[9px] font-mono flex items-center justify-between text-white/90">
                  <span class="font-bold">Noir</span>
                  <span class="text-white/60">#261B17</span>
                </div>
              </div>

              <!-- Sticky Note -->
              <div class="absolute bottom-4 right-4 w-[42%] h-[42%] rounded-xl bg-[#fef3c7] text-stone-900 p-3 shadow-2xl rotate-[-2deg] border border-amber-300/60 flex flex-col justify-between">
                <div class="w-10 h-3 bg-white/60 mx-auto -mt-2 rounded-xs rotate-[-1deg]"></div>
                <div class="text-[10px] sm:text-[11px] font-medium leading-tight">
                  Director styling note:<br />
                  Soft 45° overhead key with warm bounce fill.
                </div>
                <span class="text-[9px] font-mono text-stone-500">LOOKBOOK · SCENE 04</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Deep Dive Product & Workflow Prose (SEO & Educational Foundation) -->
  <section class="py-16 sm:py-24 bg-marketing-surface border-b border-marketing-border transition-colors">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Prose Content -->
        <div class="lg:col-span-8 space-y-8 text-marketing-muted text-sm sm:text-base leading-relaxed">
          
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-bg border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              <span>COMPLETE OVERVIEW</span>
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
              A Browser-First Contact Sheet Maker Built for Photography Workflows
            </h2>
            <p>
              Make Contact Sheet is a dedicated photo workflow workspace designed to streamline how photographers, art directors, and studios compile, evaluate, and deliver visual image collections. Operating entirely within modern web browsers, the platform eliminates tedious software setups and expensive cloud upload queues, turning raw image folders into structured proof sheets, mood boards, and collages in seconds.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="text-xl font-bold text-marketing-text tracking-tight">
              Understanding Contact Sheets and Digital Proofing
            </h3>
            <p>
              In traditional darkroom photography, a contact sheet was created by placing strips of film negatives directly against photographic paper and exposing them to light. This produced an exact 1:1 index of an entire camera roll on a single print. 
            </p>
            <p>
              In modern digital production, contact sheets serve the same essential purpose: providing a scannable, high-density overview of a photoshoot. Instead of forcing clients or collaborators to open hundreds of high-resolution image files individually, a single digital proof sheet organizes shots into a structured grid. It displays original camera identifiers, capture sequences, and technical parameters side by side, making visual comparison intuitive and precise.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="text-xl font-bold text-marketing-text tracking-tight">
              Structured Review, Custom Culling, and Exact Metadata
            </h3>
            <p>
              Reviewing large batches of photos requires clear visual feedback. Make Contact Sheet incorporates rapid keyboard triage shortcuts, allowing you to mark individual frames as <strong>Keep</strong> (1), <strong>Flag</strong> (2), or <strong>Reject</strong> (3) while inspecting thumbnails.
            </p>
            <p>
              Because accurate communication depends on precise references, the layout engine extracts camera EXIF metadata directly from your files. Technical details—such as shutter speed, aperture, ISO, focal length, and exact camera filenames—can be rendered beneath each photo frame or embedded as clean badge overlays. You can also assign custom per-image labels or batch-rename files using dynamic token recipes before finalizing your sheets.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="text-xl font-bold text-marketing-text tracking-tight">
              Flexible Output: From Print-Ready PDFs to Lightroom Sync
            </h3>
            <p>
              Once your layout is configured, the export engine produces calibrated deliverables tailored to your next production stage:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-marketing-text/90">
              <li><strong>Print-Ready PDF Documents:</strong> Multi-page proof sheets formatted for standard US Letter and A4 dimensions at 300 DPI, complete with custom headers, studio watermarks, and page numbers.</li>
              <li><strong>High-Resolution Master Images:</strong> Export single-page JPEG, PNG, or WebP contact sheets and <a href="/collage-templates" class="text-accent-ink hover:underline font-medium">collage templates</a> up to 4K resolution.</li>
              <li><strong>Adobe Lightroom and Capture One Handoff:</strong> Download filtered TXT selection lists or structured CSV manifests to paste directly into Lightroom search bars, or export industry-standard XMP sidecar XMLs that automatically apply star ratings and color labels to your original RAW files.</li>
              <li><strong>Serverless Client Proofing Portals:</strong> Export a standalone, self-contained HTML gallery with built-in client rating buttons, zero hosting dependencies, and interactive review export.</li>
            </ul>
          </div>

          <div class="space-y-4">
            <h3 class="text-xl font-bold text-marketing-text tracking-tight">
              Freeform Mood Boards and Creative Visual Direction
            </h3>
            <p>
              When a project calls for conceptual planning rather than a rigid grid, our integrated <a href="/mood-board-maker" class="text-accent-ink hover:underline font-medium">mood board maker</a> provides an unconstrained freeform canvas. You can drag, resize, rotate, and layer photos alongside designer color swatch cards and stylist sticky notes. Featuring magnetic snapping guides and scaled 300 DPI exports, it gives creative directors and stylists the tools to pitch aesthetics, lighting setups, and wardrobe palettes effectively.
            </p>
          </div>

          <div class="space-y-4">
            <h3 class="text-xl font-bold text-marketing-text tracking-tight">
              In-Browser Execution and Client-Side Data Privacy
            </h3>
            <p>
              All image decoding, thumbnail generation, EXIF parsing, and rendering operations execute locally on your device hardware using HTML5 Canvas and client Web Workers. Your image files, camera filenames, and confidential client assets are never uploaded to an external server or stored in a remote cloud database. This local-first architecture ensures strict client confidentiality, avoids bandwidth bottlenecks, and allows immediate processing of large photo collections.
            </p>
          </div>

        </div>

        <!-- Right: Practical Workflow & Quick Links Card -->
        <div class="lg:col-span-4 space-y-6">
          
          <div class="p-6 sm:p-7 rounded-2xl bg-marketing-bg border border-marketing-border shadow-xs space-y-5">
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-accent-ink">
              Production Workflow
            </div>
            <h4 class="text-lg font-bold text-marketing-text">
              Four Steps to Client Delivery
            </h4>
            <ol class="space-y-4 text-xs sm:text-sm text-marketing-muted list-decimal list-inside">
              <li class="leading-relaxed">
                <strong class="text-marketing-text">Import Media:</strong> Drop image batches into the light-table with support for standard raster formats and RAW previews.
              </li>
              <li class="leading-relaxed">
                <strong class="text-marketing-text">Cull &amp; Review:</strong> Use keyboard keys 1–3 to tag keeps and rejects, or use automated sharpness evaluation to detect focus issues.
              </li>
              <li class="leading-relaxed">
                <strong class="text-marketing-text">Format Layout:</strong> Choose a <a href="/contact-sheet-template" class="text-accent-ink hover:underline font-medium">contact sheet template</a>, 8×10 print saver, or freeform mood board layout.
              </li>
              <li class="leading-relaxed">
                <strong class="text-marketing-text">Export Handoff:</strong> Generate 300 DPI PDFs, XMP sidecar packages, or filename lists for post-production.
              </li>
            </ol>
          </div>

          <div class="p-6 rounded-2xl bg-marketing-bg border border-marketing-border shadow-xs space-y-4">
            <div class="text-xs font-mono font-semibold uppercase tracking-wider text-marketing-muted">
              Specialized Studio Hubs
            </div>
            <ul class="space-y-2.5 text-xs sm:text-sm">
              <li>
                <a href="/photo-contact-sheet-maker" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>Photo Contact Sheet Maker</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
              <li>
                <a href="/mood-board-maker" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>Mood Board Maker</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
              <li>
                <a href="/photo-collage-maker" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>Photo Collage Maker</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
              <li>
                <a href="/batch-photo-tools" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>Batch Photo Tools</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
              <li>
                <a href="/free-8x10-photo-prints" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>8×10 Print Saver</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
              <li>
                <a href="/guides/how-to-make-a-contact-sheet" class="flex items-center justify-between text-marketing-text hover:text-accent-ink transition-colors font-medium">
                  <span>Contact Sheet Tutorial Guide</span>
                  <span class="text-xs text-marketing-muted">→</span>
                </a>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <ComparisonTable />

  <!-- FAQ Section -->
  <section class="py-16 sm:py-24 lg:py-28 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[840px] mx-auto px-4 sm:px-6">
      <div class="text-center max-w-xl mx-auto mb-12 sm:mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-marketing-text mb-4">
          Frequently Asked Questions
        </h2>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          Direct answers regarding privacy, file formats, and client selection workflows.
        </p>
      </div>

