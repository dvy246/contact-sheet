---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import { CONTACT_SHEET_PRESETS } from '../lib/engine/templates';
import { METADATA_REGISTRY } from '../lib/seo/metadata';
import { buildFAQSchema } from '../lib/seo/schemaGenerator';

const meta = METADATA_REGISTRY['/contact-sheet-template'];

const faqs = [
  {
    question: 'Which contact sheet template should I use for printing?',
    answer: 'For standard home and office printers, use either the A4 Portrait Proof Sheet (for international standard paper) or the US Letter Portrait Proof Sheet (for North American standard paper). Both include margins calibrated to ensure filenames and images fit inside printable margins.',
  },
  {
    question: 'Can I customize the rows and columns of these templates?',
    answer: 'Yes. While these templates provide tested defaults, you can freely adjust columns (1-8), rows (1-10), gutter spacing, and margins inside the FrameProof workspace.',
  },
  {
    question: 'What is the best template for client selection?',
    answer: 'The "Client Selection Sheet" preset is recommended. It uses a 3×4 grid with large photos, clear index numbers (#1, #2), and status indicators so clients can easily point out selections.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact Sheet Templates' },
];

const schemas = [
  buildFAQSchema(faqs),
];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
  schema={schemas}
>
  <div class="bg-white border-b border-marketing-border py-10 sm:py-14">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 mb-3">
          Free Contact Sheet Templates
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          Browse calibrated contact sheet presets for print proofing, client review sessions, and portfolio archiving. Choose a layout to start arranging your photos in seconds.
        </p>
      </div>
    </div>
  </div>

  <section class="py-12 sm:py-16 bg-marketing-bg border-b border-marketing-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CONTACT_SHEET_PRESETS.map((preset) => (
          <div class="bg-white border border-marketing-border rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-5 shadow-xs hover:border-zinc-300 transition-all">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-accent-amber font-mono">
                  {preset.category}
                </span>
                <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 font-mono text-zinc-700">
                  {preset.config.columns}×{preset.config.rows} Grid
                </span>
              </div>
              <h2 class="text-lg font-bold text-zinc-900">{preset.name}</h2>
              <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
                {preset.description}
              </p>

              <div class="pt-3 border-t border-marketing-border space-y-1.5 text-xs text-zinc-600 font-mono">
                <div class="flex justify-between">
                  <span>Page Size:</span>
                  <span class="font-bold text-zinc-900">{preset.config.pageSize?.toUpperCase()} ({preset.config.orientation})</span>
                </div>
                <div class="flex justify-between">
                  <span>Labels:</span>
                  <span class="font-bold text-zinc-900">{preset.config.labelType}</span>
                </div>
                <div class="flex justify-between">
                  <span>Margins / Gap:</span>
                  <span class="font-bold text-zinc-900">{preset.config.margin}px / {preset.config.spacing}px</span>
                </div>
              </div>
            </div>

            <a 
              href="/#workspace" 
              class="w-full py-2.5 px-4 rounded-xl bg-zinc-900 hover:bg-black text-white font-semibold text-xs text-center tracking-tight shadow-sm hover:shadow transition-all block"
            >
              Open in Workspace
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Section -->
  <section class="py-16 sm:py-20 bg-white border-b border-marketing-border">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="space-y-4 prose-measure">
        <h2 class="text-2xl font-bold text-zinc-900">
          How to choose the right contact sheet layout
        </h2>
        <p class="text-sm text-zinc-700 leading-relaxed">
          The ideal contact sheet layout balances thumbnail size with page density. If you are printing proofs for a client review binder, 16 to 20 images per A4 or US Letter page allows the viewer to evaluate facial expressions, lighting, and composition without needing a magnifying loupe.
        </p>
        <p class="text-sm text-zinc-700 leading-relaxed">
          For digital screen presentations and video call reviews, 16:9 widescreen formats (such as our 4×3 Digital Review Board) match modern laptop and monitor displays without leaving awkward blank vertical margins.
        </p>
      </div>

      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-zinc-900">Template FAQs</h2>
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>
</MarketingLayout>
