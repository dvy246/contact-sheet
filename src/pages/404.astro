---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Icon from '../components/common/Icon.astro';
import { METADATA_REGISTRY } from '../lib/seo/metadata';

const meta = METADATA_REGISTRY['/404'];
---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 bg-marketing-bg">
    <div class="max-w-md w-full text-center space-y-6 bg-white border border-marketing-border rounded-2xl p-8 sm:p-10 shadow-xs">
      <div class="w-14 h-14 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 mx-auto">
        <Icon name="help" size={28} />
      </div>

      <div class="space-y-2">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Page Not Found</h1>
        <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
          The requested page could not be located. You can return to the FrameProof workspace to continue creating contact sheets and collages.
        </p>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row gap-3 justify-center">
        <a 
          href="/" 
          class="h-10 px-5 rounded-xl bg-zinc-900 hover:bg-black text-white font-semibold text-xs tracking-tight shadow-sm flex items-center justify-center gap-2 transition-all"
        >
          <Icon name="arrow-left" size={14} />
          <span>Return to Homepage</span>
        </a>
        <a 
          href="/photo-contact-sheet-maker" 
          class="h-10 px-4 rounded-xl bg-marketing-surface hover:bg-zinc-200 text-zinc-900 font-medium text-xs border border-marketing-border flex items-center justify-center transition-all"
        >
          <span>Contact Sheet Maker</span>
        </a>
      </div>
    </div>
  </div>
</MarketingLayout>
