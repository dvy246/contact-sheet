---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import CollageTemplatePreview from '../components/marketing/CollageTemplatePreview.astro';
import HighlightText from '../components/ui/HighlightText.astro';
import { COLLAGE_TEMPLATES } from '../lib/engine/templates';
import { METADATA_REGISTRY } from '../lib/seo/metadata';

const meta = METADATA_REGISTRY['/collage-templates'];

const faqs = [
  {
    question: 'Can I change the spacing between photos in a collage template?',
    answer: 'Yes. Every template allows custom gutter spacing (from 0px borderless seamless tiles up to 40px wide separators) and outer margin adjustments in the workspace.',
  },
  {
    question: 'How do I fit photos with different aspect ratios?',
    answer: 'Make Contact Sheet allows you to choose between "Cover" (smart center crop that fills each cell completely) and "Contain" (which preserves the full uncropped image with letterboxing).',
  },
  {
    question: 'Are collage templates free to download and use?',
    answer: 'Yes. All templates in Make Contact Sheet are completely free with zero watermark restrictions or signup requirements.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Collage Templates' },
];

---

<MarketingLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robots={meta.robots}
>
  <div class="bg-marketing-panel border-b border-marketing-border py-12 sm:py-16 transition-colors">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-4">
      <Breadcrumbs items={breadcrumbs} />
      <div class="max-w-3xl space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-marketing-text leading-tight">
          Custom <HighlightText variant="pink">Photo Collage Templates</HighlightText> &amp; Layouts
        </h1>
        <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
          Explore customizable photo collage templates for social media stories, comparison boards, and print posters. Arrange your photos with balanced geometric proportions in seconds.
        </p>
      </div>
    </div>
  </div>


  <section class="py-12 sm:py-16 lg:py-20 bg-marketing-bg border-b border-marketing-border transition-colors">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
      
      <!-- Category Filter Bar -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 sm:mb-10 no-scrollbar" id="template-filter-bar">
        <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer bg-accent text-white border-accent shadow-xs">
          All ({COLLAGE_TEMPLATES.length})
        </button>
        <button data-filter="basic" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer bg-marketing-surface text-marketing-text border-marketing-border hover:border-accent/40">
          Basic Grid ({COLLAGE_TEMPLATES.filter(t => t.category === 'basic').length})
        </button>
        <button data-filter="showcase" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer bg-marketing-surface text-marketing-text border-marketing-border hover:border-accent/40">
          Showcase &amp; Editorial ({COLLAGE_TEMPLATES.filter(t => t.category === 'showcase').length})
        </button>
        <button data-filter="social" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer bg-marketing-surface text-marketing-text border-marketing-border hover:border-accent/40">
          Social Stories ({COLLAGE_TEMPLATES.filter(t => t.category === 'social').length})
        </button>
        <button data-filter="comparison" class="filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold font-mono border transition-all cursor-pointer bg-marketing-surface text-marketing-text border-marketing-border hover:border-accent/40">
          Comparison &amp; Duo ({COLLAGE_TEMPLATES.filter(t => t.category === 'comparison').length})
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {COLLAGE_TEMPLATES.map((template) => (
          <div 
            data-template-card
            data-category={template.category}
            class="bg-marketing-panel border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 shadow-xs hover:border-accent/40 hover:shadow-md transition-all group"
          >
            <div class="space-y-4">
              <!-- Visual Grid Structure Preview -->
              <CollageTemplatePreview template={template} />

              <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                    {template.category}
                  </span>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                    {template.cells.length} Photos
                  </span>
                </div>
                <h2 class="text-base sm:text-lg font-bold text-marketing-text group-hover:text-accent transition-colors">{template.name}</h2>
                <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
                  {template.description}
                </p>
              </div>

              <div class="pt-3 border-t border-marketing-border space-y-1.5 text-xs text-marketing-muted font-mono">
                <div class="flex justify-between">
                  <span>Aspect Ratio:</span>
                  <span class="font-bold text-marketing-text">{template.aspectRatio >= 1 ? `${template.aspectRatio.toFixed(2)}:1` : `1:${(1 / template.aspectRatio).toFixed(2)}`}</span>
                </div>
                <div class="flex justify-between">
                  <span>Default Gap:</span>
                  <span class="font-bold text-marketing-text">{template.defaultSpacing}px</span>
                </div>
              </div>
            </div>

            <a 
              href="/#workspace" 
              class="w-full py-2.5 px-4 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-xs text-center tracking-tight shadow-sm hover:shadow transition-all block"
            >
              Use This Template
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const filterBar = document.getElementById('template-filter-bar');
    if (filterBar) {
      const filterBtns = filterBar.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll<HTMLElement>('[data-template-card]');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('bg-accent', 'text-white', 'border-accent', 'shadow-xs');
            b.classList.add('bg-marketing-surface', 'text-marketing-text', 'border-marketing-border');
          });
          btn.classList.remove('bg-marketing-surface', 'text-marketing-text', 'border-marketing-border');
          btn.classList.add('bg-accent', 'text-white', 'border-accent', 'shadow-xs');

          const filter = btn.getAttribute('data-filter');
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }
  </script>

  <!-- Editorial Section -->
  <section class="py-16 sm:py-20 bg-marketing-panel border-b border-marketing-border transition-colors">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 space-y-10">
      <div class="space-y-4 prose-measure">
        <h2 class="text-2xl font-bold text-marketing-text">
          Template formats and use cases
        </h2>
        <p class="text-sm text-marketing-text/90 leading-relaxed">
          Make Contact Sheet templates are crafted around photographic proportions rather than generic graphics. For example, our 3-photo horizontal strip is perfect for landscape panoramas and documentary sequences, while our 9:16 vertical story format lets you combine portrait shots with detail insets for mobile platforms.
        </p>
      </div>

      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-marketing-text">Collage Template FAQs</h2>
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>
</MarketingLayout>
