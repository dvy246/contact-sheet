---
import '../styles/global.css';
import GlobalAtmosphere from '../components/common/GlobalAtmosphere.astro';
import { type Locale, DEFAULT_LOCALE, LOCALE_MAP } from '../i18n/config';
import { getHreflangLinks, getCanonicalUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  schema?: object | object[];
  locale?: Locale;
}

const {
  title = 'Make Contact Sheet - Free Contact Sheet & Collage Maker',
  description = 'Create professional contact sheets and photo collages directly in your browser. Fast, secure, and free. No signup required.',
  locale = DEFAULT_LOCALE,
  canonical = getCanonicalUrl(Astro.url.pathname, locale),
  robots = 'index, follow',
  ogType = 'website',
  schema,
} = Astro.props;

const siteName = 'Make Contact Sheet';
const ogImageUrl = 'https://makecontactsheet.com/og-image.png';
const currentLocaleConfig = LOCALE_MAP[locale] || LOCALE_MAP[DEFAULT_LOCALE];
const hreflangLinks = getHreflangLinks(Astro.url.pathname);
---

<!doctype html>
<html lang={currentLocaleConfig.langAttr} dir={currentLocaleConfig.dir || 'ltr'}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PESBYZ7MLZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-PESBYZ7MLZ');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Inline Anti-FOUC Theme Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    
    <!-- Title & SEO Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang Alternates (Strict International SEO) -->
    {!robots.includes('noindex') && hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Make Contact Sheet" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={currentLocaleConfig.ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts Preconnect & Inter / Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD structured data -->
    {schema && (
      Array.isArray(schema) ? (
        schema.map(s => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      ) : (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    )}

    <slot name="head" />
  </head>
  <body class="bg-marketing-bg text-marketing-text selection:bg-accent selection:text-white antialiased w-full min-w-0 overflow-x-hidden relative">
    <GlobalAtmosphere />
    <slot />
  </body>
</html>
