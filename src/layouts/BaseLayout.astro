---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  schema?: object | object[];
}

const {
  title = 'FrameProof — Free Contact Sheet & Collage Maker',
  description = 'Create professional contact sheets and photo collages directly in your browser. Fast, secure, and free. No signup required.',
  canonical = Astro.url.href.replace(/\/$/, '') || 'https://www.frameproof.com',
  robots = 'index, follow',
  ogType = 'website',
  schema,
} = Astro.props;

const siteName = 'FrameProof';
const ogImageUrl = 'https://www.frameproof.com/og-image.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Title & SEO Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts Preconnect & Inter / Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD structured data -->
    {schema && (
      Array.isArray(schema) ? (
        schema.map(s => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
        ))
      ) : (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    )}

    <slot name="head" />
  </head>
  <body class="bg-marketing-bg text-marketing-text selection:bg-accent-amber selection:text-black">
    <slot />
  </body>
</html>
