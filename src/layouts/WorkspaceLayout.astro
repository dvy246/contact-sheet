---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { type Locale, DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  schema?: object | object[];
  contentBelow?: boolean;
  locale?: Locale;
}

const { contentBelow = false, locale = DEFAULT_LOCALE, ...props } = Astro.props;
---

<BaseLayout {...props} locale={locale}>
  {
    contentBelow ? (
      <div class="min-h-dvh bg-workspace-bg text-workspace-text flex flex-col antialiased">
        <Header variant="workspace" locale={locale} />
        <main class="flex flex-col w-full min-w-0">
          <div class="studio-viewport flex flex-col w-full min-w-0">
            <slot />
          </div>
          <slot name="content" />
        </main>
        <Footer locale={locale} />
      </div>
    ) : (
      <div class="h-dvh overflow-hidden bg-workspace-bg text-workspace-text flex flex-col antialiased">
        <Header variant="workspace" locale={locale} />
        <main class="flex-1 min-h-0 flex flex-col overflow-hidden">
          <slot />
        </main>
      </div>
    )
  }
</BaseLayout>
