---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogType?: string;
  schema?: object | object[];
  /**
   * Render indexable copy under the app instead of locking the document to one
   * screen. The tool still opens at full height; the page just keeps scrolling
   * past it, so a crawler gets real content and the studio route can be a
   * first-class MPA page rather than a noindex shell.
   */
  contentBelow?: boolean;
}

const { contentBelow = false, ...props } = Astro.props;
---

<BaseLayout {...props}>
  {
    contentBelow ? (
      <div class="min-h-dvh bg-workspace-bg text-workspace-text flex flex-col antialiased">
        <Header variant="workspace" />
        <main class="flex flex-col w-full min-w-0">
          {/* One screen of app. The height must be definite (a calc, not a
              percentage or min-height) or the studio's nested flex columns fall
              back to content size and the shell grows unbounded. */}
          <div class="studio-viewport flex flex-col w-full min-w-0">
            <slot />
          </div>
          <slot name="content" />
        </main>
        <Footer />
      </div>
    ) : (
      /* `h-dvh`, not `min-h-screen`: the studio shell inside sizes itself from
         this height, and a min-height leaves the height indefinite, so every
         nested flex column falls back to its content size and the app grows into
         a multi-thousand-pixel page instead of filling one screen. `dvh` so
         mobile browser chrome does not push the export drawer off-screen. */
      <div class="h-dvh overflow-hidden bg-workspace-bg text-workspace-text flex flex-col antialiased">
        <Header variant="workspace" />
        <main class="flex-1 min-h-0 flex flex-col overflow-hidden">
          <slot />
        </main>
      </div>
    )
  }
</BaseLayout>
