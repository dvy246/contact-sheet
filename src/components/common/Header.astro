---
import Icon from './Icon.astro';

interface Props {
  variant?: 'marketing' | 'workspace';
}

const { variant = 'marketing' } = Astro.props;
const isWorkspace = variant === 'workspace';
---

<header class={`w-full z-50 transition-all ${
  isWorkspace 
    ? 'bg-workspace-panel/95 backdrop-blur-xl border-b border-workspace-border text-workspace-text' 
    : 'bg-marketing-bg/85 dark:bg-[#120E0C]/85 backdrop-blur-xl border-b border-marketing-border/80 text-marketing-text sticky top-0 shadow-[0_1px_3px_0_rgba(0,0,0,0.02)]'
}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 h-[68px] flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-accent/15 via-marketing-surface to-marketing-panel flex items-center justify-center border border-accent/25 dark:border-accent/35 group-hover:border-accent group-hover:scale-[1.04] transition-all duration-200 shadow-2xs">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-ink">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M3 9h18" />
          <path d="M9 21V9" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class={`font-bold tracking-tight text-base sm:text-[17px] leading-none ${isWorkspace ? 'text-workspace-text' : 'text-marketing-text'}`}>
          Make Contact <span class="text-accent-ink">Sheet</span>
        </span>
        <span class="text-[9px] font-mono tracking-wider uppercase text-marketing-muted/75 mt-0.5">
          Local Photo Studio
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Apple/Linear Style Fluid Floating Capsule) -->
    {!isWorkspace ? (
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-marketing-muted bg-marketing-surface/60 dark:bg-marketing-surface/40 p-1.5 rounded-full border border-marketing-border/70 backdrop-blur-xl shadow-xs">
        
        <!-- Tools Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>Tools</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Tools Mega Menu with Spring Scale In -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[310px] z-50">
            <a href="/photo-contact-sheet-maker" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="grid" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Contact Sheet Maker</span>
                <span class="text-[11px] text-marketing-muted">Batch photo proof sheets with filenames</span>
              </div>
            </a>

            <a href="/photo-collage-maker" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="layout" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Photo Collage Maker</span>
                <span class="text-[11px] text-marketing-muted">Creative grid layouts for print & social</span>
              </div>
            </a>

            <a href="/mood-board-maker" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="image" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Mood Board Maker</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent-green text-zinc-950 font-bold">NEW</span>
                </div>
                <span class="text-[11px] text-marketing-muted">Freeform visual boards &amp; lookbooks</span>
              </div>
            </a>

            <a href="/batch-photo-tools" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-text" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Batch Photo Tools</span>
                <span class="text-[11px] text-marketing-muted">Rename recipes, EXIF &amp; format converter</span>
              </div>
            </a>

            <a href="/auto-cull-photos" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="wand" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">AI Auto-Cull</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent-green text-zinc-950 font-bold">AI</span>
                </div>
                <span class="text-[11px] text-marketing-muted">Filter blurry & out-of-focus photos</span>
              </div>
            </a>

            <a href="/free-8x10-photo-prints" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="printer" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">8×10 Print Saver</span>
                <span class="text-[11px] text-marketing-muted">Combine multiple photos on 8×10 sheet</span>
              </div>
            </a>

            <div class="my-1 border-t border-marketing-border"></div>

            <a href="/studio/contact-sheet" class="group/item flex items-start gap-3 p-2.5 rounded-xl bg-accent/10 hover:bg-accent/15 border border-accent/30 transition-colors shadow-2xs">
              <div class="w-8 h-8 rounded-lg bg-accent/20 border border-accent/40 flex items-center justify-center shrink-0 text-accent">
                <Icon name="camera" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-accent-ink text-xs sm:text-sm">Contact Sheet Studio</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent text-white font-bold">PRO</span>
                </div>
                <span class="text-[11px] text-marketing-muted">Full-screen light table with zoom & EXIF</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Templates Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>Templates</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Templates Dropdown Menu -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[290px] z-50">
            <a href="/contact-sheet-template" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="columns" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Contact Sheet Templates</span>
                <span class="text-[11px] text-marketing-muted">21 print, film & review presets</span>
              </div>
            </a>

            <a href="/collage-templates" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="crop" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Collage Templates</span>
                <span class="text-[11px] text-marketing-muted">18 geometric & social story layouts</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Guides Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>Guides</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Guides Dropdown Menu -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[290px] z-50">
            <a href="/guides/how-to-make-a-contact-sheet" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-text" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">How to Make a Contact Sheet</span>
                <span class="text-[11px] text-marketing-muted">Step-by-step photography guide</span>
              </div>
            </a>

            <a href="/guides/how-to-make-photo-collage" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="image" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">How to Make a Photo Collage</span>
                <span class="text-[11px] text-marketing-muted">Composition & proportions</span>
              </div>
            </a>

            <a href="/guides/photo-proof-sheet-with-filenames" class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-check" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">Proof Sheets with Filenames</span>
                <span class="text-[11px] text-marketing-muted">Lightroom & client review workflow</span>
              </div>
            </a>
          </div>
        </div>

        <a href="/compare/photoshop-contact-sheet-alternative" class="px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 transition-all">
          Compare
        </a>
      </nav>
    ) : (
      <div class="flex items-center gap-3 text-xs text-workspace-muted">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-workspace-surface/80 border border-workspace-border backdrop-blur-sm shadow-2xs font-mono text-[11px]">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-workspace-text font-medium">100% In-Browser Privacy Enclave</span>
        </span>
      </div>
    )}

    <!-- Header Actions & Theme Toggle -->
    <div class="flex items-center gap-2.5 sm:gap-3.5 shrink-0">
      
      <!-- Theme Switcher (Light / Dark slider) -->
      <button
        id="theme-toggle-btn"
        type="button"
        role="switch"
        aria-checked="false"
        class={`theme-switch ${isWorkspace ? 'theme-switch-workspace' : ''}`}
        aria-label="Toggle light and dark theme"
        title="Toggle light / dark theme"
      >
        <span class="theme-switch-track">
          <!-- Sun icon (left rail) -->
          <svg class="theme-switch-rail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
          <!-- Moon icon (right rail) -->
          <svg class="theme-switch-rail-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z" />
          </svg>
          <span class="theme-switch-knob"></span>
        </span>
      </button>

      {!isWorkspace ? (
        <a 
          href="/#workspace" 
          class="hidden sm:inline-flex items-center justify-center gap-2 h-10 px-5 rounded-full bg-accent hover:bg-accent-hover text-white text-xs sm:text-sm font-semibold tracking-tight shadow-sm hover:shadow-md hover:shadow-accent/20 active:scale-[0.98] transition-all"
        >
          <span>Start Creating</span>
          <Icon name="arrow-right" size={14} />
        </a>
      ) : (
        <a
          href="/studio/contact-sheet"
          class="inline-flex items-center justify-center gap-1.5 h-8.5 px-3.5 rounded-lg bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text text-xs font-semibold border border-workspace-border transition-colors shadow-2xs"
        >
          <Icon name="rotate-ccw" size={13} />
          <span>New Batch</span>
        </a>
      )}

      <!-- Mobile Menu Button (Marketing only) -->
      {!isWorkspace && (
        <button 
          id="mobile-menu-toggle"
          class="md:hidden p-2.5 rounded-xl text-marketing-muted hover:text-marketing-text hover:bg-marketing-surface border border-marketing-border/60 transition-colors"
          aria-label="Toggle Navigation Menu"
        >
          <Icon name="columns" size={18} />
        </button>
      )}
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  {!isWorkspace && (
    <div id="mobile-menu" class="hidden md:hidden border-t border-marketing-border bg-marketing-panel/98 backdrop-blur-2xl px-4 py-5 space-y-4 shadow-xl">
      <a 
        href="/#workspace" 
        class="flex items-center justify-center gap-2 w-full h-11 rounded-full bg-accent hover:bg-accent-hover text-white font-semibold text-sm shadow-sm active:scale-[0.98] transition-all"
      >
        <span>Start Creating</span>
        <Icon name="arrow-right" size={16} />
      </a>
      
      <div class="space-y-3">
        <div class="text-[11px] font-mono uppercase tracking-wider text-accent-ink font-bold">Tools</div>
        <div class="grid grid-cols-1 gap-1">
          <a href="/photo-contact-sheet-maker" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Photo Contact Sheet Maker</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/photo-collage-maker" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Photo Collage Maker</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/mood-board-maker" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Mood Board Maker</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/batch-photo-tools" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Batch Photo Tools</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/studio/contact-sheet" class="py-2 px-3 rounded-lg bg-accent/10 text-sm font-semibold text-accent-ink flex items-center justify-between transition-colors">
            <span>Contact Sheet Studio (Full Screen)</span>
            <span class="text-[9px] font-mono px-1.5 py-0.2 rounded bg-accent text-white font-bold">PRO</span>
          </a>
        </div>
      </div>

      <div class="space-y-3">
        <div class="text-[11px] font-mono uppercase tracking-wider text-accent-ink font-bold">Templates</div>
        <div class="grid grid-cols-1 gap-1">
          <a href="/contact-sheet-template" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Contact Sheet Templates (21 Presets)</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/collage-templates" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Collage Templates (18 Layouts)</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
        </div>
      </div>

      <div class="space-y-3">
        <div class="text-[11px] font-mono uppercase tracking-wider text-accent-ink font-bold">Guides & Alternatives</div>
        <div class="grid grid-cols-1 gap-1">
          <a href="/guides/how-to-make-a-contact-sheet" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>How to Make a Contact Sheet</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/guides/how-to-make-photo-collage" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>How to Make a Photo Collage</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/guides/photo-proof-sheet-with-filenames" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Proof Sheets with Filenames</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
          <a href="/compare/photoshop-contact-sheet-alternative" class="py-2 px-3 rounded-lg hover:bg-marketing-surface text-sm font-medium text-marketing-text flex items-center justify-between transition-colors">
            <span>Photoshop Alternative</span>
            <Icon name="chevron-right" size={14} class="text-marketing-muted" />
          </a>
        </div>
      </div>
    </div>
  )}
</header>

<script>
  // Mobile Menu Toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Light / Dark slider controller.
  const themeBtn = document.getElementById('theme-toggle-btn');

  function syncSwitch(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    themeBtn?.setAttribute('aria-checked', String(isDark));
  }

  syncSwitch(document.documentElement.classList.contains('dark'));

  themeBtn?.addEventListener('click', () => {
    const nextIsDark = !document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
    syncSwitch(nextIsDark);
  });
</script>
