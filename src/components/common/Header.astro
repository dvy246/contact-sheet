---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/config';
import { HEADER_FOOTER_DATA } from '../../i18n/data/headerFooterData';
import { l } from '../../i18n/utils';

interface Props {
  variant?: 'marketing' | 'workspace';
  locale?: Locale;
}

const { variant = 'marketing', locale = DEFAULT_LOCALE } = Astro.props;
const isWorkspace = variant === 'workspace';
const nav = HEADER_FOOTER_DATA[locale] || HEADER_FOOTER_DATA[DEFAULT_LOCALE];
---

<header class={`w-full z-50 transition-all ${
  isWorkspace 
    ? 'bg-workspace-panel/95 backdrop-blur-xl border-b border-workspace-border text-workspace-text' 
    : 'bg-marketing-bg/85 dark:bg-[#120E0C]/85 backdrop-blur-xl border-b border-marketing-border/80 text-marketing-text sticky top-0 shadow-[0_1px_3px_0_rgba(0,0,0,0.02)]'
}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 h-[68px] flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href={l("/", locale)} class="flex items-center gap-3 group shrink-0">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-accent/15 via-marketing-surface to-marketing-panel flex items-center justify-center border border-accent/25 dark:border-accent/35 group-hover:border-accent group-hover:scale-[1.04] transition-all duration-200 shadow-2xs">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-ink">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M3 9h18" />
          <path d="M9 21V9" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class={`font-bold tracking-tight text-base sm:text-[17px] leading-none ${isWorkspace ? 'text-workspace-text' : 'text-marketing-text'}`}>
          Make Contact <span class="text-accent-ink">Sheet</span>
        </span>
        <span class="text-[9px] font-mono tracking-wider uppercase text-marketing-muted/75 mt-0.5">
          Local Photo Studio
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Apple/Linear Style Fluid Floating Capsule) -->
    {!isWorkspace ? (
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-marketing-muted bg-marketing-surface/60 dark:bg-marketing-surface/40 p-1.5 rounded-full border border-marketing-border/70 backdrop-blur-xl shadow-xs">
        
        <!-- Tools Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>{nav.tools}</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Tools Mega Menu with Spring Scale In -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[310px] z-50">
            <a href={l("/photo-contact-sheet-maker", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="grid" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolContactSheet}</span>
                <span class="text-[11px] text-marketing-muted">{nav.toolContactSheetDesc}</span>
              </div>
            </a>

            <a href={l("/photo-collage-maker", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="layout" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolCollage}</span>
                <span class="text-[11px] text-marketing-muted">{nav.toolCollageDesc}</span>
              </div>
            </a>

            <a href={l("/mood-board-maker", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="image" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolMoodBoard}</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent-green text-zinc-950 font-bold">NEW</span>
                </div>
                <span class="text-[11px] text-marketing-muted">{nav.toolMoodBoardDesc}</span>
              </div>
            </a>

            <a href={l("/batch-photo-tools", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-text" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolBatch}</span>
                <span class="text-[11px] text-marketing-muted">{nav.toolBatchDesc}</span>
              </div>
            </a>

            <a href={l("/auto-cull-photos", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="wand" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolAutoCull}</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent-green text-zinc-950 font-bold">AI</span>
                </div>
                <span class="text-[11px] text-marketing-muted">{nav.toolAutoCullDesc}</span>
              </div>
            </a>

            <a href={l("/free-8x10-photo-prints", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="printer" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.tool8x10}</span>
                <span class="text-[11px] text-marketing-muted">{nav.tool8x10Desc}</span>
              </div>
            </a>

            <a href={l("/large-photo-prints", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="printer" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.toolLarge}</span>
                <span class="text-[11px] text-marketing-muted">{nav.toolLargeDesc}</span>
              </div>
            </a>

            <div class="my-1 border-t border-marketing-border"></div>

            <a href="/studio/contact-sheet" class="group/item flex items-start gap-3 p-2.5 rounded-xl bg-accent/10 hover:bg-accent/15 border border-accent/30 transition-colors shadow-2xs">
              <div class="w-8 h-8 rounded-lg bg-accent/20 border border-accent/40 flex items-center justify-center shrink-0 text-accent">
                <Icon name="camera" size={16} />
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-accent-ink text-xs sm:text-sm">Contact Sheet Studio</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-full bg-accent text-white font-bold">PRO</span>
                </div>
                <span class="text-[11px] text-marketing-muted">Full-screen light table with zoom & EXIF</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Templates Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>{nav.templates}</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Templates Dropdown Menu -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[290px] z-50">
            <a href={l("/contact-sheet-template", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="columns" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.tplContactSheet}</span>
                <span class="text-[11px] text-marketing-muted">{nav.tplContactSheetDesc}</span>
              </div>
            </a>

            <a href={l("/collage-templates", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="crop" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.tplCollage}</span>
                <span class="text-[11px] text-marketing-muted">{nav.tplCollageDesc}</span>
              </div>
            </a>

            <a href={l("/mood-board-templates", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 group-hover/item:border-accent/40 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="layout" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.tplMoodBoard}</span>
                <span class="text-[11px] text-marketing-muted">{nav.tplMoodBoardDesc}</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Guides Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>{nav.guides}</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <!-- Guides Dropdown Menu -->
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[290px] z-50">
            <a href={l("/guides/how-to-make-a-contact-sheet", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-text" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideContactSheet}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideContactSheetDesc}</span>
              </div>
            </a>

            <a href={l("/guides/how-to-make-photo-collage", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="layout" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideCollage}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideCollageDesc}</span>
              </div>
            </a>

            <a href={l("/guides/how-to-make-a-mood-board", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="image" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideMoodBoard}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideMoodBoardDesc}</span>
              </div>
            </a>

            <a href={l("/guides/photo-proof-sheet-with-filenames", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-check" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideFilenames}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideFilenamesDesc}</span>
              </div>
            </a>

            <a href={l("/guides/standard-large-photo-frames-and-print-sizes", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="crop" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideFrames}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideFramesDesc}</span>
              </div>
            </a>

            <a href={l("/guides/wedding-photography-proofing-workflow", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="camera" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideWedding}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideWeddingDesc}</span>
              </div>
            </a>

            <a href={l("/guides/large-photo-albums-vs-proof-books", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="columns" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideAlbums}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideAlbumsDesc}</span>
              </div>
            </a>

            <div class="my-1 border-t border-marketing-border"></div>

            <a href={l("/lightroom-client-selection-workflow", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="wand" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideLightroom}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideLightroomDesc}</span>
              </div>
            </a>

            <a href={l("/white-label-client-gallery", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="shield" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.guideWhiteLabel}</span>
                <span class="text-[11px] text-marketing-muted">{nav.guideWhiteLabelDesc}</span>
              </div>
            </a>
          </div>
        </div>

        <a href={l("/compare/photoshop-contact-sheet-alternative", locale)} class="px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 transition-all">{nav.compare}</a>

        <!-- About & Company Dropdown -->
        <div class="relative group">
          <button 
            type="button"
            class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-marketing-muted hover:text-marketing-text hover:bg-marketing-panel/90 group-hover:text-marketing-text group-hover:bg-marketing-panel/90 transition-all duration-200 cursor-pointer"
          >
            <span>{nav.about}</span>
            <Icon name="chevron-down" size={13} class="group-hover:rotate-180 transition-transform duration-200 text-marketing-muted group-hover:text-marketing-text" />
          </button>
          
          <div class="absolute left-0 top-[calc(100%+8px)] pointer-events-none group-hover:pointer-events-auto opacity-0 -translate-y-2 scale-95 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-200 ease-out origin-top-left flex flex-col bg-marketing-panel/98 dark:bg-[#1A1512]/98 backdrop-blur-2xl border border-marketing-border rounded-2xl shadow-2xl p-2 min-w-[260px] z-50">
            <a href={l("/about-us", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="help" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.companyAbout}</span>
                <span class="text-[11px] text-marketing-muted">{nav.companyAboutDesc}</span>
              </div>
            </a>

            <a href={l("/contact-us", locale)} class="group/item flex items-start gap-3 p-2.5 rounded-xl hover:bg-marketing-surface transition-colors">
              <div class="w-8 h-8 rounded-lg bg-marketing-surface border border-marketing-border flex items-center justify-center shrink-0 text-marketing-text group-hover/item:text-accent shadow-xs">
                <Icon name="file-text" size={16} />
              </div>
              <div class="flex flex-col">
                <span class="font-semibold text-marketing-text text-xs sm:text-sm group-hover/item:text-accent transition-colors">{nav.companyContact}</span>
                <span class="text-[11px] text-marketing-muted">{nav.companyContactDesc}</span>
              </div>
            </a>

            <div class="my-1 border-t border-marketing-border"></div>

            <a href="/privacy-policy" class="group/item flex items-start gap-3 px-2.5 py-2 rounded-xl hover:bg-marketing-surface transition-colors">
              <span class="text-xs text-marketing-muted group-hover/item:text-marketing-text font-medium">{nav.companyPrivacy}</span>
            </a>
            <a href="/terms-and-conditions" class="group/item flex items-start gap-3 px-2.5 py-2 rounded-xl hover:bg-marketing-surface transition-colors">
              <span class="text-xs text-marketing-muted group-hover/item:text-marketing-text font-medium">{nav.companyTerms}</span>
            </a>
          </div>
        </div>
      </nav>
    ) : (
      <div class="flex items-center gap-3 text-xs text-workspace-muted">
