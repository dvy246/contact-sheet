---
interface Props {
  name: 
    | 'grid'
    | 'layout'
    | 'upload'
    | 'cloud-upload'
    | 'download'
    | 'check'
    | 'x'
    | 'star'
    | 'trash'
    | 'zoom-in'
    | 'zoom-out'
    | 'settings'
    | 'help'
    | 'arrow-left'
    | 'arrow-right'
    | 'info'
    | 'shield'
    | 'chevron-down'
    | 'chevron-right'
    | 'file-text'
    | 'filter'
    | 'image'
    | 'columns'
    | 'eye'
    | 'external-link'
    | 'maximize'
    | 'rotate-ccw'
    | 'plus'
    | 'folder'
    | 'crop'
    | 'camera'
    | 'file-check';
  class?: string;
  size?: number | string;
}

const { name, class: className = '', size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'grid' && (
    <>
      <rect width="7" height="7" x="3" y="3" rx="1" />
      <rect width="7" height="7" x="14" y="3" rx="1" />
      <rect width="7" height="7" x="14" y="14" rx="1" />
      <rect width="7" height="7" x="3" y="14" rx="1" />
    </>
  )}
  {name === 'layout' && (
    <>
      <rect width="18" height="18" x="3" y="3" rx="2" />
      <path d="M3 9h18" />
      <path d="M9 21V9" />
    </>
  )}
  {name === 'cloud-upload' && (
    <>
      <path d="M12 13v8" />
      <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
