---
import Icon from './Icon.astro';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  class?: string;
}

const { faqs, class: className = '' } = Astro.props;
---

<div class={`space-y-4 ${className}`}>
  {faqs.map((faq) => (
    <details class="group bg-marketing-panel border border-marketing-border rounded-2xl p-5 sm:p-6 transition-all open:shadow-xs open:border-accent/40">
      <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-marketing-text cursor-pointer list-none select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded-xl">
        <span class="pr-4 leading-snug">{faq.question}</span>
        <div class="w-7 h-7 rounded-lg bg-marketing-surface border border-marketing-border/60 flex items-center justify-center text-marketing-muted group-hover:text-marketing-text group-open:rotate-180 group-open:text-accent transition-all flex-shrink-0 shadow-2xs">
          <Icon name="chevron-down" size={14} />
        </div>
      </summary>
      <div class="mt-4 pt-4 border-t border-marketing-border/80 text-xs sm:text-sm text-marketing-muted leading-relaxed">
        <p set:html={faq.answer} />
      </div>
    </details>
  ))}
</div>
