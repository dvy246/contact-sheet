---
/**
 * GradientBackground — animated ambient gradient field.
 *
 * Ported from the 21st.dev "Pipo" gradient recipe, with three deliberate
 * changes:
 *
 * 1. Astro, not React. This site has no React runtime — `@astrojs/react` was
 *    removed because its refresh wrapper crashed every dev module transform.
 *    The original component renders one static <div> tree with no state, so
 *    there is nothing React was buying here.
 * 2. Palette swapped from the recipe's cream/peach (#FAF9EF / #E6B093) to the
 *    site's chocolate-truffle range — caramel (#C98A46), deep cocoa (#6B3C12)
 *    and a cream highlight — and the opaque base colour dropped entirely so
 *    the section's own --marketing-* token still paints the canvas. That is
 *    what keeps this working in both light and dark mode.
 * 3. `filter: blur(8cqmin)` removed. A full-bleed blur is the most expensive
 *    thing in the original: it forces an offscreen rasterisation pass, and any
 *    animated `scale` under it re-rasterises every frame. The softness comes
 *    from the gradients' own multi-stop alpha falloff instead, which costs
 *    nothing. The recipe's second, live `feTurbulence` <svg> is also dropped —
 *    the 120px tiled data-URI below produces the same grain and rasterises
 *    once instead of over the whole viewport.
 *
 * Per-frame cost: three composited layers moved by `translate3d` only. No
 * layout, no paint, no filters. Everything stops under
 * `prefers-reduced-motion`.
 */
interface Props {
  class?: string;
  /** `bold` for hero-scale sections, `subtle` for interior bands. */
  intensity?: 'bold' | 'subtle';
  /** Set false to render the same field with no motion. */
  animated?: boolean;
}

const { class: className = '', intensity = 'bold', animated = true } = Astro.props;
---

<div
  class:list={['gb-root', className]}
  data-intensity={intensity}
  data-animated={animated ? 'true' : 'false'}
  aria-hidden="true"
>
  <div class="gb-layer gb-layer-1"></div>
  <div class="gb-layer gb-layer-2"></div>
  <div class="gb-layer gb-layer-3"></div>
  <div class="gb-grain"></div>
</div>

<style>
  .gb-root {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Confines the layers' paint to this box so the drift can never invalidate
       anything outside the section. */
    contain: paint;
  }

  .gb-layer {
    position: absolute;
    /* Oversized so a drifting layer never pulls its own falloff edge into
       view. Amplitudes below stay well inside this bleed. */
    inset: -35%;
    /* Promoted by the animation; declared here so the static case
       (animated={false} / reduced motion) is composited the same way. */
    transform: translate3d(0, 0, 0);
  }

  /* Light Mode: Radiant warm caramel, sunlit amber, and terracotta glow */
  .gb-layer-1 {
    background: radial-gradient(
      ellipse 65% 55% at 65% 35%,
      rgba(201, 100, 66, 0.36) 0%,
      rgba(215, 125, 75, 0.26) 25%,
      rgba(235, 160, 95, 0.15) 50%,
      rgba(245, 195, 140, 0.05) 75%,
      rgba(251, 247, 242, 0) 100%
    );
  }

  .gb-layer-2 {
    background: radial-gradient(
      ellipse 70% 60% at 28% 70%,
      rgba(224, 138, 50, 0.32) 0%,
      rgba(235, 160, 70, 0.22) 28%,
      rgba(245, 185, 110, 0.12) 55%,
      rgba(251, 247, 242, 0) 80%
    );
  }

  .gb-layer-3 {
    background: radial-gradient(
      circle at 50% 18%,
      rgba(238, 110, 70, 0.26) 0%,
      rgba(245, 150, 90, 0.18) 25%,
      rgba(250, 190, 130, 0.09) 50%,
      rgba(251, 247, 242, 0) 75%
    );
  }

  /* Dark Mode: Deep truffle caramel, cocoa, and warm cream illumination */
  :global(html.dark) .gb-layer-1 {
    background: radial-gradient(
      circle at 68% 46%,
      rgba(201, 138, 70, 0.22) 0%,
      rgba(201, 138, 70, 0.17) 10%,
      rgba(201, 138, 70, 0.1) 21%,
      rgba(201, 138, 70, 0.03) 31%,
      rgba(201, 138, 70, 0) 41%
    );
  }

  :global(html.dark) .gb-layer-2 {
    background: radial-gradient(
      circle at 25% 76%,
      rgba(156, 90, 28, 0.24) 0%,
      rgba(156, 90, 28, 0.19) 11%,
      rgba(156, 90, 28, 0.11) 22%,
      rgba(156, 90, 28, 0.03) 33%,
      rgba(156, 90, 28, 0) 45%
    );
  }

  :global(html.dark) .gb-layer-3 {
    background: radial-gradient(
      circle at 53% 13%,
      rgba(216, 188, 158, 0.18) 0%,
      rgba(216, 188, 158, 0.14) 17%,
      rgba(216, 188, 158, 0.08) 33%,
      rgba(216, 188, 158, 0.025) 50%,
      rgba(216, 188, 158, 0) 67%
    );
  }

  .gb-root[data-intensity='subtle'] .gb-layer {
    opacity: 0.55;
  }

  /* Film grain. One 120px tile, rasterised once and repeated — no live SVG
     filter over the viewport. Static, so the blend costs one paint, not one
     per frame. */
  .gb-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 120px 120px;
    opacity: 0.16;
    mix-blend-mode: overlay;
  }

  :global(html.dark) .gb-grain {
    opacity: 0.24;
    mix-blend-mode: soft-light;
  }

  /* Drift. `translate3d` only — the layers are gradients, so a composited
     transform needs no repaint. Percentages are of the layer's own oversized
     box, and `alternate` reverses without a seam, so no keyframe has to loop
     back to its start position. */
  @keyframes gb-drift-1 {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(3.5%, -2.5%, 0);
    }
  }

  @keyframes gb-drift-2 {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-3%, -3.5%, 0);
    }
  }

  @keyframes gb-drift-3 {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(2%, 2.5%, 0);
    }
  }

  /* Co-prime-ish durations so the three layers never resynchronise into a
     visible pulse. */
  .gb-root[data-animated='true'] .gb-layer-1 {
    animation: gb-drift-1 23s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }

  .gb-root[data-animated='true'] .gb-layer-2 {
    animation: gb-drift-2 31s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }

  .gb-root[data-animated='true'] .gb-layer-3 {
    animation: gb-drift-3 19s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
  }

  @media (prefers-reduced-motion: reduce) {
    .gb-root[data-animated='true'] .gb-layer {
      animation: none;
    }
  }
</style>
