---
import Icon from './Icon.astro';
---

<footer class="w-full bg-marketing-panel border-t border-marketing-border text-marketing-text mt-auto transition-colors">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 sm:gap-12">
      <!-- Column 1: Brand & Trust -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-7 h-7 rounded-lg bg-marketing-surface flex items-center justify-center border border-marketing-border group-hover:border-accent transition-colors shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#c98a46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M3 9h18" />
              <path d="M9 21V9" />
            </svg>
          </div>
          <span class="font-bold tracking-tight text-base text-marketing-text">
            Make Contact <span class="text-accent-ink">Sheet</span>
          </span>
        </a>
        <p class="text-xs text-marketing-muted leading-relaxed">
          Browser-first photo contact sheet, collage, and review workspace. Prepare image batches, organize proof sheets, and export filename lists locally without accounts or uploads.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-medium">
          <Icon name="shield" size={14} class="text-emerald-500" />
          <span>Zero Server Uploads - 100% Private</span>
        </div>
      </div>

      <!-- Column 2: Tools & Templates -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">Workspace Tools</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/photo-contact-sheet-maker" class="hover:text-accent-ink transition-colors">Photo Contact Sheet Maker</a>
          </li>
          <li>
            <a href="/photo-collage-maker" class="hover:text-accent-ink transition-colors">Photo Collage Maker</a>
          </li>
          <li>
            <a href="/mood-board-maker" class="hover:text-accent-ink transition-colors">Mood Board Maker</a>
          </li>
          <li>
            <a href="/batch-photo-tools" class="hover:text-accent-ink transition-colors">Batch Photo Tools</a>
          </li>
          <li>
            <a href="/auto-cull-photos" class="hover:text-accent-ink transition-colors">AI Auto-Cull Photos</a>
          </li>
          <li>
            <a href="/free-8x10-photo-prints" class="hover:text-accent-ink transition-colors">Free 8×10 Photo Prints</a>
          </li>
          <li>
            <a href="/large-photo-prints" class="hover:text-accent-ink transition-colors">Large Poster Prints</a>
          </li>
          <li>
            <a href="/bulk-resize-photos-to-16-9" class="hover:text-accent-ink transition-colors">Bulk Resize to 16:9</a>
          </li>
          <li>
            <a href="/compress-photos-for-web" class="hover:text-accent-ink transition-colors">Compress Photos for Web</a>
          </li>
          <li>
            <a href="/contact-sheet-template" class="hover:text-accent-ink transition-colors">Contact Sheet Templates</a>
          </li>
          <li>
            <a href="/collage-templates" class="hover:text-accent-ink transition-colors">Collage Templates</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Workflow Guides -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">Guides & Workflows</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/lightroom-client-selection-workflow" class="hover:text-accent-ink transition-colors">Lightroom Selection Workflow</a>
          </li>
          <li>
            <a href="/white-label-client-gallery" class="hover:text-accent-ink transition-colors">White Label Client Gallery</a>
          </li>
          <li>
            <a href="/guides/how-to-make-a-contact-sheet" class="hover:text-accent-ink transition-colors">How to Make a Contact Sheet</a>
          </li>
          <li>
            <a href="/guides/how-to-make-photo-collage" class="hover:text-accent-ink transition-colors">How to Make a Photo Collage</a>
          </li>
          <li>
            <a href="/guides/photo-proof-sheet-with-filenames" class="hover:text-accent-ink transition-colors">Proof Sheets with Filenames</a>
          </li>
          <li>
            <a href="/compare/photoshop-contact-sheet-alternative" class="hover:text-accent-ink transition-colors">Photoshop Alternative</a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Trust & Legal -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">About & Legal</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/about-us" class="hover:text-accent-ink transition-colors">About Make Contact Sheet</a>
          </li>
          <li>
            <a href="/contact-us" class="hover:text-accent-ink transition-colors">Contact & Support</a>
          </li>
          <li>
            <a href="/privacy-policy" class="hover:text-accent-ink transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="hover:text-accent-ink transition-colors">Terms of Service</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-marketing-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-marketing-muted">
      <div>
        &copy; {new Date().getFullYear()} Make Contact Sheet. All rights reserved. Created for photographers and visual artists.
      </div>
      <div class="flex items-center gap-6">
        <span>Runs locally on your device</span>
        <span>No telemetry on photos</span>
      </div>
    </div>
  </div>
</footer>
