---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/config';
import { HEADER_FOOTER_DATA } from '../../i18n/data/headerFooterData';
import { l } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const nav = HEADER_FOOTER_DATA[locale] || HEADER_FOOTER_DATA[DEFAULT_LOCALE];
---

<footer class="w-full bg-marketing-panel border-t border-marketing-border text-marketing-text mt-auto transition-colors">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 sm:gap-12">
      <!-- Column 1: Brand & Trust -->
      <div class="space-y-4 md:col-span-1">
        <a href={l("/", locale)} class="flex items-center gap-2 group">
          <div class="w-7 h-7 rounded-lg bg-marketing-surface flex items-center justify-center border border-marketing-border group-hover:border-accent transition-colors shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#c98a46" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M3 9h18" />
              <path d="M9 21V9" />
            </svg>
          </div>
          <span class="font-bold tracking-tight text-base text-marketing-text">
            Make Contact <span class="text-accent-ink">Sheet</span>
          </span>
        </a>
        <p class="text-xs text-marketing-muted leading-relaxed">
          Browser-first photo contact sheet, collage, and review workspace. Prepare image batches, organize proof sheets, and export filename lists locally without accounts or uploads.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-medium">
          <Icon name="shield" size={14} class="text-emerald-500" />
          <span>Zero Server Uploads - 100% Private</span>
        </div>
        <div class="pt-1">
          <LanguageSwitcher currentLocale={locale} currentPath={Astro.url.pathname} variant="footer" />
        </div>
      </div>

      <!-- Column 2: Tools & Templates -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">{nav.tools}</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href={l("/photo-contact-sheet-maker", locale)} class="hover:text-accent-ink transition-colors">{nav.toolContactSheet}</a>
          </li>
          <li>
            <a href={l("/photo-collage-maker", locale)} class="hover:text-accent-ink transition-colors">{nav.toolCollage}</a>
          </li>
          <li>
            <a href={l("/mood-board-maker", locale)} class="hover:text-accent-ink transition-colors">{nav.toolMoodBoard}</a>
          </li>
          <li>
            <a href={l("/batch-photo-tools", locale)} class="hover:text-accent-ink transition-colors">{nav.toolBatch}</a>
          </li>
          <li>
            <a href={l("/auto-cull-photos", locale)} class="hover:text-accent-ink transition-colors">{nav.toolAutoCull}</a>
          </li>
          <li>
            <a href={l("/free-8x10-photo-prints", locale)} class="hover:text-accent-ink transition-colors">{nav.tool8x10}</a>
          </li>
          <li>
            <a href={l("/large-photo-prints", locale)} class="hover:text-accent-ink transition-colors">{nav.toolLarge}</a>
          </li>
          <li>
            <a href={l("/bulk-resize-photos-to-16-9", locale)} class="hover:text-accent-ink transition-colors">{nav.bulkResize || "Bulk Resize to 16:9"}</a>
          </li>
          <li>
            <a href={l("/compress-photos-for-web", locale)} class="hover:text-accent-ink transition-colors">{nav.compressWeb || "Compress Photos for Web"}</a>
          </li>
          <li>
            <a href={l("/contact-sheet-template", locale)} class="hover:text-accent-ink transition-colors">{nav.tplContactSheet}</a>
          </li>
          <li>
            <a href={l("/collage-templates", locale)} class="hover:text-accent-ink transition-colors">{nav.tplCollage}</a>
          </li>
          <li>
            <a href={l("/mood-board-templates", locale)} class="hover:text-accent-ink transition-colors">{nav.tplMoodBoard}</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Workflow Guides -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">{nav.guides}</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href={l("/lightroom-client-selection-workflow", locale)} class="hover:text-accent-ink transition-colors">{nav.guideLightroom}</a>
          </li>
          <li>
            <a href={l("/white-label-client-gallery", locale)} class="hover:text-accent-ink transition-colors">{nav.guideWhiteLabel}</a>
          </li>
          <li>
            <a href={l("/guides/how-to-make-a-contact-sheet", locale)} class="hover:text-accent-ink transition-colors">{nav.guideContactSheet}</a>
          </li>
          <li>
            <a href={l("/guides/how-to-make-photo-collage", locale)} class="hover:text-accent-ink transition-colors">{nav.guideCollage}</a>
          </li>
          <li>
            <a href={l("/guides/how-to-make-a-mood-board", locale)} class="hover:text-accent-ink transition-colors">{nav.guideMoodBoard}</a>
          </li>
          <li>
            <a href={l("/guides/photo-proof-sheet-with-filenames", locale)} class="hover:text-accent-ink transition-colors">{nav.guideFilenames}</a>
          </li>
          <li>
            <a href={l("/guides/standard-large-photo-frames-and-print-sizes", locale)} class="hover:text-accent-ink transition-colors">{nav.guideFrames}</a>
          </li>
          <li>
            <a href={l("/guides/wedding-photography-proofing-workflow", locale)} class="hover:text-accent-ink transition-colors">{nav.guideWedding}</a>
          </li>
          <li>
            <a href={l("/guides/large-photo-albums-vs-proof-books", locale)} class="hover:text-accent-ink transition-colors">{nav.guideAlbums}</a>
          </li>
          <li>
            <a href={l("/compare/photoshop-contact-sheet-alternative", locale)} class="hover:text-accent-ink transition-colors">{nav.comparePhotoshop}</a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Trust & Legal -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text font-mono">{nav.about}</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href={l("/about-us", locale)} class="hover:text-accent-ink transition-colors">{nav.companyAbout}</a>
          </li>
          <li>
            <a href={l("/contact-us", locale)} class="hover:text-accent-ink transition-colors">{nav.companyContact}</a>
          </li>
          <li>
            <a href={l("/privacy-policy", locale)} class="hover:text-accent-ink transition-colors">{nav.companyPrivacy}</a>
          </li>
          <li>
            <a href={l("/terms-and-conditions", locale)} class="hover:text-accent-ink transition-colors">{nav.companyTerms}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-marketing-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-marketing-muted">
      <div>
        &copy; {new Date().getFullYear()} Make Contact Sheet. All rights reserved. Created for photographers and visual artists.
      </div>
      <div class="flex items-center gap-6">
        <span>Runs locally on your device</span>
        <span>No telemetry on photos</span>
      </div>
    </div>
  </div>
</footer>
