---
import Icon from './Icon.astro';
---

<footer class="w-full bg-marketing-panel border-t border-marketing-border text-marketing-text mt-auto transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 sm:gap-12">
      <!-- Column 1: Brand & Trust -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-zinc-900 flex items-center justify-center border border-zinc-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M3 9h18" />
              <path d="M9 21V9" />
            </svg>
          </div>
          <span class="font-bold tracking-tight text-base text-marketing-text">
            Frame<span class="text-accent-amber">Proof</span>
          </span>
        </a>
        <p class="text-xs text-marketing-muted leading-relaxed">
          Browser-first photo contact sheet, collage, and review workspace. Prepare image batches, organize proof sheets, and export filename lists locally without accounts or uploads.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-xs font-medium">
          <Icon name="shield" size={14} class="text-emerald-500" />
          <span>Zero Server Uploads · 100% Private</span>
        </div>
      </div>

      <!-- Column 2: Tools & Templates -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text">Workspace Tools</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/photo-contact-sheet-maker" class="hover:text-accent-amber transition-colors">Photo Contact Sheet Maker</a>
          </li>
          <li>
            <a href="/photo-collage-maker" class="hover:text-accent-amber transition-colors">Photo Collage Maker</a>
          </li>
          <li>
            <a href="/contact-sheet-template" class="hover:text-accent-amber transition-colors">Contact Sheet Templates</a>
          </li>
          <li>
            <a href="/collage-templates" class="hover:text-accent-amber transition-colors">Collage Templates</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Workflow Guides -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text">Guides & Tutorials</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/guides/how-to-make-a-contact-sheet" class="hover:text-accent-amber transition-colors">How to Make a Contact Sheet</a>
          </li>
          <li>
            <a href="/guides/how-to-make-photo-collage" class="hover:text-accent-amber transition-colors">How to Make a Photo Collage</a>
          </li>
          <li>
            <a href="/guides/photo-proof-sheet-with-filenames" class="hover:text-accent-amber transition-colors">Proof Sheets with Filenames</a>
          </li>
          <li>
            <a href="/compare/photoshop-contact-sheet-alternative" class="hover:text-accent-amber transition-colors">Photoshop Alternative</a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Trust & Legal -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-marketing-text">About & Legal</div>
        <ul class="space-y-2 text-xs text-marketing-muted">
          <li>
            <a href="/about-us" class="hover:text-accent-amber transition-colors">About FrameProof</a>
          </li>
          <li>
            <a href="/contact-us" class="hover:text-accent-amber transition-colors">Contact & Support</a>
          </li>
          <li>
            <a href="/privacy-policy" class="hover:text-accent-amber transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms-and-conditions" class="hover:text-accent-amber transition-colors">Terms of Service</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-marketing-border flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-marketing-muted">
      <div>
        &copy; {new Date().getFullYear()} FrameProof. All rights reserved. Created for photographers and visual artists.
      </div>
      <div class="flex items-center gap-6">
        <span>Runs locally on your device</span>
        <span>No telemetry on photos</span>
      </div>
    </div>
  </div>
</footer>
