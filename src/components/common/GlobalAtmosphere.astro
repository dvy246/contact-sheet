---
/**
 * GlobalAtmosphere — Continuous Ambient Gradient Mesh and Dot Pattern Matrix across the whole website.
 * 
 * Provides a luminous, warm, sunlit champagne / amber aura in Light Mode,
 * a deep warm cocoa / caramel glow in Dark Mode, and an ultra-fine architectural dot matrix pattern.
 * 
 * Performance:
 * - Rendered as fixed, composited background layers (0 DOM layout cost, 0 paint on scroll).
 * - Clipped with GPU contain: strict and pointer-events: none.
 */
import DotPattern from '../ui/DotPattern.astro';
---

<div class="global-atmosphere-wrap fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
  <!-- Orb 1: Upper Right Sunlit Golden Amber Glow -->
  <div class="global-orb orb-1"></div>

  <!-- Orb 2: Center Left Warm Peach & Terracotta Glow -->
  <div class="global-orb orb-2"></div>

  <!-- Orb 3: Lower Right Soft Champagne Corona -->
  <div class="global-orb orb-3"></div>

  <!-- Architectural Dot Pattern Matrix (Zero Repaint Overhead) -->
  <DotPattern
    width={32}
    height={32}
    cx={1.5}
    cy={1.5}
    cr={1.2}
    className="opacity-40 dark:opacity-35 [mask-image:radial-gradient(ellipse_80%_70%_at_50%_35%,black_35%,transparent_92%)]"
  />

  <!-- Subtle Film Grain Texture Overlay for Tangible Material Depth -->
  <div class="global-grain"></div>
</div>

<style>
  .global-atmosphere-wrap {
    contain: strict;
  }

  .global-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(120px);
    transform: translate3d(0, 0, 0);
    will-change: transform;
    opacity: 0.85;
  }

  /* Light Mode Orbs: Sunlit Champagne, Warm Honey & Soft Coral Glow (Delicate & Low Contrast) */
  .orb-1 {
    top: -10%;
    right: -5%;
    width: 65vw;
    height: 65vh;
    max-width: 900px;
    max-height: 750px;
    background: radial-gradient(
      circle,
      rgba(224, 138, 50, 0.10) 0%,
      rgba(240, 160, 80, 0.06) 40%,
      rgba(251, 247, 242, 0) 75%
    );
  }

  .orb-2 {
    top: 35%;
    left: -10%;
    width: 60vw;
    height: 70vh;
    max-width: 850px;
    max-height: 800px;
    background: radial-gradient(
      circle,
      rgba(201, 100, 66, 0.08) 0%,
      rgba(235, 150, 95, 0.05) 45%,
      rgba(251, 247, 242, 0) 75%
    );
  }

  .orb-3 {
    bottom: -15%;
    right: 10%;
    width: 70vw;
    height: 60vh;
    max-width: 950px;
    max-height: 700px;
    background: radial-gradient(
      circle,
      rgba(245, 185, 110, 0.08) 0%,
      rgba(235, 140, 75, 0.04) 50%,
      rgba(251, 247, 242, 0) 80%
    );
  }

  /* Dark Mode Orbs: Deep Truffle Amber, Caramel & Cocoa Light */
  :global(html.dark) .orb-1 {
    opacity: 0.7;
    background: radial-gradient(
      circle,
      rgba(201, 138, 70, 0.16) 0%,
      rgba(156, 90, 28, 0.09) 45%,
      rgba(18, 12, 9, 0) 75%
    );
  }

  :global(html.dark) .orb-2 {
    opacity: 0.65;
    background: radial-gradient(
      circle,
      rgba(156, 90, 28, 0.14) 0%,
      rgba(107, 60, 18, 0.08) 45%,
      rgba(18, 12, 9, 0) 75%
    );
  }

  :global(html.dark) .orb-3 {
    opacity: 0.6;
    background: radial-gradient(
      circle,
      rgba(216, 188, 158, 0.12) 0%,
      rgba(201, 138, 70, 0.06) 50%,
      rgba(18, 12, 9, 0) 80%
    );
  }

  /* Material Grain */
  .global-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 120px 120px;
    opacity: 0.10;
    mix-blend-mode: overlay;
  }

  :global(html.dark) .global-grain {
    opacity: 0.14;
    mix-blend-mode: soft-light;
  }

  @media (prefers-reduced-motion: reduce) {
    .global-orb {
      filter: blur(80px);
    }
  }
</style>
