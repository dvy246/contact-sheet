---
import Icon from '../common/Icon.astro';
import '../../styles/workspace.css';
---

<div id="frameproof-workspace" class="flex flex-col h-[700px] lg:h-[780px] w-full overflow-hidden bg-workspace-bg text-workspace-text relative select-none">
  <!-- Top Review Toolbar Container -->
  <div id="review-toolbar-mount" class="w-full flex-shrink-0 z-20"></div>

  <!-- Main Workspace Area -->
  <div class="flex-1 flex overflow-hidden relative">
    
    <!-- L0 Empty State / Dropzone (Deep Black Studio Aesthetic) -->
    <div id="empty-state-overlay" class="absolute inset-0 z-30 flex flex-col items-center justify-center p-6 bg-[#070709]/98">
      <div 
        id="main-dropzone" 
        class="studio-black-dropzone w-full max-w-xl p-8 sm:p-12 rounded-3xl transition-all flex flex-col items-center text-center group cursor-pointer relative overflow-hidden"
      >
        <!-- Background Ambient Glow -->
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-accent-amber/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-accent-amber/5 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Studio Badge -->
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-[11px] font-mono text-zinc-400 mb-6 group-hover:border-accent-amber/50 transition-colors">
          <span class="w-2 h-2 rounded-full bg-accent-amber"></span>
          <span>STUDIO LIGHT-TABLE · ZERO UPLOADS</span>
        </div>

        <!-- Upload Icon Centerpiece -->
        <div class="w-16 h-16 rounded-2xl bg-zinc-900 border border-zinc-700/80 group-hover:border-accent-amber flex items-center justify-center group-hover:scale-105 transition-all shadow-inner mb-5">
          <Icon name="upload" size={28} class="text-accent-amber" />
        </div>

        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white mb-2">
          Drop photos here to start
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-md mb-6 leading-relaxed">
          Import batches of JPG, PNG, WebP, or AVIF images. All processing is strictly local — files never leave your device.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button class="h-10 px-6 rounded-xl bg-accent-amber hover:bg-accent-amber-hover text-black font-semibold text-xs tracking-tight shadow-lg hover:shadow-xl transition-all flex items-center gap-2">
            <Icon name="plus" size={16} />
            <span>Select Photos</span>
          </button>
          <button id="btn-choose-folder" class="h-10 px-5 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 text-zinc-200 font-medium text-xs border border-zinc-700 hover:border-zinc-500 transition-all flex items-center gap-2">
            <Icon name="folder" size={16} />
            <span>Select Folder</span>
          </button>
        </div>

        <div id="import-progress-status" class="mt-5 text-xs font-mono text-accent-amber h-5"></div>
      </div>
    </div>

    <!-- Left Sidebar: Photos & Layout Controls (Level 1-4) -->
    <aside class="w-72 sm:w-80 flex-shrink-0 flex flex-col bg-workspace-panel border-r border-workspace-border z-10">
      <!-- Sidebar Tab Switcher -->
      <div class="flex items-center border-b border-workspace-border bg-workspace-bg text-xs font-medium">
        <button id="tab-btn-photos" class="flex-1 py-2.5 text-center border-b-2 border-accent-amber text-workspace-text font-bold">
          Photos
        </button>
        <button id="tab-btn-layout" class="flex-1 py-2.5 text-center border-b-2 border-transparent text-workspace-muted hover:text-workspace-text">
          Layout & Presets
        </button>
      </div>

      <!-- Tab 1: Photos List & Dropper -->
      <div id="tab-pane-photos" class="flex-1 flex flex-col overflow-hidden">
        <div class="p-2.5 border-b border-workspace-border flex items-center justify-between">
          <button id="btn-sidebar-add" class="flex-1 py-1.5 px-3 rounded-lg bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text text-xs border border-workspace-border flex items-center justify-center gap-1.5 transition-colors">
            <Icon name="plus" size={14} class="text-accent-amber" />
            <span>Add Photos</span>
          </button>
        </div>
        <div id="thumbnail-grid-mount" class="flex-1 overflow-y-auto custom-scrollbar"></div>
      </div>

      <!-- Tab 2: Layout Controls -->
      <div id="tab-pane-layout" class="flex-1 overflow-y-auto custom-scrollbar hidden">
        <div id="layout-controls-mount"></div>
      </div>
    </aside>

    <!-- Center Viewport: Canvas Light-Table -->
    <div class="flex-1 flex flex-col overflow-hidden relative light-table-canvas-wrap">
      
      <!-- Canvas Zoom & Pagination Floating Bar -->
      <div class="absolute top-3 right-4 z-20 flex items-center gap-2 bg-workspace-panel/90 backdrop-blur-xs border border-workspace-border rounded-lg p-1 text-xs text-workspace-text shadow-lg">
        <!-- Pagination -->
        <div id="pagination-controls" class="hidden items-center gap-1 pr-2 border-r border-workspace-border">
          <button id="btn-prev-page" class="p-1 rounded hover:bg-workspace-surface text-workspace-muted hover:text-workspace-text disabled:opacity-30" title="Previous Page">
            <Icon name="arrow-left" size={14} />
          </button>
          <span id="page-indicator" class="font-mono text-[11px] px-1 text-workspace-muted">Page 1 of 1</span>
          <button id="btn-next-page" class="p-1 rounded hover:bg-workspace-surface text-workspace-muted hover:text-workspace-text disabled:opacity-30" title="Next Page">
            <Icon name="arrow-right" size={14} />
          </button>
        </div>

        <!-- Zoom Controls -->
        <div class="flex items-center gap-1">
          <button id="btn-zoom-out" class="p-1 rounded hover:bg-workspace-surface text-workspace-muted hover:text-workspace-text" title="Zoom Out">
            <Icon name="zoom-out" size={14} />
          </button>
          <span id="zoom-percentage" class="font-mono text-[11px] w-10 text-center text-workspace-muted">100%</span>
          <button id="btn-zoom-in" class="p-1 rounded hover:bg-workspace-surface text-workspace-muted hover:text-workspace-text" title="Zoom In">
            <Icon name="zoom-in" size={14} />
          </button>
          <button id="btn-zoom-reset" class="px-1.5 py-0.5 rounded hover:bg-workspace-surface text-[10px] text-workspace-muted hover:text-workspace-text" title="Reset Zoom">
            Fit
          </button>
        </div>
      </div>

      <!-- Canvas Scroll & Mount Container -->
      <div id="canvas-mount-container" class="flex-1 flex items-center justify-center p-6 sm:p-10 overflow-auto custom-scrollbar">
        <!-- Canvas injected here via CanvasPreview.ts -->
      </div>
    </div>
  </div>

  <!-- Bottom Export Drawer Mount -->
  <div id="export-drawer-mount" class="w-full flex-shrink-0 z-20"></div>
</div>

<script>
  import { $images } from '../../lib/store';
  import { DropZone } from './DropZone';
  import { ThumbnailGrid } from './ThumbnailGrid';
  import { LayoutControls } from './LayoutControls';
  import { CanvasPreview } from './CanvasPreview';
  import { ReviewToolbar } from './ReviewToolbar';
  import { ExportDrawer } from './ExportDrawer';
  import { KeyboardShortcutsManager } from './KeyboardShortcutsModal';

  // Initialize Workspace Components once DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const dropzoneEl = document.getElementById('main-dropzone');
    const thumbMount = document.getElementById('thumbnail-grid-mount');
    const layoutMount = document.getElementById('layout-controls-mount');
    const canvasMount = document.getElementById('canvas-mount-container');
    const reviewMount = document.getElementById('review-toolbar-mount');
    const exportMount = document.getElementById('export-drawer-mount');
    const emptyOverlay = document.getElementById('empty-state-overlay');
    const sidebarAddBtn = document.getElementById('btn-sidebar-add');

    if (dropzoneEl && thumbMount && layoutMount && canvasMount && reviewMount && exportMount) {
      // 1. Instantiate modules
      new DropZone(dropzoneEl);
      if (sidebarAddBtn) {
        new DropZone(sidebarAddBtn);
      }
      new ThumbnailGrid(thumbMount);
      new LayoutControls(layoutMount);
      new CanvasPreview(canvasMount);
      new ReviewToolbar(reviewMount);
      new ExportDrawer(exportMount);
      new KeyboardShortcutsManager();

      // 2. Progressive disclosure visibility handler
      $images.subscribe((images) => {
        if (images.length === 0) {
          emptyOverlay?.classList.remove('hidden');
        } else {
          emptyOverlay?.classList.add('hidden');
        }
      });

      // 3. Tab navigation for Sidebar
      const tabBtnPhotos = document.getElementById('tab-btn-photos');
      const tabBtnLayout = document.getElementById('tab-btn-layout');
      const tabPanePhotos = document.getElementById('tab-pane-photos');
      const tabPaneLayout = document.getElementById('tab-pane-layout');

      tabBtnPhotos?.addEventListener('click', () => {
        tabBtnPhotos.classList.add('border-accent-amber', 'text-workspace-text', 'font-bold');
        tabBtnPhotos.classList.remove('border-transparent', 'text-workspace-muted');
        tabBtnLayout?.classList.remove('border-accent-amber', 'text-workspace-text', 'font-bold');
        tabBtnLayout?.classList.add('border-transparent', 'text-workspace-muted');
        tabPanePhotos?.classList.remove('hidden');
        tabPaneLayout?.classList.add('hidden');
      });

      tabBtnLayout?.addEventListener('click', () => {
        tabBtnLayout.classList.add('border-accent-amber', 'text-workspace-text', 'font-bold');
        tabBtnLayout.classList.remove('border-transparent', 'text-workspace-muted');
        tabBtnPhotos?.classList.remove('border-accent-amber', 'text-workspace-text', 'font-bold');
        tabBtnPhotos?.classList.add('border-transparent', 'text-workspace-muted');
        tabPaneLayout?.classList.remove('hidden');
        tabPanePhotos?.classList.add('hidden');
      });
    }
  });
</script>
