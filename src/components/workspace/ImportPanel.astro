---
/**
 * ImportPanel — the studio dropzone.
 *
 * Extracted so the homepage island and the full-page studio share one panel
 * instead of two copies that drift apart. The element ids below are the ones
 * `DropZone` and `WorkspaceApp`/`StudioApp` look up, so only one instance may
 * exist per page.
 */
import Icon from '../common/Icon.astro';

// Rendered into the HTML of every tool page, so on a localized page it is part
// of the indexed main content and must not stay English. Locale comes from
// Astro's i18n routing, so no page has to pass it down.
const COPY = {
  en: { aria: 'Add photos — drop files here or press Enter to browse', idle: 'Drop your photos here', drag: 'Release to add photos', sub: 'JPG, PNG, WebP, AVIF or a whole folder. Files are decoded on your own device and never uploaded.', photos: 'Select Photos', folder: 'Select Folder', reopen: 'Reopen Project', reopenTitle: 'Reopen saved review session (.makecontactsheet.json)', local: '100% local browser processing' },
  es: { aria: 'Añadir fotos: suelta los archivos aquí o pulsa Intro para buscarlos', idle: 'Suelta tus fotos aquí', drag: 'Suelta para añadir las fotos', sub: 'JPG, PNG, WebP, AVIF o una carpeta completa. Los archivos se procesan en tu propio dispositivo y nunca se suben.', photos: 'Seleccionar fotos', folder: 'Seleccionar carpeta', reopen: 'Reabrir proyecto', reopenTitle: 'Reabrir una sesión de revisión guardada (.makecontactsheet.json)', local: 'Procesamiento 100 % local en el navegador' },
  de: { aria: 'Fotos hinzufügen – Dateien hier ablegen oder Enter drücken, um sie auszuwählen', idle: 'Fotos hier ablegen', drag: 'Loslassen, um Fotos hinzuzufügen', sub: 'JPG, PNG, WebP, AVIF oder ein ganzer Ordner. Die Dateien werden auf deinem eigenen Gerät verarbeitet und nie hochgeladen.', photos: 'Fotos auswählen', folder: 'Ordner auswählen', reopen: 'Projekt öffnen', reopenTitle: 'Gespeicherte Prüfsitzung erneut öffnen (.makecontactsheet.json)', local: '100 % lokale Verarbeitung im Browser' },
  fr: { aria: 'Ajouter des photos : déposez des fichiers ici ou appuyez sur Entrée pour parcourir', idle: 'Déposez vos photos ici', drag: 'Relâchez pour ajouter les photos', sub: 'JPG, PNG, WebP, AVIF ou un dossier entier. Les fichiers sont décodés sur votre appareil et ne sont jamais envoyés en ligne.', photos: 'Choisir des photos', folder: 'Choisir un dossier', reopen: 'Rouvrir un projet', reopenTitle: 'Rouvrir une session de sélection enregistrée (.makecontactsheet.json)', local: 'Traitement 100 % local dans le navigateur' },
  ja: { aria: '写真を追加：ここにファイルをドロップするか、Enter キーで選択', idle: 'ここに写真をドロップ', drag: '離すと写真を追加します', sub: 'JPG・PNG・WebP・AVIF、またはフォルダごと読み込めます。ファイルはお使いのデバイス上で処理され、アップロードされることはありません。', photos: '写真を選択', folder: 'フォルダを選択', reopen: 'プロジェクトを開く', reopenTitle: '保存したレビューセッションを再度開く（.makecontactsheet.json）', local: 'ブラウザ内で100%ローカル処理' },
  pt: { aria: 'Adicionar fotos: solte os arquivos aqui ou pressione Enter para procurar', idle: 'Solte suas fotos aqui', drag: 'Solte para adicionar as fotos', sub: 'JPG, PNG, WebP, AVIF ou uma pasta inteira. Os arquivos são processados no seu próprio dispositivo e nunca são enviados.', photos: 'Selecionar fotos', folder: 'Selecionar pasta', reopen: 'Reabrir projeto', reopenTitle: 'Reabrir uma sessão de revisão salva (.makecontactsheet.json)', local: 'Processamento 100% local no navegador' },
} as const;
const t = COPY[(Astro.currentLocale ?? 'en') as keyof typeof COPY] ?? COPY.en;
---

<div
  id="main-dropzone"
  class="studio-dropzone w-full max-w-2xl px-6 py-10 sm:px-10 sm:py-14 rounded-3xl flex flex-col items-center text-center group cursor-pointer relative overflow-hidden"
  role="button"
  tabindex="0"
  aria-label={t.aria}
>
  <!-- Ambient accent wash. Two corners only, so the centre stays clean. -->
  <div class="dz-ambient absolute -top-24 -left-24 w-56 h-56 bg-accent/[0.07] rounded-full blur-3xl pointer-events-none"></div>
  <div class="dz-ambient absolute -bottom-24 -right-24 w-56 h-56 bg-accent/[0.07] rounded-full blur-3xl pointer-events-none"></div>

  <!-- Icon centrepiece. The glow ring is a sibling element rather than a
       box-shadow so it can animate on the compositor only. -->
  <div class="relative mb-6 shrink-0">
    <div class="dz-glow-ring absolute inset-0 rounded-2xl bg-accent/25 blur-xl opacity-0 pointer-events-none"></div>
    <div class="dz-icon relative w-16 h-16 rounded-2xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent-ink">
      <Icon name="cloud-upload" size={28} />
    </div>
  </div>

  <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-workspace-text mb-2.5">
    <span class="dz-label-idle">{t.idle}</span>
    <span class="dz-label-drag">{t.drag}</span>
  </h2>
  <p class="text-[13px] sm:text-sm text-workspace-muted max-w-sm mb-8 leading-relaxed">
    {t.sub}
  </p>

  <!-- Action Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      class="h-11 px-7 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-sm tracking-tight shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/35 active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
    >
      <Icon name="plus" size={16} />
      <span>{t.photos}</span>
    </button>
    <button
      id="btn-choose-folder"
      type="button"
      class="h-11 px-6 rounded-xl bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text font-medium text-sm border border-workspace-border active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
    >
      <Icon name="folder" size={16} />
      <span>{t.folder}</span>
    </button>
    <button
      id="btn-reopen-project"
      type="button"
      class="h-11 px-5 rounded-xl bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text font-medium text-sm border border-workspace-border active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
      title={t.reopenTitle}
    >
      <Icon name="upload" size={16} />
      <span>{t.reopen}</span>
    </button>
  </div>

  <!-- Import queue. Populated by DropZone from the real decode pipeline —
       every bar below tracks an actual decoded file, not a timer. -->
  <div id="import-file-list" class="hidden w-full max-w-md mt-8 text-left" aria-live="polite"></div>

  <div id="import-progress-status" class="mt-4 text-xs font-mono text-accent-ink min-h-5"></div>

  <div class="mt-6 flex items-center gap-1.5 text-[11px] text-workspace-muted font-mono">
    <Icon name="shield" size={12} class="text-emerald-500" />
    <span>{t.local}</span>
  </div>
</div>
