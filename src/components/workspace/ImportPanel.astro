---
/**
 * ImportPanel — the studio dropzone.
 *
 * Extracted so the homepage island and the full-page studio share one panel
 * instead of two copies that drift apart. The element ids below are the ones
 * `DropZone` and `WorkspaceApp`/`StudioApp` look up, so only one instance may
 * exist per page.
 */
import Icon from '../common/Icon.astro';
---

<div
  id="main-dropzone"
  class="studio-dropzone w-full max-w-2xl px-6 py-10 sm:px-10 sm:py-14 rounded-3xl flex flex-col items-center text-center group cursor-pointer relative overflow-hidden"
  role="button"
  tabindex="0"
  aria-label="Add photos — drop files here or press Enter to browse"
>
  <!-- Ambient accent wash. Two corners only, so the centre stays clean. -->
  <div class="dz-ambient absolute -top-24 -left-24 w-56 h-56 bg-accent/[0.07] rounded-full blur-3xl pointer-events-none"></div>
  <div class="dz-ambient absolute -bottom-24 -right-24 w-56 h-56 bg-accent/[0.07] rounded-full blur-3xl pointer-events-none"></div>

  <!-- Icon centrepiece. The glow ring is a sibling element rather than a
       box-shadow so it can animate on the compositor only. -->
  <div class="relative mb-6 shrink-0">
    <div class="dz-glow-ring absolute inset-0 rounded-2xl bg-accent/25 blur-xl opacity-0 pointer-events-none"></div>
    <div class="dz-icon relative w-16 h-16 rounded-2xl bg-accent/10 border border-accent/25 flex items-center justify-center text-accent-ink">
      <Icon name="cloud-upload" size={28} />
    </div>
  </div>

  <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-workspace-text mb-2.5">
    <span class="dz-label-idle">Drop your photos here</span>
    <span class="dz-label-drag">Release to add photos</span>
  </h2>
  <p class="text-[13px] sm:text-sm text-workspace-muted max-w-sm mb-8 leading-relaxed">
    JPG, PNG, WebP, AVIF or a whole folder. Files are decoded on your own
    device and never uploaded.
  </p>

  <!-- Action Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      class="h-11 px-7 rounded-xl bg-accent hover:bg-accent-hover text-white font-semibold text-sm tracking-tight shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/35 active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
    >
      <Icon name="plus" size={16} />
      <span>Select Photos</span>
    </button>
    <button
      id="btn-choose-folder"
      type="button"
      class="h-11 px-6 rounded-xl bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text font-medium text-sm border border-workspace-border active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
    >
      <Icon name="folder" size={16} />
      <span>Select Folder</span>
    </button>
    <button
      id="btn-reopen-project"
      type="button"
      class="h-11 px-5 rounded-xl bg-workspace-surface hover:bg-workspace-surface-hover text-workspace-text font-medium text-sm border border-workspace-border active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer"
      title="Reopen saved review session (.makecontactsheet.json)"
    >
      <Icon name="upload" size={16} />
      <span>Reopen Project</span>
    </button>
  </div>

  <!-- Import queue. Populated by DropZone from the real decode pipeline —
       every bar below tracks an actual decoded file, not a timer. -->
  <div id="import-file-list" class="hidden w-full max-w-md mt-8 text-left" aria-live="polite"></div>

  <div id="import-progress-status" class="mt-4 text-xs font-mono text-accent-ink min-h-5"></div>

  <div class="mt-6 flex items-center gap-1.5 text-[11px] text-workspace-muted font-mono">
    <Icon name="shield" size={12} class="text-emerald-500" />
    <span>100% local browser processing</span>
  </div>
</div>
