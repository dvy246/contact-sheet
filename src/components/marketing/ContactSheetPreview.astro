---
import type { ContactSheetPreset } from '../../lib/engine/templates';

interface Props {
  preset: ContactSheetPreset;
  class?: string;
}

const { preset, class: className = '' } = Astro.props;

const config = preset.config;
const cols = config.columns || 4;
const rows = config.rows || 5;
const totalCells = cols * rows;

// Choose aspect ratio based on paper size and orientation
let paperAspect = 'aspect-[1/1.35]'; // Default portrait
if (config.orientation === 'landscape') {
  paperAspect = config.pageSize === '16-9' ? 'aspect-video' : 'aspect-[1.35/1]';
} else if (config.pageSize === 'square') {
  paperAspect = 'aspect-square';
} else if (config.pageSize === '16-9') {
  paperAspect = 'aspect-video';
}

const isDarkPreset = preset.category === 'film' || config.pageSize === '16-9';

// Curated thumbnail gradients for visual variety across the grid
const THUMB_GRADIENTS = [
  'from-amber-700/60 via-stone-700/70 to-stone-800',
  'from-blue-700/50 via-stone-700/70 to-stone-800',
  'from-emerald-700/50 via-stone-700/70 to-stone-800',
  'from-orange-700/50 via-stone-700/70 to-stone-800',
  'from-rose-700/50 via-stone-700/70 to-stone-800',
  'from-indigo-700/50 via-stone-700/70 to-stone-800',
  'from-teal-700/50 via-stone-700/70 to-stone-800',
  'from-purple-700/50 via-stone-700/70 to-stone-800',
];
---

<div class={`w-full relative group/sheet flex items-center justify-center p-3 sm:p-4 rounded-xl bg-marketing-surface/90 border border-marketing-border overflow-hidden ${className}`}>
  <!-- Subtle Ambient Glow on Hover -->
  <div class="absolute inset-0 bg-gradient-to-tr from-accent/5 via-transparent to-accent/10 opacity-0 group-hover/sheet:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

  <!-- Physical Paper Sheet Preview Container -->
  <div 
    class={`h-[145px] sm:h-[155px] ${paperAspect} max-w-full relative rounded-md border shadow-md flex flex-col justify-between p-2 sm:p-2.5 transition-transform duration-300 group-hover/sheet:scale-[1.03] overflow-hidden ${
      isDarkPreset 
        ? 'bg-[#151210] border-stone-800 text-stone-300' 
        : 'bg-[#FAF7F2] dark:bg-[#1E1916] border-stone-300/60 dark:border-stone-700/60 text-stone-800 dark:text-stone-200'
    }`}
  >
    <!-- Paper Header Band -->
    <div class="flex items-center justify-between border-b pb-0.5 mb-1 opacity-75 border-current text-[6.5px] font-mono shrink-0 gap-1">
      <div class="flex items-center gap-1 font-bold truncate max-w-[65%]">
        <span class="w-1 h-1 rounded-full bg-accent shrink-0"></span>
        <span class="tracking-tight uppercase truncate">{preset.name.replace(/ Proof Sheet| Proof| Sheet/gi, '')}</span>
      </div>
      <span class="text-[5.5px] opacity-70 shrink-0 font-mono">
        {cols}×{rows} · {config.pageSize?.toUpperCase()}
      </span>
    </div>

    <!-- Thumbnail Grid -->
    <div 
      class="flex-1 grid gap-[2.5px] items-center justify-center w-full h-full min-h-0 overflow-hidden"
      style={`grid-template-columns: repeat(${cols}, minmax(0, 1fr)); grid-template-rows: repeat(${rows}, minmax(0, 1fr));`}
    >
      {Array.from({ length: Math.min(totalCells, 48) }).map((_, idx) => {
        const grad = THUMB_GRADIENTS[idx % THUMB_GRADIENTS.length];
        const isKept = config.showStatusBadges && idx % 3 === 0;

        return (
          <div class="flex flex-col h-full w-full min-h-0 justify-center">
            <!-- Image Cell -->
            <div class={`flex-1 w-full min-h-[6px] rounded-[1.5px] relative bg-gradient-to-br ${grad} border border-black/10 dark:border-white/10 overflow-hidden shadow-2xs flex items-center justify-center`}>
              {/* Keep Badge */}
              {isKept && (
                <span class="absolute top-[1px] right-[1px] w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-xs"></span>
              )}
              {/* Frame Aperture / Index Icon for larger cells */}
              {totalCells <= 16 && (
                <span class="text-[5px] font-mono text-white/60 font-bold">#{idx + 1}</span>
              )}
            </div>

            <!-- Filename Label Strip (if labels enabled) -->
            {config.showLabels !== false && totalCells <= 24 && (
              <div class="w-full text-center mt-[1px] leading-none truncate">
                <span class="text-[5px] font-mono text-current opacity-60 scale-[0.8] inline-block origin-center tracking-tighter">
                  {config.labelType === 'number' ? `#${idx + 1}` : `IMG_${(idx + 1).toString().padStart(3, '0')}`}
                </span>
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- Paper Footer Band -->
    <div class="flex items-center justify-between border-t pt-0.5 mt-1 opacity-50 border-current text-[6px] font-mono shrink-0">
      <span>PAGE 1 OF 1</span>
      <span>300 DPI EXPORT</span>
    </div>
  </div>
</div>
