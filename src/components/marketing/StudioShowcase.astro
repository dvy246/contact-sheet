---
import Icon from '../common/Icon.astro';
---

<section class="py-20 sm:py-28 lg:py-32 bg-marketing-bg border-b border-marketing-border relative overflow-hidden transition-colors selection:bg-accent/20">
  <!-- Subtle Ambient Keynote Glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[550px] bg-accent/8 dark:bg-accent/12 rounded-full blur-[140px] opacity-80"></div>
  </div>

  <div class="relative z-10 max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Apple Keynote Style Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-marketing-surface/80 backdrop-blur-md border border-marketing-border text-[11px] font-mono font-medium tracking-[0.18em] text-accent-ink shadow-xs mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>STUDIO GRADE OUTPUT</span>
      </div>

      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] text-marketing-text leading-[1.08] mb-5 text-balance">
        The Masterpiece Contact Sheet.
      </h2>

      <p class="text-base sm:text-xl text-marketing-muted leading-relaxed max-w-2xl mx-auto text-balance font-normal">
        Engineered for commercial studios, film labs, and cinematography DITs. Uncompromising sub-pixel typographic fidelity, live EXIF extraction, and serverless client proofing.
      </p>

      <!-- Apple Keynote Segmented Pill Bar -->
      <div class="relative inline-flex p-1.5 rounded-2xl bg-marketing-panel/90 backdrop-blur-xl border border-marketing-border shadow-inner mt-8 sm:mt-10 max-w-full overflow-x-auto" id="showcase-nav-wrapper">
        <div class="flex items-center gap-1 relative z-10" id="showcase-tabs" role="tablist">
          <button 
            type="button"
            data-tab="exif" 
            class="showcase-tab-btn px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-2 shrink-0 bg-marketing-surface text-marketing-text shadow-sm border border-marketing-border/80"
            role="tab"
            aria-selected="true"
          >
            <Icon name="camera" size={15} class="text-accent" />
            <span>Technical EXIF &amp; Film Proof</span>
          </button>

          <button 
            type="button"
            data-tab="gallery" 
            class="showcase-tab-btn px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-2 shrink-0 text-marketing-muted hover:text-marketing-text"
            role="tab"
            aria-selected="false"
          >
            <Icon name="grid" size={15} />
            <span>Archival Gallery Fine Art</span>
          </button>

          <button 
            type="button"
            data-tab="proofing" 
            class="showcase-tab-btn px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-2 shrink-0 text-marketing-muted hover:text-marketing-text"
            role="tab"
            aria-selected="false"
          >
            <Icon name="file-check" size={15} />
            <span>Client Proofing Portal</span>
          </button>
        </div>
      </div>
    </div>

    <!-- The Master Artifact Stage (Hero Contact Sheet Preview) -->
    <div class="relative max-w-[1100px] mx-auto rounded-3xl p-3 sm:p-6 lg:p-8 bg-linear-to-b from-marketing-surface via-marketing-panel to-marketing-surface border border-marketing-border shadow-2xl transition-all duration-300">
      
      <!-- Stage Glass Top Bar with Interactive Loupe Zoom -->
      <div class="px-4 py-3 mb-4 rounded-xl bg-marketing-surface/70 backdrop-blur-md border border-marketing-border/80 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          </div>
          <span class="h-4 w-px bg-marketing-border"></span>
          <span class="text-[11px] font-mono text-marketing-muted hidden sm:inline-block">Master Light-Table Preview · 300 DPI Vector Hybrid</span>
        </div>

        <!-- Interactive Loupe Toggle Button -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-loupe-toggle"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-marketing-panel hover:bg-marketing-surface border border-marketing-border text-xs font-mono font-medium text-marketing-text transition-all active:scale-[0.97] cursor-pointer shadow-xs"
            title="Inspect sub-pixel EXIF badges and typography at 2x zoom"
          >
            <Icon name="zoom-in" size={13} class="text-accent" />
            <span id="loupe-label">2x Sub-Pixel Loupe</span>
          </button>
        </div>
      </div>

      <!-- Stage Atmosphere Frame (Hardware Accelerated Viewport) -->
      <div id="showcase-viewport" class="relative rounded-2xl overflow-hidden shadow-2xl border border-black/10 dark:border-white/10 bg-[#09090b] transition-transform duration-500 ease-out origin-center">
        
        <!-- View 1: Technical EXIF & Hasselblad / Medium Format 120 Film Proof -->
        <div id="view-exif" class="showcase-view transition-all duration-300 p-5 sm:p-8 lg:p-10 text-[#f4f4f5] bg-[#0c0c0e]">
          
          <!-- Authentic Film Rebate Header -->
          <div class="border-b border-white/10 pb-5 mb-7 flex flex-col sm:flex-row sm:items-end justify-between gap-4 font-mono">
            <div>
              <div class="flex items-center gap-2 text-[10px] tracking-[0.25em] uppercase text-accent font-bold mb-1">
                <span>HASSELBLAD X2D 100C</span>
                <span class="text-zinc-600">|</span>
                <span>KODAK TRI-X 400 PROOF</span>
                <span class="text-zinc-600">|</span>
                <span>ROLL #04</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white font-sans">Autumn Studio Editorial · Lookbook Master</h3>
            </div>
            <div class="text-[11px] text-zinc-400 text-left sm:text-right space-y-0.5">
              <div>Capture: 16-Bit RAW · 11656 × 8742 px</div>
              <div>Optics: XCD 80mm f/1.9 &amp; XCD 55mm f/2.5</div>
            </div>
          </div>

          <!-- 6-Photo Contact Grid with Live EXIF Pill Badges -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-5 lg:gap-6">
            
            <!-- Cell 1 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 1" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">01</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  KEEP ✓
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_001.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/1.9 · 1/800s · ISO 64
                </div>
              </div>
            </div>

            <!-- Cell 2 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 2" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">02</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  KEEP ✓
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_002.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/2.8 · 1/1000s · ISO 100
                </div>
              </div>
            </div>

            <!-- Cell 3 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 3" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">03</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-amber-500/90 hover:bg-amber-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  FLAG ⚑
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_003.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  55mm · f/2.5 · 1/500s · ISO 200
                </div>
              </div>
            </div>

            <!-- Cell 4 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 4" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">04</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  KEEP ✓
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_004.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/1.9 · 1/640s · ISO 64
                </div>
              </div>
            </div>

            <!-- Cell 5 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 5" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">05</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  KEEP ✓
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_005.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  55mm · f/2.5 · 1/1250s · ISO 100
                </div>
              </div>
            </div>

            <!-- Cell 6 -->
            <div class="group relative rounded-xl bg-[#141417] border border-white/10 p-2.5 space-y-2.5 transition-all duration-200 hover:border-white/25">
              <div class="relative aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=600&q=85" 
                  alt="Editorial Portrait 6" 
                  class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
                  loading="eager"
                  width="600"
                  height="750"
                />
                <span class="absolute top-2 left-2 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[9px] font-mono text-zinc-300 font-bold border border-white/15">06</span>
                <button type="button" class="demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm">
                  KEEP ✓
                </button>
              </div>
              <div class="space-y-1.5 font-mono">
                <div class="text-[11px] font-bold text-zinc-200 truncate">LOOKBOOK_006.RAW</div>
                <div class="inline-flex items-center px-2 py-0.5 rounded-full bg-white/10 text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/2.0 · 1/1000s · ISO 64
                </div>
              </div>
            </div>

          </div>

          <!-- Studio Footer Strip -->
          <div class="border-t border-white/10 pt-5 mt-7 flex flex-col sm:flex-row items-center justify-between text-[10px] font-mono text-zinc-400 gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>100% In-Browser Engine · Zero Upload Confidentiality</span>
            </div>
            <div>Sheet 1 of 1 · 300 DPI Prepress Vector PDF Ready</div>
          </div>
        </div>

        <!-- View 2: Archival Gallery Fine Art (Warm Cotton Museum Rag Paper) -->
        <div id="view-gallery" class="showcase-view hidden transition-all duration-300 p-5 sm:p-8 lg:p-10 text-zinc-900 bg-[#fbfaf7]">
          <div class="border-b border-zinc-200/90 pb-5 mb-7 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
              <div class="text-[11px] uppercase tracking-[0.25em] text-zinc-600 font-serif font-bold mb-1">SOLO EXHIBITION · MONOCHROME &amp; FORM</div>
              <h3 class="text-xl sm:text-3xl font-serif font-bold tracking-tight text-zinc-900">Fine Art Archival Print Sheet</h3>
            </div>
            <div class="text-xs font-mono text-zinc-600">A4 Print Layout · 300 DPI Vector Margins</div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-5 sm:gap-7">
            <div class="p-3.5 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-2.5">
              <div class="aspect-3/4 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=85" alt="Fine Art 1" class="w-full h-full object-cover" width="600" height="800" />
              </div>
              <div class="text-center font-serif text-[11px] text-zinc-700 italic">Plate I · Studio Vignette</div>
            </div>
            <div class="p-3.5 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-2.5">
              <div class="aspect-3/4 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=85" alt="Fine Art 2" class="w-full h-full object-cover" width="600" height="800" />
              </div>
              <div class="text-center font-serif text-[11px] text-zinc-700 italic">Plate II · Shadow Study</div>
            </div>
            <div class="p-3.5 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-2.5">
              <div class="aspect-3/4 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=600&q=85" alt="Fine Art 3" class="w-full h-full object-cover" width="600" height="800" />
              </div>
              <div class="text-center font-serif text-[11px] text-zinc-700 italic">Plate III · High-Key Natural</div>
            </div>
          </div>

          <div class="border-t border-zinc-200/90 pt-5 mt-7 text-center text-xs font-serif text-zinc-600 italic">
            Make Contact Sheet · Archival Museum Rag Profile · Calibrated for Hahnemühle FineArt
          </div>
        </div>

        <!-- View 3: Client Proofing Portal (Serverless Interactive Review) -->
        <div id="view-proofing" class="showcase-view hidden transition-all duration-300 p-5 sm:p-8 lg:p-10 text-white bg-[#141416]">
          <!-- Portal Top Navigation Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-7 border-b border-zinc-800 gap-4">
            <div>
              <div class="text-[10px] uppercase font-mono tracking-widest text-emerald-400 font-bold mb-1">CLIENT REVIEW ENCLAVE · READY</div>
              <h3 class="text-lg sm:text-2xl font-bold tracking-tight text-white">Vogue Commercial Shoot · Selects</h3>
            </div>
            <div class="flex items-center gap-2">
              <span id="demo-selection-counter" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 font-mono text-xs font-semibold border border-emerald-500/30">
                5 of 6 Selected
              </span>
              <a href="/#workspace" class="px-3.5 py-1.5 rounded-lg bg-accent text-white font-sans text-xs font-bold shadow-md hover:bg-accent-hover transition-colors">
                Export Manifest (.json)
              </a>
            </div>
          </div>

          <!-- Interactive Review Cards with Notes -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-5">
            <div class="p-4 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-3">
              <div class="aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=85" alt="Client Proof A" class="w-full h-full object-cover" width="600" height="750" />
                <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-emerald-500 text-[10px] font-bold font-mono">APPROVED</div>
              </div>
              <div class="text-xs font-mono text-zinc-300">VOGUE_FRAME_01.CR3</div>
              <div class="p-2.5 rounded bg-zinc-800/80 text-[11px] text-zinc-400 italic">"Client Note: Retouch flyaway hairs for cover print."</div>
            </div>

            <div class="p-4 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-3">
              <div class="aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=85" alt="Client Proof B" class="w-full h-full object-cover" width="600" height="750" />
                <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-emerald-500 text-[10px] font-bold font-mono">APPROVED</div>
              </div>
              <div class="text-xs font-mono text-zinc-300">VOGUE_FRAME_02.CR3</div>
              <div class="p-2.5 rounded bg-zinc-800/80 text-[11px] text-zinc-400 italic">"Client Note: Perfect expression for two-page spread."</div>
            </div>

            <div class="p-4 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-3">
              <div class="aspect-4/5 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=600&q=85" alt="Client Proof C" class="w-full h-full object-cover" width="600" height="750" />
                <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-amber-500 text-[10px] font-bold font-mono">FLAGGED</div>
              </div>
              <div class="text-xs font-mono text-zinc-300">VOGUE_FRAME_03.CR3</div>
              <div class="p-2.5 rounded bg-zinc-800/80 text-[11px] text-zinc-400 italic">"Client Note: Keep as alternate backup option."</div>
            </div>
          </div>

          <div class="border-t border-zinc-800 pt-4 mt-7 flex items-center justify-between text-xs font-mono text-zinc-400">
            <div>Self-Contained Single-File HTML Exporter</div>
            <div>2-Way Lightroom &amp; Manifest Sync Ready</div>
          </div>
        </div>

      </div>

      <!-- Action Button to Open Studio -->
      <div class="mt-8 text-center flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="/studio/contact-sheet" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-12 px-8 rounded-xl bg-accent hover:bg-accent-hover text-white font-bold text-sm tracking-tight shadow-xl shadow-accent/25 hover:shadow-accent/40 active:scale-[0.98] transition-all cursor-pointer"
        >
          <Icon name="maximize" size={16} />
          <span>Launch Full-Screen Studio</span>
          <Icon name="arrow-right" size={16} />
        </a>

        <a 
          href="/#workspace" 
