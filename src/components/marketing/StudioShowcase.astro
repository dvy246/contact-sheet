<script>
  function setupShowcaseInteractions() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.showcase-tab-btn');
    const views = {
      exif: document.getElementById('view-exif'),
      gallery: document.getElementById('view-gallery'),
      proofing: document.getElementById('view-proofing')
    };

    // Tab switching logic with hardware-accelerated transitions
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (!tab || !views[tab as keyof typeof views]) return;

        tabButtons.forEach((b) => {
          b.classList.remove('active', 'bg-marketing-surface', 'text-marketing-text', 'shadow-sm', 'border-marketing-border/80');
          b.classList.add('text-marketing-muted');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('active', 'bg-marketing-surface', 'text-marketing-text', 'shadow-sm', 'border-marketing-border/80');
        btn.classList.remove('text-marketing-muted');
        btn.setAttribute('aria-selected', 'true');

        Object.values(views).forEach((v) => {
          if (v) v.classList.add('hidden');
        });

        const activeView = views[tab as keyof typeof views];
        if (activeView) {
          activeView.classList.remove('hidden');
        }
      });
    });

    // Interactive Loupe Zoom Logic (Smooth Scale Transform)
    const loupeBtn = document.getElementById('btn-loupe-toggle');
    const loupeLabel = document.getElementById('loupe-label');
    const viewport = document.getElementById('showcase-viewport');
    let isZoomed = false;

    if (loupeBtn && viewport && loupeLabel) {
      loupeBtn.addEventListener('click', () => {
        isZoomed = !isZoomed;
        if (isZoomed) {
          viewport.style.transform = 'scale(1.15)';
          loupeLabel.textContent = '1x Reset View';
          loupeBtn.classList.add('bg-accent', 'text-white', 'border-accent');
          loupeBtn.classList.remove('bg-marketing-panel', 'text-marketing-text');
        } else {
          viewport.style.transform = 'scale(1)';
          loupeLabel.textContent = '2x Sub-Pixel Loupe';
          loupeBtn.classList.remove('bg-accent', 'text-white', 'border-accent');
          loupeBtn.classList.add('bg-marketing-panel', 'text-marketing-text');
        }
      });
    }

    // Interactive Culling Tag Buttons (Tap to toggle Keep / Flag / Reject in demo)
    const demoTagButtons = document.querySelectorAll<HTMLButtonElement>('.demo-tag-btn');
    const demoCounter = document.getElementById('demo-selection-counter');

    demoTagButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const currentText = btn.textContent?.trim() || '';
        if (currentText.includes('KEEP')) {
          btn.textContent = 'FLAG ⚑';
          btn.className = 'demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-amber-500/90 hover:bg-amber-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm';
        } else if (currentText.includes('FLAG')) {
          btn.textContent = 'REJECT ✕';
          btn.className = 'demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-zinc-600/90 hover:bg-zinc-500 text-[9px] font-mono text-zinc-300 font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm';
        } else {
          btn.textContent = 'KEEP ✓';
          btn.className = 'demo-tag-btn absolute top-2 right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 hover:bg-emerald-400 text-[9px] font-mono text-white font-bold tracking-wide transition-transform active:scale-90 cursor-pointer shadow-sm';
        }

        // Update counter
        if (demoCounter) {
          const keepCount = document.querySelectorAll('.demo-tag-btn').length;
          demoCounter.textContent = `${keepCount} of 6 Selected`;
        }
      });
    });
  }

  setupShowcaseInteractions();
  document.addEventListener('astro:page-load', setupShowcaseInteractions);
</script>
