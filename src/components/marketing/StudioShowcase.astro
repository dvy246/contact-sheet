---
import Icon from '../common/Icon.astro';
---

<section class="py-14 sm:py-20 lg:py-24 bg-marketing-bg border-b border-marketing-border relative overflow-hidden transition-colors selection:bg-accent/20">
  <!-- Subtle Ambient Keynote Glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[450px] bg-accent/8 dark:bg-accent/12 rounded-full blur-[140px] opacity-80 scroll-parallax-glow"></div>
  </div>

  <div class="relative z-10 max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Clean, Simple Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-marketing-surface/80 backdrop-blur-md border border-marketing-border text-[11px] font-mono font-medium tracking-[0.15em] text-accent-ink shadow-xs mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span>SEE WHAT YOU CAN CREATE</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-[-0.035em] text-marketing-text leading-[1.1] mb-4 text-balance">
        Create Clean, Professional Contact Sheets in Seconds.
      </h2>

      <p class="text-sm sm:text-base lg:text-lg text-marketing-muted leading-relaxed max-w-2xl mx-auto text-balance font-normal">
        Easily organize, review, and share your photo sets. Display camera settings on every frame, make gallery prints, or let clients pick their favorite shots with ease.
      </p>

      <!-- Segmented View Tabs -->
      <div class="relative inline-flex p-1 rounded-2xl bg-marketing-panel/90 backdrop-blur-xl border border-marketing-border shadow-inner mt-6 max-w-full overflow-x-auto" id="showcase-nav-wrapper">
        <div class="flex items-center gap-1 relative z-10" id="showcase-tabs" role="tablist">
          <button 
            type="button"
            data-tab="exif" 
            class="showcase-tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-1.5 shrink-0 bg-marketing-surface text-marketing-text shadow-sm border border-marketing-border/80"
            role="tab"
            aria-selected="true"
          >
            <Icon name="camera" size={14} class="text-accent" />
            <span>Camera Settings &amp; Film Style</span>
          </button>

          <button 
            type="button"
            data-tab="gallery" 
            class="showcase-tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-1.5 shrink-0 text-marketing-muted hover:text-marketing-text"
            role="tab"
            aria-selected="false"
          >
            <Icon name="grid" size={14} />
            <span>Clean Gallery Print</span>
          </button>

          <button 
            type="button"
            data-tab="proofing" 
            class="showcase-tab-btn px-3.5 sm:px-4 py-2 rounded-xl text-xs font-semibold tracking-tight transition-all duration-200 cursor-pointer flex items-center gap-1.5 shrink-0 text-marketing-muted hover:text-marketing-text"
            role="tab"
            aria-selected="false"
          >
            <Icon name="file-check" size={14} />
            <span>Client Review Gallery</span>
          </button>
        </div>
      </div>
    </div>

    <!-- The Master Artifact Stage (Hero Contact Sheet Preview - Fitted 100% in One Frame) -->
    <div class="relative max-w-[1040px] mx-auto rounded-2xl sm:rounded-3xl p-2.5 sm:p-5 lg:p-6 bg-linear-to-b from-marketing-surface via-marketing-panel to-marketing-surface border border-marketing-border shadow-2xl transition-all duration-300">
      
      <!-- Stage Glass Top Bar with Fullsheet Indicator -->
      <div class="px-3.5 py-2 mb-3 rounded-xl bg-marketing-surface/70 backdrop-blur-md border border-marketing-border/80 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 sm:gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
          </div>
          <span class="h-3.5 w-px bg-marketing-border"></span>
          <span class="text-[10px] sm:text-[11px] font-mono text-marketing-muted">Full Page View · Click Any Photo to Zoom In</span>
        </div>

        <div class="flex items-center gap-2 text-[10px] sm:text-[11px] font-mono text-accent-ink font-semibold">
          <span>High-Resolution Output</span>
        </div>
      </div>

      <!-- Stage Atmosphere Frame (Complete Contact Sheet Fitted in One Viewport) -->
      <div id="showcase-viewport" class="relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl border border-black/15 dark:border-white/10 bg-[#09090b]">
        
        <!-- View 1: Technical EXIF & Film Proof -->
        <div id="view-exif" class="showcase-view p-4 sm:p-6 lg:p-7 text-[#f4f4f5] bg-[#0c0c0e]">
          
          <!-- Authentic Film Rebate Header -->
          <div class="border-b border-white/10 pb-3 mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2 font-mono">
            <div>
              <div class="flex items-center gap-2 text-[9px] sm:text-[10px] tracking-[0.2em] uppercase text-accent font-bold mb-0.5">
                <span>HASSELBLAD X2D</span>
                <span class="text-zinc-600">|</span>
                <span>STUDIO PROOF SHEET</span>
                <span class="text-zinc-600">|</span>
                <span>ROLL #04</span>
              </div>
              <h3 class="text-base sm:text-xl font-bold tracking-tight text-white font-sans">Autumn Studio Photo Shoot</h3>
            </div>
            <div class="text-[9px] sm:text-[10px] text-zinc-400 text-left sm:text-right">
              <div>High Quality RAW Photos</div>
              <div>Lens: 80mm f/1.9 &amp; 55mm f/2.5</div>
            </div>
          </div>

          <!-- 6-Photo Contact Grid (Proportional Compact Scaling for Complete In-Frame Visibility) -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3.5 lg:gap-4">
            
            <!-- Photo 1 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="0">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 1" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">01</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-emerald-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  KEEP ✓
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_001.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/1.9 · 1/800s · ISO 64
                </div>
              </div>
            </div>

            <!-- Photo 2 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="1">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 2" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">02</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-emerald-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  KEEP ✓
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_002.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/2.8 · 1/1000s · ISO 100
                </div>
              </div>
            </div>

            <!-- Photo 3 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="2">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 3" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">03</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-amber-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  FLAG ⚑
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_003.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  55mm · f/2.5 · 1/500s · ISO 200
                </div>
              </div>
            </div>

            <!-- Photo 4 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="3">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 4" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">04</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-emerald-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  KEEP ✓
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_004.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/1.9 · 1/640s · ISO 64
                </div>
              </div>
            </div>

            <!-- Photo 5 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="4">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 5" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">05</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-emerald-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  KEEP ✓
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_005.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  55mm · f/2.5 · 1/1250s · ISO 100
                </div>
              </div>
            </div>

            <!-- Photo 6 -->
            <div class="showcase-photo-card group relative rounded-lg bg-[#141417] border border-white/10 p-2 space-y-1.5 transition-all duration-200 hover:border-accent/60 cursor-pointer shadow-xs" data-photo-idx="5">
              <div class="relative aspect-4/3 rounded bg-zinc-800 overflow-hidden">
                <img 
                  src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=800&q=85" 
                  alt="Portrait Photo 6" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="eager"
                  width="600"
                  height="450"
                />
                <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-md text-[8px] sm:text-[9px] font-mono text-zinc-300 font-bold border border-white/15">06</span>
                <span class="absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded-full bg-emerald-500/90 text-[8px] sm:text-[9px] font-mono text-white font-bold tracking-wide">
                  KEEP ✓
                </span>
              </div>
              <div class="space-y-1 font-mono">
                <div class="text-[10px] font-bold text-zinc-200 truncate">PHOTO_006.JPG</div>
                <div class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-white/10 text-[8px] sm:text-[9px] text-zinc-300 border border-white/10 truncate max-w-full font-medium">
                  80mm · f/2.0 · 1/1000s · ISO 64
                </div>
              </div>
            </div>

          </div>

          <!-- Studio Footer Strip -->
          <div class="border-t border-white/10 pt-3 mt-4 flex flex-col sm:flex-row items-center justify-between text-[9px] sm:text-[10px] font-mono text-zinc-400 gap-2">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>100% Private · Your photos never leave your device</span>
            </div>
            <div>Print Ready · PDF, JPEG &amp; PNG Export Available</div>
          </div>
        </div>

        <!-- View 2: Archival Gallery Fine Art (Warm Cotton Museum Rag Paper) -->
        <div id="view-gallery" class="showcase-view hidden p-4 sm:p-6 lg:p-7 text-zinc-900 bg-[#fbfaf7]">
          <div class="border-b border-zinc-200/90 pb-3 mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <div class="text-[9px] sm:text-[10px] uppercase tracking-[0.25em] text-zinc-600 font-serif font-bold mb-0.5">PHOTO COLLECTION</div>
              <h3 class="text-base sm:text-xl font-serif font-bold tracking-tight text-zinc-900">Fine Art Gallery Print</h3>
            </div>
            <div class="text-[9px] sm:text-[10px] font-mono text-zinc-600">Standard A4 / Letter Page Layout</div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-5">
            <div class="showcase-photo-card p-2 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-1.5 cursor-pointer hover:border-accent" data-photo-idx="1">
              <div class="aspect-4/3 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=85" alt="Fine Art 1" class="w-full h-full object-cover" width="600" height="450" />
              </div>
              <div class="text-center font-serif text-[10px] text-zinc-700 italic">Photo 1 · Portrait Study</div>
            </div>
            <div class="showcase-photo-card p-2 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-1.5 cursor-pointer hover:border-accent" data-photo-idx="0">
              <div class="aspect-4/3 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=85" alt="Fine Art 2" class="w-full h-full object-cover" width="600" height="450" />
              </div>
              <div class="text-center font-serif text-[10px] text-zinc-700 italic">Photo 2 · Studio Light</div>
            </div>
            <div class="showcase-photo-card p-2 bg-white shadow-xs border border-zinc-200/80 rounded-sm space-y-1.5 cursor-pointer hover:border-accent" data-photo-idx="3">
              <div class="aspect-4/3 bg-zinc-100 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=800&q=85" alt="Fine Art 3" class="w-full h-full object-cover" width="600" height="450" />
              </div>
              <div class="text-center font-serif text-[10px] text-zinc-700 italic">Photo 3 · Natural Contrast</div>
            </div>
          </div>

          <div class="border-t border-zinc-200/90 pt-3 mt-4 text-center text-[10px] font-serif text-zinc-600 italic">
            Make Contact Sheet · Clean margins and high quality output
          </div>
        </div>

        <!-- View 3: Client Proofing Portal (Serverless Interactive Review) -->
        <div id="view-proofing" class="showcase-view hidden p-4 sm:p-6 lg:p-7 text-white bg-[#141416]">
          <!-- Portal Top Navigation Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 mb-4 border-b border-zinc-800 gap-2">
            <div>
              <div class="text-[9px] sm:text-[10px] uppercase font-mono tracking-widest text-emerald-400 font-bold mb-0.5">CLIENT REVIEW GALLERY</div>
              <h3 class="text-base sm:text-xl font-bold tracking-tight text-white">Client Photo Selection</h3>
            </div>
            <div class="flex items-center gap-2">
              <span id="demo-selection-counter" class="px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 font-mono text-[10px] sm:text-xs font-semibold border border-emerald-500/30">
                5 of 6 Approved
              </span>
              <a href="/#workspace" class="px-3 py-1 rounded-lg bg-accent text-white font-sans text-xs font-bold shadow-md hover:bg-accent-hover transition-colors">
                Save Review
              </a>
            </div>
          </div>

          <!-- Interactive Review Cards with Notes -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="showcase-photo-card p-3 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-2 cursor-pointer hover:border-accent" data-photo-idx="0">
              <div class="aspect-4/3 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=85" alt="Client Proof A" class="w-full h-full object-cover" width="600" height="450" />
                <div class="absolute top-1.5 right-1.5 px-2 py-0.5 rounded bg-emerald-500 text-[9px] font-bold font-mono">APPROVED</div>
              </div>
              <div class="text-[10px] font-mono text-zinc-300">FRAME_01.JPG</div>
              <div class="p-1.5 rounded bg-zinc-800/80 text-[10px] text-zinc-400 italic">"Client Note: Retouch flyaway hairs for final print."</div>
            </div>

            <div class="showcase-photo-card p-3 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-2 cursor-pointer hover:border-accent" data-photo-idx="1">
              <div class="aspect-4/3 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=800&q=85" alt="Client Proof B" class="w-full h-full object-cover" width="600" height="450" />
                <div class="absolute top-1.5 right-1.5 px-2 py-0.5 rounded bg-emerald-500 text-[9px] font-bold font-mono">APPROVED</div>
              </div>
              <div class="text-[10px] font-mono text-zinc-300">FRAME_02.JPG</div>
              <div class="p-1.5 rounded bg-zinc-800/80 text-[10px] text-zinc-400 italic">"Client Note: Great lighting and smile."</div>
            </div>

            <div class="showcase-photo-card p-3 rounded-xl bg-zinc-900/90 border border-zinc-800 space-y-2 cursor-pointer hover:border-accent" data-photo-idx="2">
              <div class="aspect-4/3 rounded-lg bg-zinc-800 overflow-hidden relative">
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=800&q=85" alt="Client Proof C" class="w-full h-full object-cover" width="600" height="450" />
                <div class="absolute top-1.5 right-1.5 px-2 py-0.5 rounded bg-amber-500 text-[9px] font-bold font-mono">FLAGGED</div>
              </div>
              <div class="text-[10px] font-mono text-zinc-300">FRAME_03.JPG</div>
              <div class="p-1.5 rounded bg-zinc-800/80 text-[10px] text-zinc-400 italic">"Client Note: Keep as backup choice."</div>
            </div>
          </div>

          <div class="border-t border-zinc-800 pt-3 mt-4 flex items-center justify-between text-[10px] font-mono text-zinc-400">
            <div>Shareable Single-File HTML Gallery</div>
            <div>Works offline with zero setup required</div>
          </div>
        </div>

      </div>

      <!-- Action Button to Open Studio -->
      <div class="mt-6 text-center flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="/studio/contact-sheet" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 h-11 px-7 rounded-xl bg-accent hover:bg-accent-hover text-white font-bold text-sm tracking-tight shadow-xl shadow-accent/25 hover:shadow-accent/40 active:scale-[0.98] transition-all cursor-pointer"
        >
          <Icon name="maximize" size={15} />
          <span>Open Full Studio Maker</span>
          <Icon name="arrow-right" size={15} />
        </a>

        <a 
          href="/#workspace" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 h-11 px-5 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-sm border border-marketing-border active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Try with Your Own Photos</span>
        </a>
      </div>
    </div>

    <!-- 3 Simple Feature Cards (Clear, Easy to Understand) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 mt-12 sm:mt-16">
      
      <!-- Card 1: Camera Settings -->
      <div class="p-6 sm:p-7 rounded-3xl bg-marketing-surface border border-marketing-border hover:border-accent/40 transition-all duration-300 flex flex-col justify-between space-y-5 shadow-xs group scroll-reveal">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
            <Icon name="camera" size={20} />
          </div>
          <h3 class="text-base sm:text-lg font-bold text-marketing-text tracking-tight">Show Camera Settings Automatically</h3>
          <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
            Read shutter speed, aperture, ISO, and lens details directly from your photos and print them under each picture.
          </p>
        </div>
        <div class="pt-3.5 border-t border-marketing-border/60 text-xs font-mono text-accent-ink font-semibold flex items-center gap-1.5">
          <span>80mm · f/1.9 · 1/800s · ISO 64</span>
        </div>
      </div>

      <!-- Card 2: Client Proofing -->
      <div class="p-6 sm:p-7 rounded-3xl bg-marketing-surface border border-marketing-border hover:border-accent/40 transition-all duration-300 flex flex-col justify-between space-y-5 shadow-xs group scroll-reveal">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
            <Icon name="file-check" size={20} />
          </div>
          <h3 class="text-base sm:text-lg font-bold text-marketing-text tracking-tight">Easy Client Photo Selection</h3>
          <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
            Download a single interactive web page file. Send it to clients so they can pick favorites, leave notes, and send selections back.
          </p>
        </div>
        <div class="pt-3.5 border-t border-marketing-border/60 text-xs font-mono text-accent-ink font-semibold flex items-center gap-1.5">
          <span>Single-File Interactive Gallery</span>
        </div>
      </div>

      <!-- Card 3: Privacy -->
      <div class="p-6 sm:p-7 rounded-3xl bg-marketing-surface border border-marketing-border hover:border-accent/40 transition-all duration-300 flex flex-col justify-between space-y-5 shadow-xs group scroll-reveal">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform">
            <Icon name="shield" size={20} />
          </div>
          <h3 class="text-base sm:text-lg font-bold text-marketing-text tracking-tight">100% Private on Your Computer</h3>
          <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">
            Your photos never get uploaded to any website or cloud server. Everything stays completely safe and private on your device.
          </p>
        </div>
        <div class="pt-3.5 border-t border-marketing-border/60 text-xs font-mono text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1.5">
          <span>No Sign-Up · Zero Uploads</span>
        </div>
      </div>

    </div>

  </div>

  <!-- Full-Frame Apple Lightbox Modal (Click Any Photo to Inspect Full Resolution in One Single Frame) -->
  <div id="showcase-lightbox-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-2xl hidden items-center justify-center p-4 sm:p-6 lg:p-8 transition-opacity duration-300 opacity-0" role="dialog" aria-modal="true">
    <div class="relative max-w-5xl w-full max-h-[92vh] flex flex-col items-center justify-center">
      
      <!-- Close Button -->
      <button 
        type="button" 
        id="lightbox-close-btn"
        class="absolute -top-12 right-0 sm:right-2 text-white/80 hover:text-white p-2 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md transition-colors cursor-pointer"
        aria-label="Close full photo view"
      >
        <Icon name="x" size={20} />
      </button>

      <!-- Main Full Photo Container (100% In One Frame) -->
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/15 bg-black max-h-[75vh] flex items-center justify-center">
        <img 
          id="lightbox-img" 
          src="" 
          alt="Full Photo View" 
          class="max-h-[72vh] w-auto max-w-full object-contain rounded-xl"
        />
      </div>

      <!-- Live Metadata Chip Bar Below Full Photo -->
      <div class="mt-4 px-5 py-2.5 rounded-xl bg-zinc-900/90 border border-white/15 backdrop-blur-md flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-zinc-300">
        <span id="lightbox-filename" class="font-bold text-white">PHOTO_001.JPG</span>
        <span class="text-zinc-600">•</span>
        <span id="lightbox-exif" class="text-accent-ink">80mm · f/1.9 · 1/800s · ISO 64</span>
        <span class="text-zinc-600">•</span>
        <span class="text-emerald-400">High Quality Photo</span>
      </div>

    </div>
  </div>
</section>

<script>
  const SAMPLE_PHOTOS = [
    {
      src: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_001.JPG",
      exif: "80mm · f/1.9 · 1/800s · ISO 64"
    },
    {
      src: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_002.JPG",
      exif: "80mm · f/2.8 · 1/1000s · ISO 100"
    },
    {
      src: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_003.JPG",
      exif: "55mm · f/2.5 · 1/500s · ISO 200"
    },
    {
      src: "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_004.JPG",
      exif: "80mm · f/1.9 · 1/640s · ISO 64"
    },
    {
      src: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_005.JPG",
      exif: "55mm · f/2.5 · 1/1250s · ISO 100"
    },
    {
      src: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=1600&q=90",
      filename: "PHOTO_006.JPG",
      exif: "80mm · f/2.0 · 1/1000s · ISO 64"
    }
  ];

  function setupShowcaseInteractions() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.showcase-tab-btn');
    const views = {
      exif: document.getElementById('view-exif'),
      gallery: document.getElementById('view-gallery'),
      proofing: document.getElementById('view-proofing')
    };

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (!tab || !views[tab as keyof typeof views]) return;

        tabButtons.forEach((b) => {
          b.classList.remove('active', 'bg-marketing-surface', 'text-marketing-text', 'shadow-sm', 'border-marketing-border/80');
          b.classList.add('text-marketing-muted');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('active', 'bg-marketing-surface', 'text-marketing-text', 'shadow-sm', 'border-marketing-border/80');
        btn.classList.remove('text-marketing-muted');
        btn.setAttribute('aria-selected', 'true');

        Object.values(views).forEach((v) => {
          if (v) v.classList.add('hidden');
        });

        const activeView = views[tab as keyof typeof views];
        if (activeView) {
          activeView.classList.remove('hidden');
        }
      });
    });

    const modal = document.getElementById('showcase-lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalFilename = document.getElementById('lightbox-filename');
    const modalExif = document.getElementById('lightbox-exif');
    const closeBtn = document.getElementById('lightbox-close-btn');

    function openLightbox(idx: number) {
      const data = SAMPLE_PHOTOS[idx] || SAMPLE_PHOTOS[0];
      if (!modal || !modalImg) return;

      modalImg.src = data.src;
      if (modalFilename) modalFilename.textContent = data.filename;
      if (modalExif) modalExif.textContent = data.exif;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      });
    }

    function closeLightbox() {
      if (!modal) return;
      modal.classList.add('opacity-0');
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    }

    document.querySelectorAll<HTMLElement>('.showcase-photo-card').forEach((card) => {
      card.addEventListener('click', () => {
        const idx = Number(card.getAttribute('data-photo-idx') || '0');
        openLightbox(idx);
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeLightbox);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeLightbox();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  setupShowcaseInteractions();
  document.addEventListener('astro:page-load', setupShowcaseInteractions);
</script>
