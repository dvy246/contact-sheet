---
import Icon from '../common/Icon.astro';
import HighlightText from '../ui/HighlightText.astro';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const isEnglish = locale === DEFAULT_LOCALE;

