    step2Point1: 'Etiquetado Conservar / Destacar / Descartar',
    step2Point2: 'Contadores en vivo y vistas filtradas',
    step3Tag: '03 / EXPORTAR',
    step3Title: 'Entrega para Lightroom y PDF',
    step3Desc: 'Exporta PDFs de varias páginas a 300 DPI, hojas de alta resolución y listas CSV/TXT para filtros de búsqueda en Adobe Lightroom.',
    step3Point1: 'PDF listo para imprimir a 300 DPI',
    step3Point2: 'Archivos XMP para Lightroom'
  },
  de: {
    badge: '3-SCHRITTE-WORKFLOW',
    headingPrefix: 'Ein ',
    headingHighlight: 'einfacher, schneller Weg',
    headingSuffix: ', Ihre Fotos zu sortieren',
    lead: 'Von einem Ordner voller Fotos zur fertigen Auswahl in wenigen Minuten. Alles läuft lokal auf Ihrem Rechner ohne Upload-Wartezeiten.',
    step1Tag: '01 / IMPORT',
    step1Title: 'Stapelimport & automatisches Layout',
    step1Desc: 'Laden Sie Hunderte von JPG-, PNG- oder WebP-Dateien hoch. Die Engine erkennt Bildmaße sofort und ordnet sie auf Standardbögen an.',
    step1Point1: 'Exakte Originaldateinamen erhalten',
    step1Point2: 'Ordner- und Mehrfachauswahl-Upload',
    step2Tag: '02 / AUSWAHL',
    step2Title: 'Schnelle Sichtung & Shortcuts',
    step2Desc: 'Bewerten Sie Bildausschnitt und Farben auf dem Leuchttisch. Markieren Sie Favoriten oder Ausschuss mit den Tasten 1, 2 und 3.',
    step2Point1: 'Keep / Flag / Reject Status-Tagging',
    step2Point2: 'Live-Zähler und Filteransichten',
    step3Tag: '03 / EXPORT',
    step3Title: 'Lightroom- & PDF-Übergabe',
    step3Desc: 'Exportieren Sie mehrseitige 300 DPI PDFs, hochauflösende Bögen und CSV/TXT-Dateinamenlisten für Lightroom-Suchfilter.',
    step3Point1: 'Druckfertiges 300 DPI PDF',
    step3Point2: 'Lightroom XMP-Sidecars'
  },
  fr: {
    badge: 'WORKFLOW EN 3 ÉTAPES',
    headingPrefix: 'Une méthode ',
    headingHighlight: 'simple et rapide',
    headingSuffix: ' de trier vos photos',
    lead: 'Passez d\x27un dossier de photos à une sélection finale en quelques minutes. Tout se passe sur votre ordinateur, sans attente de téléversement.',
    step1Tag: '01 / IMPORTER',
    step1Title: 'Import par lot & mise en page auto',
    step1Desc: 'Déposez des centaines de fichiers JPG, PNG ou WebP. Make Contact Sheet analyse instantanément les dimensions et les organise en planches A4, Lettre ou 16:9.',
    step1Point1: 'Noms de fichiers d\x27origine préservés',
    step1Point2: 'Glisser-déposer de dossiers et fichiers multiples',
    step2Tag: '02 / TRI RAPIDE',
    step2Title: 'Revue rapide & raccourcis',
    step2Desc: 'Évaluez le cadrage et la colorimétrie sur une table lumineuse. Marquez favoris ou rejets avec les touches 1, 2 et 3.',
    step2Point1: 'Étiquetage Garder / Marquer / Rejeter',
    step2Point2: 'Compteurs en direct et vues filtrées',
    step3Tag: '03 / EXPORT',
    step3Title: 'Export Lightroom & PDF',
    step3Desc: 'Exportez des PDF multi-pages à 300 DPI, des planches haute résolution et des listes CSV/TXT pour Lightroom.',
    step3Point1: 'PDF 300 DPI prêt pour impression',
    step3Point2: 'Fichiers XMP pour Lightroom'
  },
  ja: {
    badge: '簡単3ステップのワークフロー',
    headingPrefix: '写真を整理する',
