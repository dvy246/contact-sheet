    step3Point1: '300 DPI印刷用PDF',
    step3Point2: 'Lightroom XMPサイドカー'
  },
  pt: {
    badge: 'FLUXO DE TRABALHO EM 3 PASSOS',
    headingPrefix: 'Uma forma ',
    headingHighlight: 'simples e rápida',
    headingSuffix: ' de organizar suas fotos',
    lead: 'Passe de uma pasta de fotos para a seleção final em minutos. Tudo acontece no seu computador, sem esperar por uploads.',
    step1Tag: '01 / IMPORTAR',
    step1Title: 'Importação em lote e layout automático',
    step1Desc: 'Arraste centenas de arquivos JPG, PNG ou WebP. O Make Contact Sheet analisa instantaneamente as dimensões e organiza em folhas A4, Carta ou 16:9.',
    step1Point1: 'Nomes de arquivos originais preservados',
    step1Point2: 'Suporte a pastas e múltiplos arquivos',
    step2Tag: '02 / TRIAGEM',
    step2Title: 'Revisão rápida e atalhos',
    step2Desc: 'Avalie enquadramento e consistência de cores em uma mesa de luz. Marque favoritos ou rejeitados usando as teclas 1, 2 e 3.',
    step2Point1: 'Marcação Manter / Destacar / Rejeitar',
    step2Point2: 'Contadores em tempo real e filtros',
    step3Tag: '03 / EXPORTAR',
    step3Title: 'Entrega para Lightroom e PDF',
    step3Desc: 'Exporte PDFs com várias páginas em 300 DPI, folhas de alta resolução e listas CSV/TXT para o Lightroom.',
