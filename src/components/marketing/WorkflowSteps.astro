---
import Icon from '../common/Icon.astro';
import HighlightText from '../ui/HighlightText.astro';
---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Introduction Header -->
    <div class="max-w-2xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span>THREE-STEP WORKFLOW</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
        A <HighlightText variant="lime">simple, fast way</HighlightText> to sort your photos
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        Go from a folder of photos to a final selection in minutes. Everything happens directly on your computer, so there's no waiting for uploads.
      </p>
    </div>

    <!-- 3-Column Structured Workflow System with Upward Float Parallax -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">

      <!-- Step 01: Ingest (Ascends Slow) -->
      <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all group card-surface card-interactive scroll-float-card scroll-ascend-slow">
        <div>
          <!-- Step Header with Number + Icon -->
          <div class="flex items-center justify-between mb-6">
            <span class="px-2.5 py-1 rounded-md bg-accent/10 border border-accent/20 text-xs font-mono font-bold text-accent-ink">
              01 / INGEST
            </span>
            <div class="flex items-center gap-2">
              <span class="card-emoji text-xl select-none" aria-hidden="true">📥</span>
              <div class="w-9 h-9 rounded-xl bg-marketing-surface border border-marketing-border flex items-center justify-center text-accent-ink group-hover:scale-105 transition-transform shadow-xs">
                <Icon name="upload" size={18} />
              </div>
            </div>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">
            <HighlightText variant="yellow">Batch Import</HighlightText> &amp; Auto-Layout
          </h3>
          <p class="text-sm text-marketing-muted leading-relaxed mb-6">
            Drop hundreds of JPG, PNG, or WebP files. Make Contact Sheet instantly parses image dimensions and arranges them into standard A4, Letter, or 16:9 contact sheets.
          </p>
        </div>

        <!-- Anchored Feature List -->
        <div class="pt-5 border-t border-marketing-border space-y-2.5 text-xs text-marketing-text/90">
          <div class="flex items-center gap-2">
            <Icon name="check" size={14} class="text-emerald-500 shrink-0" />
            <span>Exact original filenames preserved</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" size={14} class="text-emerald-500 shrink-0" />
            <span>Folder and multi-file drag support</span>
          </div>
        </div>
      </div>

      <!-- Step 02: Culling (Ascends Medium) -->
      <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all group card-surface card-interactive scroll-float-card scroll-ascend-medium">
        <div>
          <!-- Step Header with Number + Icon -->
          <div class="flex items-center justify-between mb-6">
            <span class="px-2.5 py-1 rounded-md bg-accent/10 border border-accent/20 text-xs font-mono font-bold text-accent-ink">
              02 / CULLING
            </span>
            <div class="flex items-center gap-2">
              <span class="card-emoji text-xl select-none" aria-hidden="true">⌨️</span>
              <div class="w-9 h-9 rounded-xl bg-marketing-surface border border-marketing-border flex items-center justify-center text-accent-ink group-hover:scale-105 transition-transform shadow-xs">
                <Icon name="eye" size={18} />
              </div>
            </div>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">
            Rapid Review &amp; <HighlightText variant="pink">Shortcuts</HighlightText>
          </h3>
          <p class="text-sm text-marketing-muted leading-relaxed mb-6">
            Evaluate framing and color consistency on an archival light-table. Mark favorites, flags, or rejects using fast <kbd class="px-1.5 py-0.5 rounded bg-marketing-surface border border-marketing-border text-xs font-mono">1</kbd>, <kbd class="px-1.5 py-0.5 rounded bg-marketing-surface border border-marketing-border text-xs font-mono">2</kbd>, and <kbd class="px-1.5 py-0.5 rounded bg-marketing-surface border border-marketing-border text-xs font-mono">3</kbd> keyboard keys.
          </p>
        </div>

        <!-- Anchored Feature List -->
        <div class="pt-5 border-t border-marketing-border space-y-2.5 text-xs text-marketing-text/90">
          <div class="flex items-center gap-2">
            <Icon name="check" size={14} class="text-emerald-500 shrink-0" />
            <span>Keep / Flag / Reject status tagging</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" size={14} class="text-emerald-500 shrink-0" />
            <span>Live status counts and filter views</span>
          </div>
        </div>
      </div>

      <!-- Step 03: Export (Ascends Fast) -->
      <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-7 sm:p-8 flex flex-col justify-between transition-all group card-surface card-interactive scroll-float-card scroll-ascend-fast">
        <div>
          <!-- Step Header with Number + Icon -->
          <div class="flex items-center justify-between mb-6">
            <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono font-bold text-emerald-500">
              03 / EXPORT
            </span>
            <div class="flex items-center gap-2">
              <span class="card-emoji text-xl select-none" aria-hidden="true">🚀</span>
              <div class="w-9 h-9 rounded-xl bg-marketing-surface border border-marketing-border flex items-center justify-center text-emerald-500 group-hover:scale-105 transition-transform shadow-xs">
                <Icon name="download" size={18} />
              </div>
            </div>
          </div>

          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">
            <HighlightText variant="cyan">Lightroom &amp; PDF</HighlightText> Handoff
          </h3>
          <p class="text-sm text-marketing-muted leading-relaxed mb-6">
            Export print-ready multi-page PDFs, high-res visual sheets, and structured CSV/TXT filename lists that plug directly into Adobe Lightroom search filters.
          </p>
        </div>

        <!-- Format Chips Row -->
        <div class="pt-5 border-t border-marketing-border flex flex-wrap gap-1.5">
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-muted">PNG</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-muted">JPEG</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-muted">PDF</span>
          <span class="px-2.5 py-1 rounded-lg bg-accent/10 border border-accent/30 text-[11px] font-mono text-accent-ink font-semibold">Lightroom TXT</span>
        </div>
      </div>

    </div>
  </div>
</section>
