---
import Icon from '../common/Icon.astro';
import { CONTACT_SHEET_PRESETS, COLLAGE_TEMPLATES } from '../../lib/engine/templates';
---

<section class="py-16 sm:py-24 lg:py-28 bg-marketing-panel border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20 sm:space-y-24">
    
    <!-- Contact Sheet Presets Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>PROOFING PRESETS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            Proof Sheet Layouts & Presets
          </h2>
          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Calibrated for standard printing, digital review boards, and client proofing.
          </p>
        </div>
        <a href="/contact-sheet-template" class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>View all contact templates</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {CONTACT_SHEET_PRESETS.slice(0, 3).map((preset) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-7 flex flex-col justify-between space-y-6 transition-all group card-surface card-interactive">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                  {preset.config.pageSize?.toUpperCase()} - {preset.config.orientation?.toUpperCase()}
                </span>
                <span class="text-[11px] px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                  {preset.config.columns}x{preset.config.rows} Grid
                </span>
              </div>
              <h3 class="text-lg font-bold text-marketing-text mb-2.5">{preset.name}</h3>
              <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{preset.description}</p>
            </div>

            <a 
              href="/#workspace" 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              Use Preset
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Collage Templates Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>CREATIVE COMPOSITIONS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            Creative Collage Templates
          </h2>
          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Clean, balanced multi-photo layouts for social stories, before/after edits, and portfolios.
          </p>
        </div>
        <a href="/collage-templates" class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>View all collage templates</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        {COLLAGE_TEMPLATES.slice(0, 4).map((template) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-6 transition-all group card-surface card-interactive">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                  {template.category.toUpperCase()}
                </span>
                <span class="text-[11px] px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                  {template.cells.length} Photos
                </span>
              </div>
              <h3 class="text-base font-bold text-marketing-text mb-2.5">{template.name}</h3>
              <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{template.description}</p>
            </div>

            <a 
              href="/#workspace" 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              Select Template
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
