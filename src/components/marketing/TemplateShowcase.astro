---
import Icon from '../common/Icon.astro';
import ContactSheetPreview from './ContactSheetPreview.astro';
import CollageTemplatePreview from './CollageTemplatePreview.astro';
import HighlightText from '../ui/HighlightText.astro';
import { CONTACT_SHEET_PRESETS, COLLAGE_TEMPLATES } from '../../lib/engine/templates';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/config';
import { l } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const LABELS: Record<Locale, { viewAllContact: string; viewAllCollage: string; usePreset: string; useLayout: string; headingContact: string; headingCollage: string; subContact: string; subCollage: string }> = {
  en: {
    viewAllContact: 'View all contact templates',
    viewAllCollage: 'View all collage layouts',
    usePreset: 'Use Preset',
    useLayout: 'Use Layout',
    headingContact: 'Proof Sheet Layouts & Presets',
    headingCollage: 'Photo Collage Layouts',
    subContact: 'Calibrated for standard printing, digital review boards, and client proofing.',
    subCollage: 'Expressive compositions for client presentations, lookbooks, and hero displays.'
  },
  es: {
    viewAllContact: 'Ver todas las plantillas de hojas',
    viewAllCollage: 'Ver todas las plantillas de collage',
    usePreset: 'Usar plantilla',
    useLayout: 'Usar diseño',
    headingContact: 'Diseños y ajustes de hojas de contactos',
    headingCollage: 'Diseños de collage de fotos',
    subContact: 'Calibrados para impresión estándar, paneles de revisión digital y pruebas de clientes.',
    subCollage: 'Composiciones expresivas para presentaciones a clientes, lookbooks y destacados.'
  },
  de: {
    viewAllContact: 'Alle Kontaktabzug-Vorlagen ansehen',
    viewAllCollage: 'Alle Collagen-Layouts ansehen',
    usePreset: 'Vorlage nutzen',
    useLayout: 'Layout nutzen',
    headingContact: 'Kontaktabzug-Layouts & Vorlagen',
    headingCollage: 'Fotocollagen-Layouts',
    subContact: 'Kalibriert für Standarddrucke, digitale Auswertungen und Kunden-Proofing.',
    subCollage: 'Ausdrucksstarke Kompositionen für Kundenpräsentationen, Lookbooks und Portfolio.'
  },
  fr: {
    viewAllContact: 'Voir tous les modèles de planches',
    viewAllCollage: 'Voir tous les modèles de collages',
    usePreset: 'Utiliser ce préréglage',
    useLayout: 'Utiliser cette mise en page',
    headingContact: 'Modèles de planches contact & préréglages',
    headingCollage: 'Mises en page de collages photo',
    subContact: 'Calibré pour tirages standard, revues numériques et épreuves clients.',
    subCollage: 'Compositions visuelles pour présentations clients, lookbooks et portfolios.'
  },
  ja: {
    viewAllContact: 'すべてのコンタクトシートを見る',
    viewAllCollage: 'すべてのコラージュを見る',
    usePreset: 'このプリセットを使う',
    useLayout: 'このレイアウトを使う',
    headingContact: 'コンタクトシートレイアウト＆プリセット',
    headingCollage: 'フォトコラージュレイアウト',
    subContact: '標準印刷・デジタル確認ボード・クライアント校正用に最適化。',
    subCollage: 'クライアント向け提案、ルックブック、ポートフォリオ用の多彩な構図。'
  },
  pt: {
    viewAllContact: 'Ver todos os modelos de folhas',
    viewAllCollage: 'Ver todos os modelos de colagens',
    usePreset: 'Usar predefinição',
    useLayout: 'Usar layout',
    headingContact: 'Layouts e predefinições de folhas de contato',
    headingCollage: 'Layouts de colagem de fotos',
    subContact: 'Calibrado para impressão padrão, quadros de revisão digital e aprovação de clientes.',
    subCollage: 'Composições expressivas para apresentações a clientes, lookbooks e galerias.'
  }
};

const labels = LABELS[locale] || LABELS[DEFAULT_LOCALE];
---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20 sm:space-y-24">
    
    <!-- Contact Sheet Presets Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>PROOFING PRESETS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            Proof Sheet <HighlightText variant="lime">Layouts</HighlightText> &amp; <HighlightText variant="yellow">Presets</HighlightText>
          </h2>

          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Calibrated for standard printing, digital review boards, and client proofing.
          </p>
        </div>
        <a href={l("/contact-sheet-template", locale)} class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>{labels.viewAllContact}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {[
          CONTACT_SHEET_PRESETS.find(p => p.id === 'a4-portrait-proof')!,
          CONTACT_SHEET_PRESETS.find(p => p.id === 'studio-tech-exif')!,
          CONTACT_SHEET_PRESETS.find(p => p.id === 'wedding-client-proof')!
        ].map((preset) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 transition-all group card-surface card-interactive hover:border-accent/40">
            <div class="space-y-4">
              <!-- Visual Grid Preview -->
              <ContactSheetPreview preset={preset} />

              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                    {preset.config.pageSize?.toUpperCase()} - {preset.config.orientation?.toUpperCase()}
                  </span>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                    {preset.config.columns}x{preset.config.rows} Grid
                  </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-marketing-text group-hover:text-accent transition-colors">{preset.name}</h3>
                <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{preset.description}</p>
              </div>
            </div>

            <a 
              href={l("/#workspace", locale)} 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              Use Preset
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Collage Templates Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>CREATIVE COMPOSITIONS</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            Creative <HighlightText variant="pink">Collage</HighlightText> <HighlightText variant="cyan">Templates</HighlightText>
          </h2>

          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            Clean, balanced multi-photo layouts for social stories, before/after edits, and portfolios.
          </p>
        </div>
        <a href={l("/collage-templates", locale)} class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>View all collage templates</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        {[
          COLLAGE_TEMPLATES.find(t => t.id === 'three-hero-split')!,
          COLLAGE_TEMPLATES.find(t => t.id === 'cinematic-split')!,
          COLLAGE_TEMPLATES.find(t => t.id === 'editorial-mosaic-5')!,
          COLLAGE_TEMPLATES.find(t => t.id === 'hero-golden-quad')!
        ].map((template) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 transition-all group card-surface card-interactive hover:border-accent/40">
            <div class="space-y-4">
              <!-- Visual Grid Preview -->
              <CollageTemplatePreview template={template} />

              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                    {template.category.toUpperCase()}
                  </span>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                    {template.cells.length} Photos
                  </span>
                </div>
                <h3 class="text-base font-bold text-marketing-text group-hover:text-accent transition-colors">{template.name}</h3>
                <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{template.description}</p>
              </div>
            </div>

            <a 
              href={l("/#workspace", locale)} 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              Select Template
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
