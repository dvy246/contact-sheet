---
import Icon from '../common/Icon.astro';
import { CONTACT_SHEET_PRESETS, COLLAGE_TEMPLATES } from '../../lib/engine/templates';
---

<section class="py-16 sm:py-24 bg-marketing-bg border-b border-marketing-border">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 space-y-16">
    
    <!-- Contact Sheet Presets Showcase -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 mb-2">
            Proof Sheet Layouts & Presets
          </h2>
          <p class="text-sm text-marketing-muted">
            Calibrated for standard printing, digital review boards, and client proofing.
          </p>
        </div>
        <a href="/contact-sheet-template" class="text-xs font-semibold text-zinc-900 hover:text-accent-amber flex items-center gap-1">
          <span>View all contact templates</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {CONTACT_SHEET_PRESETS.slice(0, 3).map((preset) => (
          <div class="bg-white border border-marketing-border rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-300 transition-all shadow-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 font-mono">
                  {preset.config.pageSize?.toUpperCase()} · {preset.config.orientation?.toUpperCase()}
                </span>
                <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 font-mono text-zinc-700">
                  {preset.config.columns}×{preset.config.rows} Grid
                </span>
              </div>
              <h3 class="text-base font-bold text-zinc-900">{preset.name}</h3>
              <p class="text-xs text-marketing-muted leading-relaxed">{preset.description}</p>
            </div>

            <a 
              href="/#workspace" 
              class="w-full py-2 px-3 rounded-lg bg-marketing-surface hover:bg-zinc-200 text-zinc-900 font-medium text-xs text-center border border-marketing-border transition-colors block"
            >
              Use Preset
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Collage Templates Showcase -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 mb-2">
            Creative Collage Templates
          </h2>
          <p class="text-sm text-marketing-muted">
            Clean, balanced multi-photo layouts for social stories, before/after edits, and portfolios.
          </p>
        </div>
        <a href="/collage-templates" class="text-xs font-semibold text-zinc-900 hover:text-accent-amber flex items-center gap-1">
          <span>View all collage templates</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {COLLAGE_TEMPLATES.slice(0, 4).map((template) => (
          <div class="bg-white border border-marketing-border rounded-2xl p-6 flex flex-col justify-between space-y-4 hover:border-zinc-300 transition-all shadow-xs">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 font-mono">
                  {template.category.toUpperCase()}
                </span>
                <span class="text-xs px-2 py-0.5 rounded bg-zinc-100 font-mono text-zinc-700">
                  {template.cells.length} Photos
                </span>
              </div>
              <h3 class="text-base font-bold text-zinc-900">{template.name}</h3>
              <p class="text-xs text-marketing-muted leading-relaxed">{template.description}</p>
            </div>

            <a 
              href="/#workspace" 
              class="w-full py-2 px-3 rounded-lg bg-marketing-surface hover:bg-zinc-200 text-zinc-900 font-medium text-xs text-center border border-marketing-border transition-colors block"
            >
              Select Template
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
