const t = isEnglish ? null : (TRANSLATIONS[locale as Exclude<Locale, 'en'>] || TRANSLATIONS.es);
---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20 sm:space-y-24">
    
    <!-- Contact Sheet Presets Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>{isEnglish ? 'PROOFING PRESETS' : t.badgePresets}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            {isEnglish ? (
              <>Proof Sheet <HighlightText variant="lime">Layouts</HighlightText> &amp; <HighlightText variant="yellow">Presets</HighlightText></>
            ) : (
              <>{t.headingPresets1}<HighlightText variant="lime">{t.headingPresetsHighlight1}</HighlightText>{t.headingPresets2}<HighlightText variant="yellow">{t.headingPresetsHighlight2}</HighlightText>{t.headingPresetsSuffix}</>
            )}
          </h2>

          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            {isEnglish ? 'Calibrated for standard printing, digital review boards, and client proofing.' : t.subPresets}
          </p>
        </div>
        <a href={l("/contact-sheet-template", locale)} class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>{isEnglish ? 'View all contact templates' : t.viewAllPresets}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {[
          {
            preset: CONTACT_SHEET_PRESETS.find(p => p.id === 'a4-portrait-proof')!,
            name: isEnglish ? 'A4 Portrait Proof Sheet' : t.preset1Name,
            desc: isEnglish ? 'Standard print review format (4×5 grid, 20 photos per page)' : t.preset1Desc
          },
          {
            preset: CONTACT_SHEET_PRESETS.find(p => p.id === 'studio-tech-exif')!,
            name: isEnglish ? 'Studio Technical EXIF Sheet' : t.preset2Name,
            desc: isEnglish ? '3×3 large frames with live camera, lens, aperture, shutter and ISO metadata badges' : t.preset2Desc
          },
          {
            preset: CONTACT_SHEET_PRESETS.find(p => p.id === 'wedding-client-proof')!,
            name: isEnglish ? 'Client Proof — Titled' : t.preset3Name,
            desc: isEnglish ? '4×3 landscape with a titled band, page numbers and keep/reject marks' : t.preset3Desc
          }
        ].map(({ preset, name, desc }) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 transition-all group card-surface card-interactive hover:border-accent/40">
            <div class="space-y-4">
              <!-- Visual Grid Preview -->
              <ContactSheetPreview preset={preset} />

              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                    {preset.config.pageSize?.toUpperCase()} - {preset.config.orientation?.toUpperCase()}
                  </span>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                    {preset.config.columns}x{preset.config.rows} Grid
                  </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-marketing-text group-hover:text-accent transition-colors">{name}</h3>
                <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{desc}</p>
              </div>
            </div>

            <a 
              href={l("/#workspace", locale)} 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              {isEnglish ? 'Use Preset' : t.usePreset}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Collage Templates Showcase -->
    <div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-10 sm:mb-12 gap-4">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span>{isEnglish ? 'CREATIVE COMPOSITIONS' : t.badgeCollage}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
            {isEnglish ? (
              <>Creative <HighlightText variant="pink">Collage</HighlightText> <HighlightText variant="cyan">Templates</HighlightText></>
            ) : (
              <>{t.headingCollage1}<HighlightText variant="pink">{t.headingCollageHighlight1}</HighlightText>{t.headingCollage2}<HighlightText variant="cyan">{t.headingCollageHighlight2}</HighlightText></>
            )}
          </h2>

          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
            {isEnglish ? 'Clean, balanced multi-photo layouts for social stories, before/after edits, and portfolios.' : t.subCollage}
          </p>
        </div>
        <a href={l("/collage-templates", locale)} class="text-xs font-semibold text-marketing-text hover:text-accent-ink flex items-center gap-1.5 transition-colors shrink-0">
          <span>{isEnglish ? 'View all collage layouts' : t.viewAllCollage}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        {[
          {
            template: COLLAGE_TEMPLATES.find(t => t.id === 'three-hero-split')!,
            name: isEnglish ? 'Three-Hero Split (Triptych)' : t.col1Name,
            desc: isEnglish ? '1 wide master hero flanked by 2 tall vertical panels' : t.col1Desc
          },
          {
            template: COLLAGE_TEMPLATES.find(t => t.id === 'cinematic-split')!,
            name: isEnglish ? 'Cinematic 2-Panel Split' : t.col2Name,
            desc: isEnglish ? 'Balanced side-by-side duo for editorial comparisons' : t.col2Desc
          },
          {
            template: COLLAGE_TEMPLATES.find(t => t.id === 'editorial-mosaic-5')!,
            name: isEnglish ? 'Editorial Center Mosaic (5 Photos)' : t.col3Name,
            desc: isEnglish ? 'Magazine-style centerpiece with 4 surrounding insets' : t.col3Desc
          },
          {
            template: COLLAGE_TEMPLATES.find(t => t.id === 'hero-golden-quad')!,
            name: isEnglish ? 'Master Hero + 3 Stacked (Golden Quad)' : t.col4Name,
            desc: isEnglish ? 'Dominant landscape lead with 3 stacked column photos' : t.col4Desc
          }
        ].map(({ template, name, desc }) => (
          <div class="bg-marketing-surface border border-marketing-border rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-5 transition-all group card-surface card-interactive hover:border-accent/40">
            <div class="space-y-4">
              <!-- Visual Grid Preview -->
              <CollageTemplatePreview template={template} />

              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-accent-ink font-mono">
                    {template.category.toUpperCase()}
                  </span>
                  <span class="text-[11px] px-2.5 py-0.5 rounded-lg bg-marketing-surface border border-marketing-border font-mono text-marketing-muted">
                    {template.cells.length} Photos
                  </span>
                </div>
                <h3 class="text-base font-bold text-marketing-text group-hover:text-accent transition-colors">{name}</h3>
                <p class="text-xs sm:text-sm text-marketing-muted leading-relaxed">{desc}</p>
              </div>
            </div>

            <a 
              href={l("/#workspace", locale)} 
              class="w-full h-10 rounded-xl bg-marketing-surface hover:bg-marketing-surface-hover text-marketing-text font-semibold text-xs text-center border border-marketing-border transition-colors flex items-center justify-center group-hover:border-accent/60 active:scale-[0.98] cursor-pointer"
            >
              {isEnglish ? 'Select Template' : t.useLayout}
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
