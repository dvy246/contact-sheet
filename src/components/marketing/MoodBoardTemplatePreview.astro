---
import type { MoodBoardTemplate } from '../../lib/types';

interface Props {
  template: MoodBoardTemplate;
  class?: string;
}

const { template, class: className = '' } = Astro.props;

const canvasWidth = template.canvas.width || 1920;
const canvasHeight = template.canvas.height || 1080;
const aspectRatio = canvasWidth / canvasHeight;

const aspectRatioStyle = aspectRatio >= 1 
  ? `aspect-ratio: ${Math.min(2.1, Math.max(1, aspectRatio))};` 
  : `aspect-ratio: ${Math.max(0.65, aspectRatio)};`;

// Curated photographic gradients for image elements
const IMAGE_THEMES = [
  'from-amber-900/40 via-stone-800/60 to-stone-900',
  'from-blue-950/40 via-stone-900 to-stone-950',
  'from-emerald-950/30 via-stone-900 to-stone-900',
  'from-orange-950/40 via-stone-900 to-stone-950',
  'from-rose-950/30 via-stone-900 to-stone-950',
  'from-indigo-950/30 via-stone-900 to-stone-950',
];
---

<div class={`w-full relative group/preview flex items-center justify-center p-3 sm:p-4 rounded-xl bg-marketing-surface/90 border border-marketing-border overflow-hidden ${className}`}>
  <!-- Subtle Ambient Glow on Hover -->
  <div class="absolute inset-0 bg-gradient-to-tr from-accent/5 via-transparent to-accent/10 opacity-0 group-hover/preview:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

  <!-- Mood Board Canvas Frame -->
  <div 
    class="h-[140px] sm:h-[150px] max-w-full relative rounded-lg border border-white/10 shadow-md overflow-hidden transition-transform duration-300 group-hover/preview:scale-[1.03]"
    style={`${aspectRatioStyle} background-color: ${template.canvas.backgroundColor || '#161413'};`}
  >
    <!-- Background Canvas Texture Grid / Dots -->
    {template.canvas.backgroundPattern === 'dots' ? (
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:6px_6px] pointer-events-none"></div>
    ) : template.canvas.backgroundPattern === 'grid' ? (
      <div class="absolute inset-0 opacity-15 bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] [background-size:12px_12px] pointer-events-none"></div>
    ) : null}

    <!-- Render Elements Relative to Canvas Dimensions -->
    {template.elements.map((el, idx) => {
      const left = `${(el.x / canvasWidth) * 100}%`;
      const top = `${(el.y / canvasHeight) * 100}%`;
      const width = `${(el.width / canvasWidth) * 100}%`;
      const height = `${(el.height / canvasHeight) * 100}%`;
      const zIndex = el.zIndex || idx + 1;

      if (el.type === 'image') {
        const theme = IMAGE_THEMES[idx % IMAGE_THEMES.length];
        return (
          <div
            class="absolute overflow-hidden p-[1px]"
            style={`left: ${left}; top: ${top}; width: ${width}; height: ${height}; z-index: ${zIndex};`}
          >
            <div class={`w-full h-full rounded-[3px] relative bg-gradient-to-br ${theme} border border-white/15 flex flex-col justify-between p-1 shadow-xs`}>
              <div class="flex items-center justify-between w-full opacity-60">
                <span class="text-[6px] font-mono font-bold text-white/90 bg-black/50 px-0.5 rounded leading-none">
                  #{idx + 1}
                </span>
              </div>
              <div class="flex-1 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3 h-3 text-white/30" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
                  <circle cx="12" cy="13" r="3" />
                </svg>
              </div>
            </div>
          </div>
        );
      }

      if (el.type === 'swatch') {
        return (
          <div
            class="absolute rounded-[3px] border border-white/20 shadow-xs flex items-end p-0.5"
            style={`left: ${left}; top: ${top}; width: ${width}; height: ${height}; background-color: ${el.backgroundColor || '#b45309'}; z-index: ${zIndex};`}
          >
            <span class="text-[5px] font-mono text-white/90 bg-black/60 px-0.5 rounded leading-none truncate max-w-full">
              {el.content || el.backgroundColor}
            </span>
          </div>
        );
      }

      if (el.type === 'note') {
        return (
          <div
            class="absolute rounded-[2px] p-0.5 text-[5px] font-sans border border-black/10 shadow-xs overflow-hidden leading-tight"
            style={`left: ${left}; top: ${top}; width: ${width}; height: ${height}; background-color: ${el.backgroundColor || '#fef08a'}; color: ${el.color || '#713f12'}; z-index: ${zIndex};`}
          >
            <div class="truncate font-semibold">{el.content || 'Note'}</div>
          </div>
        );
      }

      if (el.type === 'text') {
        return (
          <div
            class="absolute truncate font-bold text-[6px] tracking-tight leading-none opacity-85"
            style={`left: ${left}; top: ${top}; width: ${width}; height: ${height}; color: ${el.color || '#f5f0eb'}; z-index: ${zIndex};`}
          >
            {el.content}
          </div>
        );
      }

      return null;
    })}

    <!-- Specular Light Reflection Sweep -->
    <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/10 pointer-events-none"></div>

    <!-- Outer Frame Border Overlay -->
    <div class="absolute inset-0 border border-white/10 rounded-lg pointer-events-none"></div>
  </div>
</div>
