---
import Icon from '../common/Icon.astro';
import GradientBackground from '../common/GradientBackground.astro';
import HighlightText from '../ui/HighlightText.astro';
import DotPattern from '../ui/DotPattern.astro';
---

<section class="relative pt-14 pb-20 sm:pt-20 sm:pb-24 lg:pt-24 lg:pb-28 overflow-hidden bg-transparent border-b border-marketing-border transition-colors">
  <!-- Ambient gradient field with soft, balanced intensity -->
  <GradientBackground class="z-0" intensity="subtle" />

  <!-- Luminous Ambient Keynote Glow in Light & Dark Mode (Soft, Low-Contrast) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] sm:w-[950px] h-[380px] sm:h-[450px] bg-linear-to-tr from-accent/12 via-amber-500/10 to-orange-400/8 dark:from-accent/10 dark:via-amber-500/6 dark:to-transparent rounded-full blur-[130px] opacity-45 dark:opacity-40"></div>
  </div>

  <!-- Architectural Studio Dot Pattern Layer (100% GPU composited, 0 layout overhead) -->
  <DotPattern
    width={24}
    height={24}
    cx={1.2}
    cy={1.2}
    cr={1}
    className="opacity-45 dark:opacity-30 [mask-image:radial-gradient(ellipse_75%_65%_at_50%_35%,black_25%,transparent_85%)]"
  />


  <div class="relative z-10 max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 w-full min-w-0">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center w-full min-w-0">

      <!-- Technical Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-marketing-surface/80 backdrop-blur-sm border border-marketing-border text-[10px] sm:text-[11px] font-mono font-medium tracking-[0.13em] text-marketing-text/90 mb-3.5 sm:mb-4 lg:mb-5 shadow-xs max-w-full shimmer-badge">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping motion-reduce:animate-none absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
        </span>
        <span>100% LOCAL IN-BROWSER ENGINE</span>
      </div>

      <!-- Main Headline with Premium Title Shimmer -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight sm:tracking-[-0.03em] leading-[1.12] sm:leading-[1.07] text-balance mb-5 sm:mb-7 lg:mb-8">
        <span class="title-shimmer">Free</span> <HighlightText variant="lime">Contact Sheet Maker</HighlightText> <span class="title-shimmer">&amp;</span> <HighlightText variant="yellow">Photo Collage</HighlightText>
      </h1>


      <!-- Supporting Subtitle with Shimmering Sweep Effect -->
      <p class="text-[15px] sm:text-lg lg:text-xl text-shimmer font-medium leading-relaxed max-w-2xl mx-auto text-balance mb-7 sm:mb-9 lg:mb-10">
        Arrange photos into <span class="relative inline-block font-bold text-marketing-text px-0.5">print-ready<svg class="absolute -bottom-1 sm:-bottom-1.5 left-0 w-[105%] h-2.5 sm:h-3 text-accent pointer-events-none overflow-visible opacity-85" viewBox="0 0 130 16" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M2.5 10C35 4 92 3 127 7.5C92 12.5 42 14.5 16 13C48 12 96 11.5 124 13.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span> contact sheets and photo collages online. Review client selects with fast keyboard shortcuts, keep camera filenames intact, and export 300 DPI PDFs locally.
      </p>


      <!-- Action Button Group -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-3.5 mb-9 sm:mb-11 w-full sm:w-auto">
        <a
          href="/#workspace"
          class="w-full sm:w-auto h-12 sm:h-[52px] px-7 sm:px-8 rounded-xl bg-accent hover:bg-accent-hover text-white font-bold text-sm sm:text-[15px] tracking-tight shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/35 active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 group cursor-pointer"
        >
          <span>Start Creating</span>
          <Icon name="arrow-right" size={16} class="group-hover:translate-x-0.5 transition-transform" />
        </a>

        <a
          href="/photo-contact-sheet-maker"
          class="w-full sm:w-auto h-12 sm:h-[52px] px-6 sm:px-7 rounded-xl bg-marketing-surface/70 backdrop-blur-sm hover:bg-marketing-surface-hover text-marketing-text font-semibold text-sm sm:text-[15px] border border-marketing-border hover:border-marketing-text/20 active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-xs"
        >
          <span>Explore Templates</span>
        </a>
      </div>

      <!-- Trust Spec Strip -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-marketing-surface/70 backdrop-blur-sm border border-marketing-border text-xs sm:text-[13px] text-marketing-text font-medium shadow-xs">
          <Icon name="shield" size={14} class="text-emerald-500 shrink-0" />
          <span>Zero Server Uploads</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-marketing-surface/70 backdrop-blur-sm border border-marketing-border text-xs sm:text-[13px] text-marketing-text font-medium shadow-xs">
          <Icon name="check" size={14} class="text-emerald-500 shrink-0" />
          <span>Free &amp; No Signup</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-marketing-surface/70 backdrop-blur-sm border border-marketing-border text-xs sm:text-[13px] text-marketing-text font-medium shadow-xs">
          <Icon name="file-check" size={14} class="text-emerald-500 shrink-0" />
          <span>Filenames Preserved</span>
        </div>
      </div>

    </div>
  </div>
</section>
