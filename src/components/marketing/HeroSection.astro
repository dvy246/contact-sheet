---
import Icon from '../common/Icon.astro';
---

<section class="relative pt-16 pb-20 sm:pt-28 sm:pb-32 overflow-hidden border-b border-marketing-border bg-marketing-panel transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      
      <!-- Trust Indicator Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-marketing-surface border border-marketing-border text-marketing-text text-xs font-mono mb-8 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent-amber animate-pulse"></span>
        <span>100% LOCAL BROWSER PROCESSING</span>
      </div>

      <!-- Exact Main Keyword Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-marketing-text leading-[1.08] mb-7">
        Photo Contact Sheet & Collage Maker
      </h1>

      <!-- Elegant, Well-Spaced Subtitle -->
      <p class="text-base sm:text-lg lg:text-xl text-marketing-muted leading-relaxed max-w-2xl mx-auto mb-10 font-normal">
        Arrange image batches into print-ready contact sheets and custom collages. Review picks with fast keyboard shortcuts and export exact filenames — with zero server uploads.
      </p>

      <!-- Primary Action Buttons Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-10 w-full sm:w-auto">
        <a 
          href="/#workspace" 
          class="w-full sm:w-auto h-12 px-8 rounded-xl bg-zinc-900 hover:bg-black text-white dark:bg-accent-amber dark:hover:bg-accent-amber-hover dark:text-black font-semibold text-sm tracking-tight shadow-md hover:shadow-xl transition-all flex items-center justify-center gap-2 group cursor-pointer"
        >
          <span>Start Creating — Free</span>
          <Icon name="arrow-right" size={16} class="group-hover:translate-x-0.5 transition-transform" />
        </a>
        
        <a 
          href="/photo-contact-sheet-maker" 
          class="w-full sm:w-auto h-12 px-6 rounded-xl bg-marketing-surface hover:bg-marketing-border text-marketing-text font-medium text-sm border border-marketing-border transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Explore Templates</span>
        </a>
      </div>

      <!-- Trust Sub-copy -->
      <div class="flex flex-wrap items-center justify-center gap-5 sm:gap-8 text-xs text-marketing-muted">
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name="check" size={14} class="text-emerald-500" />
          No signup required
        </span>
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name="check" size={14} class="text-emerald-500" />
          Zero server uploads
        </span>
        <span class="flex items-center gap-1.5 font-medium">
          <Icon name="check" size={14} class="text-emerald-500" />
          Original filenames preserved
        </span>
      </div>
    </div>
  </div>
</section>
