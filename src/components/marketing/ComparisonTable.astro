---
---

<section class="py-16 sm:py-24 bg-white border-b border-marketing-border">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 mb-3">
        How FrameProof compares to alternatives
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        An honest look at how browser-first review compares with heavy desktop software and generic cloud design apps.
      </p>
    </div>

    <div class="overflow-x-auto custom-scrollbar border border-marketing-border rounded-2xl shadow-xs">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="bg-zinc-100/70 border-b border-marketing-border text-zinc-900 font-bold">
            <th class="p-4 sm:p-5">Capability / Feature</th>
            <th class="p-4 sm:p-5 bg-amber-50/50 text-zinc-900 border-x border-amber-200/60 font-bold">
              FrameProof
            </th>
            <th class="p-4 sm:p-5 text-zinc-600">Photoshop (Contact Sheet II)</th>
            <th class="p-4 sm:p-5 text-zinc-600">Canva</th>
            <th class="p-4 sm:p-5 text-zinc-600">Vizua</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-marketing-border text-zinc-700">
          <tr>
            <td class="p-4 sm:p-5 font-medium">Account / Signup Required</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              No (Instant Access)
            </td>
            <td class="p-4 sm:p-5">Yes (Adobe ID)</td>
            <td class="p-4 sm:p-5">Yes (Mandatory)</td>
            <td class="p-4 sm:p-5 text-emerald-700">No</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Privacy / File Transfer</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              100% In-Browser Local
            </td>
            <td class="p-4 sm:p-5 text-emerald-700">Local Desktop</td>
            <td class="p-4 sm:p-5 text-rose-600">Uploaded to Cloud</td>
            <td class="p-4 sm:p-5 text-emerald-700">Local Browser</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Filename Preservation</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              Always Preserved & Verified
            </td>
            <td class="p-4 sm:p-5">Preserved in Print</td>
            <td class="p-4 sm:p-5 text-rose-600">Stripped / Lost</td>
            <td class="p-4 sm:p-5">Preserved in Grid</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Keep / Reject / Flag Culling</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              Yes (Shortcuts 1, 2, 3)
            </td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Filename CSV / TXT Export</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              Yes (Lightroom Ready)
            </td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Collage Mode + Templates</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              Built-in Siblings
            </td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
            <td class="p-4 sm:p-5 text-emerald-700">Extensive Templates</td>
            <td class="p-4 sm:p-5 text-zinc-400">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Pricing Model</td>
            <td class="p-4 sm:p-5 bg-amber-50/30 border-x border-amber-200/40 font-semibold text-emerald-700">
              Free & Open
            </td>
            <td class="p-4 sm:p-5">~$20–$55/month</td>
            <td class="p-4 sm:p-5">Freemium ($13/mo)</td>
            <td class="p-4 sm:p-5 text-emerald-700">Free (50 imgs max)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
