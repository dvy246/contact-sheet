            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="cyan">{isEnglish ? 'Yes (Lightroom Ready)' : t.f5Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f5Ps}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f5Canva}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f5Vizua}</td>
          </tr>

          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">🎨</span>
              <span>{isEnglish ? 'Collage & Mood Board Modes' : t.f6Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="orange">{isEnglish ? 'Built-in Studio' : t.f6Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f6Ps}</td>
            <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400">{isEnglish ? 'Extensive Templates' : t.f6Canva}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f6Vizua}</td>
          </tr>

          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">💰</span>
              <span>{isEnglish ? 'Pricing Model' : t.f7Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="lime">{isEnglish ? 'Free & Open' : t.f7Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? '~$20-$55/month' : t.f7Ps}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'Freemium ($13/mo)' : t.f7Canva}</td>
            <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400">{isEnglish ? 'Free (50 imgs max)' : t.f7Vizua}</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>
