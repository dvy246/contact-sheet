---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors w-full max-w-full overflow-hidden" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 w-full min-w-0">
    
    <!-- Section Introduction Header -->
    <div class="max-w-2xl mb-12 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span>{isEnglish ? 'BENCHMARK & PRIVACY' : t.badge}</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
        {isEnglish ? (
          <>How Make Contact Sheet <HighlightText variant="lime">compares</HighlightText> to <HighlightText variant="yellow">alternatives</HighlightText></>
        ) : (
          <>{t.title}</>
        )}
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        {isEnglish ? 'An honest look at how browser-first review compares with heavy desktop software and generic cloud design apps.' : t.subtitle}
      </p>
    </div>

    <!-- Responsive Comparison Table Container -->
    <div class="w-full max-w-full overflow-x-auto custom-scrollbar border border-marketing-border rounded-2xl bg-marketing-panel card-surface">
      <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[600px]">
        <thead>
          <tr class="bg-marketing-surface border-b border-marketing-border text-marketing-text font-bold">
            <th class="p-4 sm:p-5">{isEnglish ? 'Capability / Feature' : t.colFeature}</th>
            <th class="p-4 sm:p-5 bg-accent/10 text-marketing-text border-x border-accent/30 font-bold">
              <span class="inline-flex items-center gap-1.5">
                <span>{isEnglish ? 'Make Contact Sheet' : t.colUs}</span>
                <span class="card-emoji text-sm" aria-hidden="true">⚡</span>
              </span>
            </th>
            <th class="p-4 sm:p-5 text-marketing-muted font-semibold">{isEnglish ? 'Photoshop (Contact Sheet II)' : t.colPs}</th>
            <th class="p-4 sm:p-5 text-marketing-muted font-semibold">{isEnglish ? 'Canva' : t.colCanva}</th>
            <th class="p-4 sm:p-5 text-marketing-muted font-semibold">{isEnglish ? 'Vizua' : t.colVizua}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-marketing-border text-marketing-text">
          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">👤</span>
              <span>{isEnglish ? 'Account / Signup Required' : t.f1Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="lime">{isEnglish ? 'No (Instant Access)' : t.f1Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'Yes (Adobe ID)' : t.f1Ps}</td>
            <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400 font-medium">{isEnglish ? 'Yes (Mandatory)' : t.f1Canva}</td>
            <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400">{isEnglish ? 'No' : t.f1Vizua}</td>
          </tr>

          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">🔒</span>
              <span>{isEnglish ? 'Privacy / File Transfer' : t.f2Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="lime">{isEnglish ? '100% In-Browser Local' : t.f2Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400">{isEnglish ? 'Local Desktop' : t.f2Ps}</td>
            <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400 font-medium">{isEnglish ? 'Uploaded to Cloud' : t.f2Canva}</td>
            <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400">{isEnglish ? 'Local Browser' : t.f2Vizua}</td>
          </tr>

          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">🏷️</span>
              <span>{isEnglish ? 'Filename Preservation' : t.f3Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="yellow">{isEnglish ? 'Always Preserved & Verified' : t.f3Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'Preserved in Print' : t.f3Ps}</td>
            <td class="p-4 sm:p-5 text-rose-600 dark:text-rose-400 font-medium">{isEnglish ? 'Stripped / Lost' : t.f3Canva}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'Preserved in Grid' : t.f3Vizua}</td>
          </tr>

          <tr class="group hover:bg-marketing-surface/30 transition-colors">
            <td class="p-4 sm:p-5 font-medium flex items-center gap-2">
              <span class="card-emoji text-base" aria-hidden="true">🎯</span>
              <span>{isEnglish ? 'Keep / Reject / Flag Culling' : t.f4Name}</span>
            </td>
            <td class="p-4 sm:p-5 bg-accent/5 border-x border-accent/20 font-semibold">
              <HighlightText variant="pink">{isEnglish ? 'Yes (Shortcuts 1, 2, 3)' : t.f4Us}</HighlightText>
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f4Ps}</td>
            <td class="p-4 sm:p-5 text-marketing-muted">{isEnglish ? 'None' : t.f4Canva}</td>
