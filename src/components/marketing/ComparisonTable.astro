---
---

<section class="py-16 sm:py-24 bg-marketing-panel border-b border-marketing-border transition-colors">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-marketing-text mb-3">
        How FrameProof compares to alternatives
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        An honest look at how browser-first review compares with heavy desktop software and generic cloud design apps.
      </p>
    </div>

    <div class="overflow-x-auto custom-scrollbar border border-marketing-border rounded-2xl shadow-xs">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="bg-marketing-surface border-b border-marketing-border text-marketing-text font-bold">
            <th class="p-4 sm:p-5">Capability / Feature</th>
            <th class="p-4 sm:p-5 bg-amber-500/10 text-marketing-text border-x border-amber-500/30 font-bold">
              FrameProof
            </th>
            <th class="p-4 sm:p-5 text-marketing-muted">Photoshop (Contact Sheet II)</th>
            <th class="p-4 sm:p-5 text-marketing-muted">Canva</th>
            <th class="p-4 sm:p-5 text-marketing-muted">Vizua</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-marketing-border text-marketing-text">
          <tr>
            <td class="p-4 sm:p-5 font-medium">Account / Signup Required</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              No (Instant Access)
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">Yes (Adobe ID)</td>
            <td class="p-4 sm:p-5 text-rose-500">Yes (Mandatory)</td>
            <td class="p-4 sm:p-5 text-emerald-500">No</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Privacy / File Transfer</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              100% In-Browser Local
            </td>
            <td class="p-4 sm:p-5 text-emerald-500">Local Desktop</td>
            <td class="p-4 sm:p-5 text-rose-500">Uploaded to Cloud</td>
            <td class="p-4 sm:p-5 text-emerald-500">Local Browser</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Filename Preservation</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              Always Preserved & Verified
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">Preserved in Print</td>
            <td class="p-4 sm:p-5 text-rose-500">Stripped / Lost</td>
            <td class="p-4 sm:p-5 text-marketing-muted">Preserved in Grid</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Keep / Reject / Flag Culling</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              Yes (Shortcuts 1, 2, 3)
            </td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Filename CSV / TXT Export</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              Yes (Lightroom Ready)
            </td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Collage Mode + Templates</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              Built-in Siblings
            </td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
            <td class="p-4 sm:p-5 text-emerald-500">Extensive Templates</td>
            <td class="p-4 sm:p-5 text-zinc-500">None</td>
          </tr>

          <tr>
            <td class="p-4 sm:p-5 font-medium">Pricing Model</td>
            <td class="p-4 sm:p-5 bg-amber-500/5 border-x border-amber-500/20 font-semibold text-emerald-500">
              Free & Open
            </td>
            <td class="p-4 sm:p-5 text-marketing-muted">~$20–$55/month</td>
            <td class="p-4 sm:p-5 text-marketing-muted">Freemium ($13/mo)</td>
            <td class="p-4 sm:p-5 text-emerald-500">Free (50 imgs max)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
