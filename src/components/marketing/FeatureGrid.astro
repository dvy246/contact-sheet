---
import Icon from '../common/Icon.astro';
---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Introduction Header -->
    <div class="max-w-2xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span>CORE CAPABILITIES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
        Precision tools engineered for visual professionals
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        Everything you need to review and present photo batches without the bloat of subscription suites or privacy risks of cloud uploaders.
      </p>
    </div>

    <!-- Asymmetric Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">

      <!-- Hero Card: Privacy (Spans 2 cols) -->
      <div class="lg:col-span-2 bg-marketing-panel border border-marketing-border rounded-2xl p-8 sm:p-10 transition-all relative overflow-hidden flex flex-col justify-between card-surface card-interactive scroll-reveal">
        <!-- Subtle Ambient Glow -->
        <div class="absolute top-0 right-0 w-72 h-72 bg-emerald-500/[0.04] dark:bg-emerald-500/[0.07] rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>
        <div class="relative z-10">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center border border-emerald-500/20 mb-6 shadow-xs">
            <Icon name="shield" size={24} />
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-marketing-text leading-snug tracking-tight mb-4">Zero Uploads. True Local Privacy.</h3>
          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed max-w-xl mb-6">
            Unreleased client shoots and confidential commercial photos remain strictly on your machine. All image decoding, resizing, layout calculations, and PDF generation occur directly in your browser's local sandbox.
          </p>
        </div>
        <div class="relative z-10 flex flex-wrap gap-2 pt-4 border-t border-marketing-border text-xs font-mono text-marketing-muted">
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Client Confidentiality</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Local Sandbox Isolation</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Zero Cloud Telemetry</span>
        </div>
      </div>

      <!-- Card 2: Filename Handoff (1 col) -->
      <div class="lg:col-span-1 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all flex flex-col justify-between card-surface card-interactive scroll-reveal">
        <div>
          <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 mb-6 shadow-xs">
            <Icon name="file-check" size={22} />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">Filename Accuracy is Trust</h3>
          <p class="text-sm text-marketing-muted leading-relaxed">
            Generic collage makers strip filenames. Make Contact Sheet preserves original camera filenames on every thumbnail and provides 1-click CSV/TXT exports to match client choices back in Lightroom.
          </p>
        </div>
      </div>

      <!-- Card 3: Two Modes (1 col) -->
      <div class="lg:col-span-1 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all flex flex-col justify-between card-surface card-interactive scroll-reveal">
        <div>
          <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 mb-6 shadow-xs">
            <Icon name="layout" size={22} />
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">Proof Sheets & Collages</h3>
          <p class="text-sm text-marketing-muted leading-relaxed">
            Switch seamlessly between multi-photo proof sheets and creative template-based collages without reloading your batch.
          </p>
        </div>
      </div>

      <!-- Card 4: Print Engine (Spans 2 cols) -->
      <div class="lg:col-span-2 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all card-surface card-interactive">
        <div class="flex flex-col sm:flex-row sm:items-start gap-6">
          <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 shrink-0 shadow-xs">
            <Icon name="file-text" size={22} />
          </div>
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">High-DPI Print-Ready PDF Generation</h3>
            <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
              Export vector-wrapped multi-page PDFs formatted for standard A4 and US Letter paper with custom margins, pagination headers, index numbers, and customizable background tones.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
