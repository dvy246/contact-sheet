---
import Icon from '../common/Icon.astro';
import HighlightText from '../ui/HighlightText.astro';
---

<section class="py-16 sm:py-24 lg:py-28 bg-transparent border-b border-marketing-border transition-colors" data-reveal>
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Introduction Header -->
    <div class="max-w-2xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-marketing-surface border border-marketing-border text-[11px] font-mono text-marketing-text/90 shadow-xs mb-3.5">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span>CORE CAPABILITIES</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-marketing-text leading-tight mb-4">
        Everything you need to <HighlightText variant="lime">manage</HighlightText> &amp; <HighlightText variant="yellow">present</HighlightText> your photos
      </h2>
      <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
        Organize, review, layout, and share your photo collections easily without paying for expensive subscriptions or worrying about cloud privacy.
      </p>
    </div>

    <!-- Asymmetric Bento Grid with Upward Float Motion -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">

      <!-- Hero Card: Privacy (Spans 2 cols, Ascends Slow) -->
      <div class="lg:col-span-2 bg-marketing-panel border border-marketing-border rounded-2xl p-8 sm:p-10 transition-all relative overflow-hidden flex flex-col justify-between card-surface card-interactive scroll-float-card scroll-ascend-slow group">
        <!-- Subtle Ambient Glow -->
        <div class="absolute top-0 right-0 w-72 h-72 bg-emerald-500/[0.04] dark:bg-emerald-500/[0.07] rounded-full blur-[90px] pointer-events-none" aria-hidden="true"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center border border-emerald-500/20 shadow-xs">
              <Icon name="shield" size={24} />
            </div>
            <span class="card-emoji text-2xl select-none" aria-hidden="true">🔒</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-marketing-text leading-snug tracking-tight mb-4">
            Zero Uploads. <HighlightText variant="lime">True Local Privacy</HighlightText>.
          </h3>
          <p class="text-sm sm:text-base text-marketing-muted leading-relaxed max-w-xl mb-6">
            Unreleased client shoots and confidential commercial photos remain strictly on your machine. All image decoding, resizing, layout calculations, and PDF generation occur directly in your browser's local sandbox.
          </p>
        </div>
        <div class="relative z-10 flex flex-wrap gap-2 pt-4 border-t border-marketing-border text-xs font-mono text-marketing-muted">
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Client Confidentiality</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Local Sandbox Isolation</span>
          <span class="px-2.5 py-1 rounded-lg bg-marketing-surface border border-marketing-border">Zero Cloud Telemetry</span>
        </div>
      </div>

      <!-- Card 2: Filename Handoff (1 col, Ascends Medium) -->
      <div class="lg:col-span-1 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all flex flex-col justify-between card-surface card-interactive scroll-float-card scroll-ascend-medium group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 shadow-xs">
              <Icon name="file-check" size={22} />
            </div>
            <span class="card-emoji text-2xl select-none" aria-hidden="true">🏷️</span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-4">
            <HighlightText variant="yellow">Filename Accuracy</HighlightText> is Trust
          </h3>
          <p class="text-sm text-marketing-muted leading-relaxed">
            Generic collage makers strip filenames. Make Contact Sheet preserves original camera filenames on every thumbnail and provides 1-click CSV/TXT exports to match client choices back in Lightroom.
          </p>
        </div>
      </div>

      <!-- Card 3: Freeform Mood Board Studio (1 col, Ascends Fast) -->
      <div class="lg:col-span-1 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all flex flex-col justify-between card-surface card-interactive scroll-float-card scroll-ascend-fast group hover:border-accent/40">
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 shadow-xs group-hover:bg-accent/20 transition-colors">
              <Icon name="image" size={22} />
            </div>
            <span class="card-emoji text-2xl select-none" aria-hidden="true">🎨</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-accent/10 text-accent-ink text-[10px] font-mono font-bold mb-2">NEW</div>
          <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight mb-3">
            Freeform <HighlightText variant="pink">Mood Board</HighlightText> Studio
          </h3>
          <p class="text-sm text-marketing-muted leading-relaxed mb-4">
            Curate visual concept boards, lighting references, and fashion lookbooks with magnetic snapping, color swatches, sticky notes, and 300 DPI exports.
          </p>
        </div>
        <a
          href="/mood-board-maker"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-ink hover:text-accent transition-colors pt-2 border-t border-marketing-border"
        >
          <span>Launch Mood Board Maker</span>
          <Icon name="arrow-right" size={13} />
        </a>
      </div>

      <!-- Card 4: Print Engine (Spans 2 cols, Ascends Medium) -->
      <div class="lg:col-span-2 bg-marketing-panel border border-marketing-border rounded-2xl p-7 sm:p-8 transition-all card-surface card-interactive scroll-float-card scroll-ascend-medium group">
        <div class="flex flex-col sm:flex-row sm:items-start gap-6">
          <div class="w-11 h-11 rounded-xl bg-accent/10 text-accent-ink flex items-center justify-center border border-accent/20 shrink-0 shadow-xs">
            <Icon name="file-text" size={22} />
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg sm:text-xl font-bold text-marketing-text leading-snug tracking-tight">
                High-DPI <HighlightText variant="cyan">Print-Ready PDF</HighlightText> &amp; Image Generation
              </h3>
              <span class="card-emoji text-2xl select-none shrink-0 ml-2" aria-hidden="true">🖨️</span>
            </div>
            <p class="text-sm sm:text-base text-marketing-muted leading-relaxed">
              Export vector-wrapped multi-page PDFs formatted for standard A4 and US Letter paper with custom margins, pagination headers, index numbers, and customizable background tones, plus uncompressed PNGs and JPEGs up to 300 DPI.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
